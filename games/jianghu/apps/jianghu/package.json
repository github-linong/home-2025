{
  "name": "@jianghu/jianghu-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative Node + ws gateway for 江湖 (jianghu) — E1 engineering scaffold (Sprint 1)",
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts sim-core/tests/unit/*.test.ts sim-core/tests/golden/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.6.0"
  }
}
