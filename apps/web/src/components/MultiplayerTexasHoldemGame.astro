---
---

<section class="poker-game" aria-label="德州扑克联机 2至9人">
  <div id="lobby-panel" class="lobby-panel">
    <h2>联机大厅</h2>
    <p class="lobby-hint">创建或加入房间需要登录。对局中也可加入，将于下一手入局。2–9 人桌。进房后地址栏会带上 <code>?room=</code> 房间码，可分享给好友。</p>
    <div id="login-gate" class="login-gate hidden" role="status">
      <p>你当前未登录，无法建房或加入。</p>
      <a id="login-link" class="secondary-button" href="/login/">去登录</a>
    </div>
    <div class="lobby-actions">
      <button id="create-room" class="secondary-button" type="button">创建房间</button>
      <div class="join-row">
        <input id="room-code-input" type="text" placeholder="房间码" maxlength="6" />
        <button id="join-room" class="secondary-button" type="button">加入</button>
      </div>
    </div>
    <div class="lobby-bots" aria-label="机器人席位">
      <button id="add-bot-btn" class="secondary-button" type="button" disabled>增加机器人</button>
      <button id="remove-bot-btn" class="secondary-button" type="button" disabled>移除机器人</button>
      <p class="lobby-bots-hint">需先创建/加入房间，且由房主操作。对局中也可在牌桌工具栏加减。</p>
    </div>
    <p id="lobby-status" class="lobby-status"></p>
    <div id="room-info" class="room-info hidden">
      <p>房间码：<strong id="display-room-code"></strong></p>
      <div class="room-controls">
        <button id="ready-btn" class="secondary-button" type="button">准备</button>
        <button id="start-btn" class="secondary-button" type="button">开始（房主）</button>
        <button id="end-match-btn" class="secondary-button" type="button">结束对局</button>
        <button id="leave-btn" class="secondary-button" type="button">离开</button>
      </div>
    </div>
  </div>

  <div id="game-panel" class="hidden">
    <div class="game-toolbar">
      <div>
        <span class="eyebrow">2–9 人 · MULTIPLAYER</span>
        <h2>午夜绿毡</h2>
        <p class="table-room-code">房间 <strong id="game-room-code">—</strong></p>
      </div>
      <div class="toolbar-actions">
        <button id="game-ready-btn" class="secondary-button compact" type="button">准备</button>
        <button id="game-start-btn" class="secondary-button compact" type="button">开始</button>
        <button id="game-add-bot" class="secondary-button compact" type="button">+机器人</button>
        <button id="game-remove-bot" class="secondary-button compact" type="button">−机器人</button>
        <button id="game-end-btn" class="secondary-button compact" type="button">结束</button>
        <button id="game-leave-btn" class="secondary-button compact" type="button">离开</button>
        <span id="connection-status" class="connection-status">未连接</span>
      </div>
    </div>

    <div class="poker-table">
      <div id="table-seats" class="table-seats"></div>
      <div class="table-center">
        <div class="pot"><span>底池</span><strong id="pot">0</strong></div>
        <div id="community-cards" class="card-row community" aria-label="公共牌"></div>
        <p id="game-message" class="game-message" aria-live="polite">等待连接…</p>
      </div>
    </div>

    <div class="action-panel">
      <div class="round-info">
        <span id="street-name">—</span>
        <span id="call-info">—</span>
      </div>
      <div class="bet-controls">
        <label for="bet-amount">加注到</label>
        <input id="bet-amount" type="number" inputmode="numeric" min="20" step="1" value="20" />
      </div>
      <div class="actions">
        <button id="fold-action" class="action fold-action" type="button">弃牌</button>
        <button id="call-action" class="action call-action" type="button">跟注</button>
        <button id="raise-action" class="action raise-action" type="button">加注</button>
        <button id="all-in-action" class="action all-in-action" type="button">All-in</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { PokerSocket } from "../lib/pokerSocket";
  import { createClientActionId, SEAT_LAYOUTS } from "../lib/pokerProtocol";
  import type { Card, PublicSnapshot, PrivateSnapshot, RoomSnapshot } from "../lib/pokerProtocol";

  type Suit = "s" | "h" | "d" | "c";
  type Rank = "2" | "3" | "4" | "5" | "6" | "7" | "8" | "9" | "T" | "J" | "Q" | "K" | "A";

  /** Module-scoped: survives duplicate script init; one in-flight /api/me at a time. */
  type AuthCache = { checkedAt: number; ok: boolean; userId: string | null; label: string };
  const AUTH_TTL_MS = 5 * 60 * 1000;
  let authCache: AuthCache | null = null;
  let authInFlight: Promise<AuthCache> | null = null;

  async function fetchMeCached(force = false): Promise<AuthCache> {
    if (!force && authCache && Date.now() - authCache.checkedAt < AUTH_TTL_MS) {
      return authCache;
    }
    if (!force && authInFlight) return authInFlight;
    authInFlight = (async () => {
      try {
        const meRes = await fetch("/api/me", { credentials: "include" });
        const meData = await meRes.json();
        if (meData.authenticated && meData.user?.id) {
          authCache = {
            checkedAt: Date.now(),
            ok: true,
            userId: meData.user.id,
            label: meData.user.name || meData.user.email || meData.user.id,
          };
        } else {
          authCache = { checkedAt: Date.now(), ok: false, userId: null, label: "" };
        }
      } catch {
        authCache = { checkedAt: Date.now(), ok: false, userId: null, label: "" };
      }
      return authCache!;
    })();
    try {
      return await authInFlight;
    } finally {
      authInFlight = null;
    }
  }

  const suitSymbols: Record<Suit, string> = { s: "♠", h: "♥", d: "♦", c: "♣" };
  const rankLabels: Partial<Record<Rank, string>> = { T: "10", J: "J", Q: "Q", K: "K", A: "A" };
  const streetLabels: Record<string, string> = {
    preflop: "翻牌前",
    flop: "翻牌",
    turn: "转牌",
    river: "河牌",
  };

  function $(sel: string) {
    const el = document.querySelector(sel);
    if (!el) throw new Error(`Missing ${sel}`);
    return el;
  }

  const root = document.querySelector(".poker-game") as HTMLElement | null;
  function bootPoker() {
    const el = document.querySelector(".poker-game") as HTMLElement | null;
    if (!el || el.dataset.bound === "1") return;
    el.dataset.bound = "1";
    initPokerGame();
  }
  bootPoker();
  document.addEventListener("astro:page-load", bootPoker);

  function initPokerGame() {
  const lobbyPanel = $<HTMLElement>("#lobby-panel");
  const gamePanel = $<HTMLElement>("#game-panel");
  const lobbyStatus = $<HTMLElement>("#lobby-status");
  const roomInfo = $<HTMLElement>("#room-info");
  const displayRoomCode = $<HTMLElement>("#display-room-code");
  const loginGate = $<HTMLElement>("#login-gate");
  const createBtn = $<HTMLButtonElement>("#create-room");
  const joinBtn = $<HTMLButtonElement>("#join-room");
  const roomCodeInput = $<HTMLInputElement>("#room-code-input");
  const addBotBtn = $<HTMLButtonElement>("#add-bot-btn");
  const removeBotBtn = $<HTMLButtonElement>("#remove-bot-btn");
  const gameAddBot = $<HTMLButtonElement>("#game-add-bot");
  const gameRemoveBot = $<HTMLButtonElement>("#game-remove-bot");
  const gameReadyBtn = $<HTMLButtonElement>("#game-ready-btn");
  const gameStartBtn = $<HTMLButtonElement>("#game-start-btn");
  const gameEndBtn = $<HTMLButtonElement>("#game-end-btn");
  const gameLeaveBtn = $<HTMLButtonElement>("#game-leave-btn");
  const gameRoomCode = $<HTMLElement>("#game-room-code");

  let socket: PokerSocket | null = null;
  let myUserId: string | null = null;
  let mySeatIndex = -1;
  let room: RoomSnapshot | null = null;
  let publicState: PublicSnapshot | null = null;
  let privateState: PrivateSnapshot | null = null;
  let handId: string | null = null;
  let turnId = 0;
  let isReady = false;
  let isAuthenticated = false;
  const ROOM_QUERY = "room";
  let urlRoomSynced: string | null = null;
  let autoJoinAttempted = false;

  function effectiveOwnerId() {
    if (!room) return null;
    return room.actingOwnerId ?? room.ownerId;
  }

  function iAmEffectiveOwner() {
    return Boolean(myUserId && effectiveOwnerId() === myUserId);
  }

  function setLobbyLocked(locked: boolean, message = "") {
    createBtn.disabled = locked;
    joinBtn.disabled = locked;
    roomCodeInput.disabled = locked;
    loginGate.classList.toggle("hidden", !locked);
    if (message) lobbyStatus.textContent = message;
  }

  function readRoomFromUrl(): string | null {
    const raw = new URL(location.href).searchParams.get(ROOM_QUERY);
    if (!raw) return null;
    const code = raw.trim().toUpperCase();
    return /^[A-Z0-9]{4,8}$/.test(code) ? code : null;
  }

  /** Keep address bar in sync so rooms are shareable / refreshable. */
  function syncRoomUrl(code: string | null, mode: "push" | "replace" = "replace") {
    const next = code ? code.trim().toUpperCase() : null;
    const url = new URL(location.href);
    const current = url.searchParams.get(ROOM_QUERY)?.trim().toUpperCase() ?? null;
    if (current === next) {
      urlRoomSynced = next;
      return;
    }
    if (next) url.searchParams.set(ROOM_QUERY, next);
    else url.searchParams.delete(ROOM_QUERY);
    // Drop unrelated query noise when writing room links.
    const href = next
      ? `${url.pathname}?${ROOM_QUERY}=${encodeURIComponent(next)}${url.hash}`
      : `${url.pathname}${url.hash}`;
    if (mode === "push") history.pushState({ pokerRoom: next }, "", href);
    else history.replaceState({ pokerRoom: next }, "", href);
    urlRoomSynced = next;
  }

  function clearLocalRoomUi() {
    gamePanel.classList.add("hidden");
    lobbyPanel.classList.remove("hidden");
    roomInfo.classList.add("hidden");
    room = null;
    publicState = null;
    privateState = null;
    handId = null;
    mySeatIndex = -1;
  }

  async function refreshAuth(opts: { quiet?: boolean; force?: boolean } = {}): Promise<boolean> {
    const cached = await fetchMeCached(Boolean(opts.force));
    if (cached.ok && cached.userId) {
      isAuthenticated = true;
      myUserId = cached.userId;
      setLobbyLocked(false);
      if (!opts.quiet) lobbyStatus.textContent = `已登录：${cached.label}`;
      return true;
    }
    isAuthenticated = false;
    myUserId = null;
    const nextPath = `${location.pathname}${location.search}` || "/texas-holdem/";
    const loginHref = `/login/?next=${encodeURIComponent(nextPath)}`;
    ($("#login-link") as HTMLAnchorElement).href = loginHref;
    setLobbyLocked(true, "请先登录后再创建或加入房间");
    return false;
  }

  function enterRoomView() {
    showGame();
    updateLobby();
    render();
  }

  function cardMarkup(card: Card | null, hidden = false, placeholder = false) {
    if (placeholder) return '<span class="playing-card placeholder" aria-hidden="true"></span>';
    if (hidden) return '<span class="playing-card card-back" aria-label="隐藏的牌">◆</span>';
    if (!card) return cardMarkup(null, false, true);
    const red = card.suit === "h" || card.suit === "d";
    const rank = rankLabels[card.rank as Rank] ?? card.rank;
    return `<span class="playing-card ${red ? "red-card" : ""}">
      <span>${rank}</span><span>${suitSymbols[card.suit as Suit]}</span>
    </span>`;
  }

  function render() {
    if (!publicState && !room) return;

    const seatsEl = $<HTMLElement>("#table-seats");
    const seatSource = publicState?.seatsPublic ?? [];
    const roomSeats = room?.seats ?? [];
    let seated = roomSeats.filter((s) => s.userId && s.status !== "empty");
    if (!seated.length && seatSource.length) {
      seated = seatSource.map((s) => ({
        seatIndex: s.seatIndex,
        userId: s.userId,
        displayName: s.displayName,
        status: s.folded ? "folded" : "occupied",
        ready: true,
        stack: s.stack,
        isBot: false,
        leaveAfterHand: false,
      }));
    }
    const nLayout = Math.max(2, Math.min(9, seated.length || 2));
    const layout = SEAT_LAYOUTS[nLayout] ?? SEAT_LAYOUTS[9];
    const compact = nLayout >= 7;

    seatsEl.classList.toggle("seats-compact", compact);
    seatsEl.innerHTML = seated
      .map((roomSeat, layoutIndex) => {
        const index = roomSeat.seatIndex;
        const pos = layout[layoutIndex] ?? layout[layout.length - 1];
        const seat = seatSource.find((s) => s.seatIndex === index);
        const isDealer = publicState?.dealerIndex === index;
        const isTurn = publicState?.actorSeatId === index && !publicState?.finished;
        const isMe = index === mySeatIndex;
        const inHand = Boolean(seat);
        const waitingNext = Boolean(roomSeat.userId) && !inHand && room?.roomState === "inMatch";
        const hole =
          isMe && privateState?.holeCards?.length
            ? privateState.holeCards
            : (seat?.holeCards ?? []);
        const hidden = !isMe && !seat?.holeCards?.length;
        const cards = inHand
          ? hole.length
            ? hole.map((c) => cardMarkup(c, hidden || seat?.folded)).join("")
            : `${cardMarkup(null, false, true)}${cardMarkup(null, false, true)}`
          : "";

        const name = roomSeat.displayName ?? seat?.displayName ?? `座位 ${index + 1}`;
        const stack = seat?.stack ?? roomSeat.stack ?? 0;
        let status = roomSeat.status ?? "empty";
        if (!publicState) {
          if (roomSeat.ready) status = roomSeat.isBot ? "Bot·已准备" : "已准备";
          else status = roomSeat.isBot ? "Bot·未准备" : "未准备";
        } else if (roomSeat.leaveAfterHand) status = "本手后离开";
        else if (waitingNext) status = "下手入局";
        else if (seat?.folded) status = "弃牌";
        else if (seat?.allIn) status = "All-in";
        else if (isTurn) status = "行动中";
        else if (roomSeat.isBot) status = "Bot";
        else status = "在局";

        const tags = [
          isMe ? "human-seat" : "",
          seat?.folded ? "is-folded" : "",
          isTurn ? "is-turn" : "",
          roomSeat.isBot ? "is-bot" : "",
          waitingNext ? "waiting-next" : "",
          roomSeat.leaveAfterHand ? "leaving" : "",
          !publicState && roomSeat.ready ? "is-ready" : "",
        ]
          .filter(Boolean)
          .join(" ");

        return `<article class="seat ${tags}" style="left:${pos.left};top:${pos.top}">
        <div class="seat-cards">${cards}</div>
        <div class="player-meta">
          <span class="seat-avatar ${isMe ? "player-avatar" : ""} ${roomSeat.isBot ? "bot-avatar" : ""}">${isMe ? "你" : roomSeat.isBot ? "B" : index + 1}</span>
          <span class="player-copy"><strong>${name}</strong><small>筹码 ${stack}</small></span>
          ${isDealer ? '<span class="dealer-button" title="庄家">D</span>' : ""}
        </div>
        <span class="seat-status">${status}</span>
      </article>`;
      })
      .join("");

    const community = publicState?.community ?? [];
    const commEl = $<HTMLElement>("#community-cards");
    const cards = community.map((c) => cardMarkup(c));
    while (cards.length < 5) cards.push(cardMarkup(null, false, true));
    commEl.innerHTML = cards.join("");

    $<HTMLElement>("#pot").textContent = String(publicState?.pot ?? 0);
    $<HTMLElement>("#street-name").textContent = streetLabels[publicState?.street ?? ""] ?? "—";

    const gameMsg = $<HTMLElement>("#game-message");
    if (!publicState) {
      const seatedCount = seated.length;
      const readyCount = seated.filter((s) => s.ready).length;
      gameMsg.textContent =
        seatedCount < 2
          ? "等待更多玩家或添加机器人…"
          : `已入座 ${seatedCount} 人 · 已准备 ${readyCount}/${seatedCount} · 房主可开始`;
    } else if (publicState.finished) {
      gameMsg.textContent = "本手已结束，下一手即将开始…";
    } else {
      gameMsg.textContent = streetLabels[publicState.street] ?? "对局中";
    }

    const humanTurn = isTurnForMe();
    const bounds = privateState?.raiseBounds;
    const callInfo = $<HTMLElement>("#call-info");

    if (publicState?.finished) {
      callInfo.textContent = "本手已结束";
    } else if (!publicState) {
      callInfo.textContent = "开局前准备中";
    } else if (publicState.actorSeatId === mySeatIndex) {
      if (bounds && bounds.fullCallAmount > 0) {
        callInfo.textContent = `需跟注 ${bounds.fullCallAmount}`;
      } else if (humanTurn) {
        callInfo.textContent = "轮到你行动";
      } else {
        callInfo.textContent = "轮到你（同步合法动作中…）";
      }
    } else if (!humanTurn) {
      callInfo.textContent = "等待其他玩家";
    } else if (bounds && bounds.fullCallAmount > 0) {
      callInfo.textContent = `需跟注 ${bounds.fullCallAmount}`;
    } else {
      callInfo.textContent = "可以过牌";
    }

    const foldBtn = $<HTMLButtonElement>("#fold-action");
    const callBtn = $<HTMLButtonElement>("#call-action");
    const raiseBtn = $<HTMLButtonElement>("#raise-action");
    const allInBtn = $<HTMLButtonElement>("#all-in-action");
    const betInput = $<HTMLInputElement>("#bet-amount");

    foldBtn.disabled = !humanTurn;
    callBtn.disabled = !humanTurn;
    raiseBtn.disabled = !humanTurn || !privateState?.legalActions.includes("raise");
    allInBtn.disabled = !humanTurn || !privateState?.legalActions.includes("allin");
    betInput.disabled = raiseBtn.disabled;

    if (bounds) {
      callBtn.textContent = bounds.fullCallAmount > 0 ? `跟注 ${bounds.callAmount}` : "过牌";
      betInput.min = String(bounds.minimum);
      betInput.max = String(bounds.maximum);
      if (Number(betInput.value) < bounds.minimum) betInput.value = String(bounds.minimum);
    }

    syncOwnerControls();
  }

  function isTurnForMe() {
    if (!publicState || publicState.finished) return false;
    if (publicState.actorSeatId !== mySeatIndex) return false;
    // Prefer legalActions from private snapshot; if missing, still allow UI to show
    // it's our turn (and sync will refill actions).
    if (privateState && privateState.handId === publicState.handId) {
      return Boolean(privateState.legalActions?.length);
    }
    return true;
  }

  function showGame() {
    lobbyPanel.classList.add("hidden");
    gamePanel.classList.remove("hidden");
  }

  function syncOwnerControls() {
    const can = Boolean(room && iAmEffectiveOwner());
    addBotBtn.disabled = !can;
    removeBotBtn.disabled = !can;
    gameAddBot.disabled = !can;
    gameRemoveBot.disabled = !can;
    gameAddBot.classList.toggle("hidden", !can);
    gameRemoveBot.classList.toggle("hidden", !can);
  }

  function updateLobby() {
    if (!room) return;
    roomInfo.classList.remove("hidden");
    displayRoomCode.textContent = room.roomCode;
    gameRoomCode.textContent = room.roomCode;
    const me = room.seats.find((s) => s.seatIndex === mySeatIndex);
    isReady = me?.ready ?? false;
    const readyLabel = isReady ? "取消准备" : "准备";
    ($("#ready-btn") as HTMLButtonElement).textContent = readyLabel;
    gameReadyBtn.textContent = readyLabel;
    const canStart = iAmEffectiveOwner();
    ($("#start-btn") as HTMLButtonElement).disabled = !canStart;
    gameStartBtn.disabled = !canStart;
    gameEndBtn.disabled = !canStart;
    const acting =
      room.actingOwnerId && room.actingOwnerId !== room.ownerId
        ? `（临时房主代管中）`
        : "";
    if (room.roomCode) {
      displayRoomCode.textContent = `${room.roomCode}${acting}`;
      gameRoomCode.textContent = `${room.roomCode}${acting}`;
    }
    syncOwnerControls();
  }

  async function ensureSocket() {
    // Only hit /api/me when we don't already know the user (cache/single-flight inside).
    if (!isAuthenticated || !myUserId) {
      if (!(await refreshAuth({ quiet: true }))) {
        throw new Error("AUTH_REQUIRED");
      }
    }
    if (socket) return socket;
    socket = new PokerSocket();
    await socket.connect();
    ($("#connection-status") as HTMLElement).textContent = "已连接";
    socket.onMessage((msg) => {
      if (msg.type === "room.snapshot") {
        room = msg as RoomSnapshot;
        const me = room.seats.find((s) => s.userId === myUserId);
        if (me) mySeatIndex = me.seatIndex;
        if (room.roomCode) {
          syncRoomUrl(room.roomCode, "replace");
          roomCodeInput.value = room.roomCode;
        }
        enterRoomView();
      }
      if (msg.type === "game.snapshot.public") {
        publicState = msg as PublicSnapshot;
        handId = publicState.handId;
        turnId = publicState.turnId;
        showGame();
        render();
      }
      if (msg.type === "game.snapshot.private") {
        privateState = msg as PrivateSnapshot;
        render();
      }
      if (msg.type === "game.event") {
        const ev = msg as { eventType?: string; handId?: string; turnId?: number };
        if (ev.eventType === "handStarted") {
          if (ev.handId) handId = ev.handId;
          // Only drop private when it belongs to a different hand. Snapshots may arrive
          // before or after this event; wiping here caused "行动中" + empty legalActions.
          if (privateState && ev.handId && privateState.handId !== ev.handId) {
            privateState = null;
          }
          if (publicState?.handId && ev.handId && publicState.handId !== ev.handId) {
            publicState = { ...publicState, finished: false, handId: ev.handId };
          } else if (publicState) {
            publicState = { ...publicState, finished: false };
          }
          showGame();
          const gameMsg = document.querySelector("#game-message");
          if (gameMsg) gameMsg.textContent = "新一手开始…";
          render();
        }
        if (ev.eventType === "handEnded") {
          const payload = (msg as { payload?: { continues?: boolean } }).payload;
          const continues = payload?.continues !== false;
          const gameMsg = document.querySelector("#game-message");
          if (gameMsg) {
            gameMsg.textContent = continues
              ? "本手已结束，下一手即将开始…"
              : "对局结束（有效玩家不足）";
          }
          if (publicState) publicState = { ...publicState, finished: true };
          render();
        }
        if (ev.eventType === "matchEnded") {
          const gameMsg = document.querySelector("#game-message");
          if (gameMsg) gameMsg.textContent = "对局已结束";
          if (publicState) publicState = { ...publicState, finished: true };
          render();
        }
      }
      if (msg.type === "room.create.ok" || msg.type === "room.join.ok") {
        const m = msg as { roomId: string; roomCode?: string; seatIndex?: number; reconnectToken?: string };
        if (m.seatIndex != null) mySeatIndex = m.seatIndex;
        if (m.roomCode) {
          syncRoomUrl(m.roomCode, "replace");
          roomCodeInput.value = m.roomCode;
          lobbyStatus.textContent = `房间已就绪：${m.roomCode}`;
        } else {
          lobbyStatus.textContent = "房间已创建";
        }
        enterRoomView();
      }
      if (msg.type === "game.error") {
        const e = msg as { error: { code?: string; message: string } };
        if (e.error?.code === "AUTH_REQUIRED" || e.error?.code === "SESSION_EXPIRED") {
          authCache = null;
          setLobbyLocked(true, "请先登录后再创建或加入房间");
          socket?.close();
          socket = null;
          return;
        }
        lobbyStatus.textContent = e.error?.message || "操作失败";
      }
      if (msg.type === "session.kicked") {
        lobbyStatus.textContent = "连接已被替换或踢出";
        socket?.close();
        socket = null;
      }
    });
    socket.onClose((code) => {
      ($("#connection-status") as HTMLElement).textContent = "未连接";
      if (code === 4401) {
        authCache = null;
        setLobbyLocked(true, "请先登录后再创建或加入房间");
        socket = null;
      }
    });
    return socket;
  }

  createBtn.addEventListener("click", async () => {
    try {
      lobbyStatus.textContent = "正在创建房间…";
      const s = await ensureSocket();
      s.createRoom();
    } catch (e) {
      const msg = e instanceof Error ? e.message : "";
      if (msg === "AUTH_REQUIRED") {
        setLobbyLocked(true, "请先登录后再创建或加入房间");
      } else {
        lobbyStatus.textContent = "连接失败，请稍后重试或确认已登录";
      }
    }
  });

  joinBtn.addEventListener("click", async () => {
    const code = roomCodeInput.value.trim().toUpperCase();
    if (!code) return;
    try {
      lobbyStatus.textContent = `正在加入 ${code}…`;
      const s = await ensureSocket();
      s.joinRoom(code);
    } catch (e) {
      const msg = e instanceof Error ? e.message : "";
      if (msg === "AUTH_REQUIRED") {
        setLobbyLocked(true, "请先登录后再创建或加入房间");
      } else {
        lobbyStatus.textContent = "连接失败";
      }
    }
  });

  async function toggleReady() {
    const s = await ensureSocket();
    s.setReady(!isReady);
  }
  async function startMatch() {
    const s = await ensureSocket();
    s.startGame();
  }
  async function endMatch() {
    const s = await ensureSocket();
    s.endMatch();
  }
  function leaveRoomUi() {
    socket?.leaveRoom();
    clearLocalRoomUi();
    syncRoomUrl(null, "replace");
  }

  $("#ready-btn").addEventListener("click", () => void toggleReady());
  $("#start-btn").addEventListener("click", () => void startMatch());
  $("#end-match-btn").addEventListener("click", () => void endMatch());
  $("#leave-btn").addEventListener("click", () => leaveRoomUi());
  gameReadyBtn.addEventListener("click", () => void toggleReady());
  gameStartBtn.addEventListener("click", () => void startMatch());
  gameEndBtn.addEventListener("click", () => void endMatch());
  gameLeaveBtn.addEventListener("click", () => leaveRoomUi());

  async function onAddBot() {
    const s = await ensureSocket();
    s.addBot();
  }
  async function onRemoveBot() {
    const s = await ensureSocket();
    s.removeBot();
  }
  addBotBtn.addEventListener("click", () => void onAddBot());
  removeBotBtn.addEventListener("click", () => void onRemoveBot());
  gameAddBot.addEventListener("click", () => void onAddBot());
  gameRemoveBot.addEventListener("click", () => void onRemoveBot());

  function sendAction(action: string, amount?: number) {
    if (!socket) return;
    const activeHandId = handId || socket.getHandId();
    const activeTurnId = turnId || publicState?.turnId || 0;
    if (!activeHandId) return;
    socket.action(action, {
      handId: activeHandId,
      turnId: activeTurnId,
      clientActionId: createClientActionId(),
      amount,
    });
  }

  $("#fold-action").addEventListener("click", () => sendAction("fold"));
  $("#call-action").addEventListener("click", () => {
    const bounds = privateState?.raiseBounds;
    sendAction(bounds && bounds.fullCallAmount > 0 ? "call" : "check");
  });
  $("#raise-action").addEventListener("click", () => {
    const amount = Number(($("#bet-amount") as HTMLInputElement).value);
    sendAction("raise", amount);
  });
  $("#all-in-action").addEventListener("click", () => sendAction("allin"));

  async function tryAutoJoinFromUrl() {
    if (autoJoinAttempted) return;
    const code = readRoomFromUrl();
    if (!code) return;
    autoJoinAttempted = true;
    roomCodeInput.value = code;
    urlRoomSynced = code;
    try {
      lobbyStatus.textContent = `正在加入房间 ${code}…`;
      const s = await ensureSocket();
      s.joinRoom(code);
    } catch (e) {
      const msg = e instanceof Error ? e.message : "";
      if (msg === "AUTH_REQUIRED") {
        setLobbyLocked(true, "请先登录后再加入房间链接");
      } else {
        lobbyStatus.textContent = "自动加入失败，请手动加入或检查房间码";
      }
    }
  }

  window.addEventListener("popstate", () => {
    const code = readRoomFromUrl();
    if (!code && room) {
      socket?.leaveRoom();
      clearLocalRoomUi();
      urlRoomSynced = null;
      lobbyStatus.textContent = "已返回大厅";
      return;
    }
    if (code && code !== urlRoomSynced) {
      autoJoinAttempted = false;
      void tryAutoJoinFromUrl();
    }
  });

  void (async () => {
    const ok = await refreshAuth();
    if (ok) await tryAutoJoinFromUrl();
    else if (readRoomFromUrl()) {
      roomCodeInput.value = readRoomFromUrl() ?? "";
      lobbyStatus.textContent = "登录后将自动加入房间链接";
    }
  })();
  } // end initPokerGame
</script>

