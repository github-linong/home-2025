---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import {
	BAIDU_HM_ID,
	BAIDU_SITE_VERIFICATION,
	GA_MEASUREMENT_ID,
	SITE_AUTHOR,
	SITE_DESCRIPTION,
	SITE_TITLE,
} from '../config';
import AuthCookie from './AuthCookie.astro';
import { AUTH_COOKIE_NAME } from '../lib/authCookie';
import { profile } from '../data/profile';
import {
	buildCanonicalUrl,
	buildPersonJsonLd,
	buildWebSiteJsonLd,
	wrapJsonLdGraph,
} from '../lib/seo.mjs';

export interface Props {
	title: string;
	description: string;
	image?: string;
	ogType?: string;
	/** Override canonical when different from current URL (rare). */
	canonical?: string;
	/** Extra schema.org nodes merged into @graph (e.g. Article). */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	/** ISO dates for article/demo Open Graph */
	publishedTime?: string;
	modifiedTime?: string;
}

const {
	title,
	description,
	image = '/social_img.webp',
	ogType = 'website',
	canonical: canonicalProp,
	jsonLd: extraJsonLd,
	publishedTime,
	modifiedTime,
} = Astro.props;

const siteBase = Astro.site?.href ?? 'https://www.lilnong.top/';
const canonicalUrl = canonicalProp
	? buildCanonicalUrl(siteBase, canonicalProp)
	: buildCanonicalUrl(siteBase, Astro.url);
const ogImageUrl = new URL(image, Astro.url).href;

const personLd = buildPersonJsonLd({
	name: SITE_AUTHOR,
	url: profile.site,
	description: profile.tagline,
	image: new URL(profile.avatar.local, siteBase).href,
});
const websiteLd = buildWebSiteJsonLd({
	name: SITE_TITLE,
	url: profile.site,
	description: SITE_DESCRIPTION,
	author: personLd,
});
const graphNodes = [
	websiteLd,
	personLd,
	...(Array.isArray(extraJsonLd) ? extraJsonLd : extraJsonLd ? [extraJsonLd] : []),
];
const jsonLdPayload = wrapJsonLdGraph(graphNodes);
const jsonLdHtml = JSON.stringify(jsonLdPayload).replace(/</g, '\\u003c');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title="RSS" href="/rss.xml" />
<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
<link rel="canonical" href={canonicalUrl} />
<meta name="generator" content={Astro.generator} />
{BAIDU_SITE_VERIFICATION && (
	<meta name="baidu-site-verification" content={BAIDU_SITE_VERIFICATION} />
)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={SITE_AUTHOR} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:site_name" content={SITE_TITLE} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />

<script type="application/ld+json" set:html={jsonLdHtml} />

<AuthCookie />

<!-- Baidu Analytics -->
<script is:inline define:vars={{ baiduHmId: BAIDU_HM_ID }}>
  var _hmt = _hmt || [];
  (function () {
    var hm = document.createElement("script");
    hm.src = "https://hm.baidu.com/hm.js?" + baiduHmId;
    var s = document.getElementsByTagName("script")[0];
    s.parentNode.insertBefore(hm, s);
  })();
</script>

<!-- Google Analytics -->
<script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
<script is:inline define:vars={{ gaId: GA_MEASUREMENT_ID, cookieName: AUTH_COOKIE_NAME }}>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag("js", new Date());

  function readVisitorId() {
    if (window.__lilnongVisitorId) return window.__lilnongVisitorId;
    var prefix = cookieName + "=";
    var row = document.cookie.split("; ").find(function (entry) {
      return entry.indexOf(prefix) === 0;
    });
    if (!row) return;
    var raw = row.slice(prefix.length);
    try {
      raw = decodeURIComponent(raw);
    } catch (e) {
      /* keep raw */
    }
    var hash = raw.indexOf("#");
    return (hash === -1 ? raw : raw.slice(0, hash)) || undefined;
  }

  var visitorId = readVisitorId();
  gtag("config", gaId, visitorId ? { user_id: visitorId } : {});
</script>
