---
export interface Props {
  slug: string;
  kind?: string;
  source?: string;
  answerId?: string;
}

const { slug, kind = "article", source = "site", answerId } = Astro.props;
---

<script
  is:inline
  define:vars={{ slug, kind, source, answerId }}
>
  (function () {
    if (typeof gtag !== "function") return;

    function readVisitorId() {
      if (window.__lilnongVisitorId) return window.__lilnongVisitorId;
      var row = document.cookie.split("; ").find(function (entry) {
        return entry.indexOf("auth-uuid=") === 0;
      });
      if (!row) return;
      var raw = row.slice("auth-uuid=".length);
      try {
        raw = decodeURIComponent(raw);
      } catch (e) {
        /* keep raw */
      }
      var hash = raw.indexOf("#");
      return (hash === -1 ? raw : raw.slice(0, hash)) || undefined;
    }

    var visitorId = readVisitorId();
    var baseParams = {
      article_slug: slug,
      content_kind: kind,
      content_source: source,
      answer_id: answerId || undefined,
      visitor_id: visitorId,
    };

    gtag("event", "article_view", baseParams);

    const milestones = [25, 50, 75, 90];
    const fired = new Set();

    function getScrollPercent() {
      const doc = document.documentElement;
      const scrollTop = window.scrollY || doc.scrollTop;
      const height = doc.scrollHeight - doc.clientHeight;
      if (height <= 0) return 100;
      return Math.min(100, Math.round((scrollTop / height) * 100));
    }

    function onScroll() {
      const percent = getScrollPercent();
      for (const milestone of milestones) {
        if (percent >= milestone && !fired.has(milestone)) {
          fired.add(milestone);
          gtag("event", "article_read_progress", {
            article_slug: slug,
            content_kind: kind,
            content_source: source,
            answer_id: answerId || undefined,
            percent_scrolled: milestone,
            visitor_id: visitorId,
          });
        }
      }
      if (fired.size === milestones.length) {
        window.removeEventListener("scroll", onScroll, { passive: true });
      }
    }

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();
  })();
</script>
