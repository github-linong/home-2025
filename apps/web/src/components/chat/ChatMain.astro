---
// Main chat area: scrollable message list + fixed-bottom composer.
// Messages are rendered dynamically by the controller script in ChatPage.astro.
---

<section class="flex flex-col flex-1 min-w-0 bg-base-100">
  {/* ── Message list ── */}
  <div
    id="chat-messages"
    class="flex-1 overflow-y-auto p-4 flex flex-col gap-3"
    role="log"
    aria-live="polite"
    aria-label="消息列表"
  ></div>

  {/* ── Flash banner (rate-limit etc.) ── */}
  <div id="chat-flash" class="hidden text-center text-sm py-1.5 bg-warning text-warning-content" role="alert"></div>

  {/* ── Typing indicator ── */}
  <div id="chat-typing" class="hidden text-xs opacity-60 px-3 py-1 h-6" aria-live="polite"></div>

  {/* ── Composer ── */}
  <form id="chat-composer" class="flex items-center gap-2 p-3 border-t border-base-300 bg-base-100 shrink-0">
    <input
      id="chat-input"
      type="text"
      class="input input-bordered input-sm flex-1"
      placeholder="输入消息… (Enter 发送)"
      autocomplete="off"
      maxlength="2000"
    />
    <button type="submit" class="btn btn-sm btn-primary">发送</button>
  </form>
</section>
