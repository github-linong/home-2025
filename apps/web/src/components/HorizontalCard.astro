---
import { Image } from "astro:assets";
import dayjs from "dayjs";
import { toPlainText } from "../lib/plainText";

export interface Props {
  title: string;
  img?: string;
  desc: string;
  url: string;
  badge?: string;
  tags?: string[];
  target?: string;
  kind?: string;
  votes?: number;
  accepted?: boolean;
  pubDate?: Date | string;
  updatedDate?: Date | string;
  category?: string;
  /** When true, prefer "更新于" as the primary date label (demos). */
  dateAsUpdate?: boolean;
}

const {
  title,
  img,
  desc,
  url,
  badge,
  tags,
  target = "_blank",
  kind,
  votes,
  accepted,
  pubDate,
  updatedDate,
  category,
  dateAsUpdate = false,
} = Astro.props;

const isAnswer = kind === "answer";
const plainDesc = toPlainText(desc, 180);
/** Hide tags redundant with badge / answer status (e.g. tag "问答" vs badge "思否问答"). */
const visibleTags = (tags || []).filter((tag) => {
  if (!tag || tag === badge || tag === category) return false;
  if (badge && (badge.includes(tag) || tag.includes(badge))) return false;
  if (isAnswer && (tag === "问答" || tag === "思否问答")) return false;
  return true;
});
const showStatusRow =
  Boolean(badge) ||
  (isAnswer && accepted) ||
  (isAnswer && votes != null && votes > 0) ||
  visibleTags.length > 0;

function toDay(value?: Date | string) {
  if (!value) return null;
  const d = dayjs(value);
  return d.isValid() ? d : null;
}

const published = toDay(pubDate);
const updated = toDay(updatedDate);
const publishedLabel = published?.format("YYYY-MM-DD") ?? "";
const updatedLabel = updated?.format("YYYY-MM-DD") ?? "";
const hasDistinctUpdate = Boolean(updatedLabel && updatedLabel !== publishedLabel);
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <div class="hero-content flex-col md:flex-row items-start">
    {
      img && (
        <a href={url} target={target} class="shrink-0 w-full md:w-auto">
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="w-full max-w-full md:max-w-[13rem] rounded-lg object-cover aspect-video"
          />
        </a>
      )
    }
    <div class="grow w-full min-w-0">
      <a href={url} target={target} class="block no-underline text-inherit">
        {
          isAnswer && (
            <span class="text-base-content/50 font-normal text-sm block mb-1">Q</span>
          )
        }
        <h2 class="text-xl font-bold leading-snug">{title}</h2>
      </a>

      {
        showStatusRow && (
          <div class="mt-2 flex flex-wrap items-center gap-1.5">
            {badge && <span class="badge badge-secondary badge-sm">{badge}</span>}
            {isAnswer && accepted && <span class="badge badge-success badge-sm">已采纳</span>}
            {isAnswer && votes != null && votes > 0 && (
              <span class="badge badge-ghost badge-sm">👍 {votes}</span>
            )}
            {visibleTags.map((tag) => (
              <a href={`/search/?tag=${encodeURIComponent(tag)}`} class="badge badge-outline badge-sm">
                {tag}
              </a>
            ))}
          </div>
        )
      }

      <a href={url} target={target} class="block no-underline text-inherit">
        {
          (publishedLabel || updatedLabel || category) && (
            <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-base-content/50">
              {dateAsUpdate ? (
                <>
                  {(updatedLabel || publishedLabel) && (
                    <time datetime={updated?.toISOString() || published?.toISOString()}>
                      更新于 {updatedLabel || publishedLabel}
                    </time>
                  )}
                  {hasDistinctUpdate && publishedLabel && (
                    <time datetime={published!.toISOString()}>发布于 {publishedLabel}</time>
                  )}
                </>
              ) : (
                <>
                  {publishedLabel && (
                    <time datetime={published!.toISOString()}>发布于 {publishedLabel}</time>
                  )}
                  {hasDistinctUpdate && (
                    <time datetime={updated!.toISOString()}>更新于 {updatedLabel}</time>
                  )}
                </>
              )}
              {category && <span class="opacity-80">{category}</span>}
            </div>
          )
        }
        {
          plainDesc && (
            <p class="py-2 text-sm md:text-base text-base-content/75 leading-relaxed line-clamp-3">
              {isAnswer && <span class="text-base-content/50 font-medium">A · </span>}
              {plainDesc}
            </p>
          )
        }
      </a>
    </div>
  </div>
</div>
