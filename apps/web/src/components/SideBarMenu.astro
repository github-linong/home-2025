---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-base-300";

const items = [
  { id: "home", href: "/", label: "首页" },
  { id: "blog", href: "/blog/", label: "博客" },
  { id: "search", href: "/search/", label: "搜索" },
  { id: "demos", href: "/demos", label: "项目" },
  { id: "learn-english", href: "/learn-english", label: "学英语" },
  { id: "about", href: "/about", label: "关于" },
  { id: "sf-archive", href: "/archive/segmentfault", label: "思否归档" },
];
---

<ul
  class="menu grow shrink menu-md overflow-y-auto"
  data-sidebar-menu
  data-active-id={sideBarActiveItemID ?? ""}
  data-active-class={activeClass}
>
  {
    items.map((item) => (
      <li>
        <a
          class:list={["py-3", "text-base", sideBarActiveItemID === item.id && activeClass]}
          id={item.id}
          href={item.href}
          data-nav-id={item.id}
        >
          {item.label}
        </a>
      </li>
    ))
  }
</ul>

<script>
  function syncSidebarNav() {
    const menu = document.querySelector("[data-sidebar-menu]");
    if (!menu) return;

    const activeId = menu.getAttribute("data-active-id") || "";
    const activeClass = menu.getAttribute("data-active-class") || "bg-base-300";

    menu.querySelectorAll("a[data-nav-id]").forEach((link) => {
      const on = link.getAttribute("data-nav-id") === activeId;
      link.classList.toggle(activeClass, on);
    });

    const searchLink = menu.querySelector("#search") as HTMLAnchorElement | null;
    if (searchLink && searchLink.dataset.preserveBound !== "1") {
      searchLink.dataset.preserveBound = "1";
      // Stay on current /search/?tag=… — bare href="/search/" would wipe filters.
      searchLink.addEventListener("click", (event) => {
        const path = window.location.pathname.replace(/\/+$/, "") || "/";
        if (path === "/search") event.preventDefault();
      });
    }
  }

  syncSidebarNav();

  const w = window as Window & { __sidebarNavOnLoad?: () => void };
  if (w.__sidebarNavOnLoad) {
    document.removeEventListener("astro:page-load", w.__sidebarNavOnLoad);
  }
  w.__sidebarNavOnLoad = syncSidebarNav;
  document.addEventListener("astro:page-load", syncSidebarNav);
</script>
