---
import SideBarFooter from "./SideBarFooter.astro";
import { Image } from "astro:assets";
import SideBarMenu from "./SideBarMenu.astro";
import AuthStatus from "./AuthStatus.astro";
import SystemNoticeInbox from "./SystemNoticeInbox.astro";
import { profile } from "../data/profile";

const { sideBarActiveItemID, hasSystemNotices = false } = Astro.props;
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay lg:hidden" aria-label="关闭侧边栏"></label>
  <aside class="px-2 pt-2 h-auto min-h-full w-[19rem] bg-base-200 text-base-content flex flex-col" data-pagefind-ignore>
    <div class="w-fit mx-auto mt-5 mb-6">
      <a href="/">
        <div class="avatar transition ease-in-out hover:scale-[102%] block m-auto">
          <div class="w-[8.5rem]">
            <Image class="mask mask-circle" format="webp" width={300} height={300} src={profile.avatar.local} alt={`${profile.name} 头像`} />
          </div>
        </div>
      </a>
    </div>
    <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    <div class="mt-auto">
      {hasSystemNotices && <SystemNoticeInbox />}
      <AuthStatus />
      <SideBarFooter />
    </div>
  </aside>
</div>
