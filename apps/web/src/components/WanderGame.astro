---
import { WanderSocket, getOrCreateDevUserId } from "../lib/wanderSocket";
import type { RoomSnapshot, PlayerView, Dir, WorldSize } from "../lib/wanderProtocol";

interface Props {
  /** When present (from ?room=CODE), the page auto-fills the join box. */
  initialRoomCode?: string;
}
const { initialRoomCode = "" } = Astro.props;
---

<section class="wander-page" data-room-code={initialRoomCode}>
    <header>
      <p>浏览器小游戏</p>
      <h1>漫游</h1>
      <span>默认进入公共房间，在网格地图里游荡，实时看到其他玩家。也可创建私人房间邀请好友。服务端权威，坐标不会丢。</span>
    </header>

    <section class="lobby" id="lobby">
      <div class="lobby-row">
        <button id="btn-public" class="btn primary">进入公共房间</button>
      </div>
      <div class="lobby-row">
        <button id="btn-create" class="btn">创建私人房间</button>
        <span class="or">或</span>
        <input id="input-code" class="code-input" placeholder="房间码" maxlength="6" value={initialRoomCode} />
        <button id="btn-join" class="btn">加入</button>
      </div>
      <p class="hint" id="lobby-hint">方向键 / WASD 移动。公共房间默认进入，所有人可见彼此；私人房间用房间码邀请好友。</p>
    </section>

    <section class="room hidden" id="room">
      <div class="room-bar">
        <div class="room-meta">
          <span class="badge" id="room-code">----</span>
          <span class="badge public hidden" id="room-public">公共</span>
          <span class="muted" id="room-world">地图 0×0</span>
          <span class="muted" id="room-count">0 人在线</span>
          <span class="badge owner hidden" id="room-owner">房主</span>
        </div>
        <div class="room-actions">
          <button id="btn-share" class="btn small">复制邀请链接</button>
          <button id="btn-resize" class="btn small hidden">扩张地图</button>
          <button id="btn-leave" class="btn small ghost">离开</button>
        </div>
      </div>
      <div class="resize-row hidden" id="resize-row">
        <input id="resize-w" class="num-input" type="number" min="1" value="1000" />
        <span>×</span>
        <input id="resize-h" class="num-input" type="number" min="1" value="1000" />
        <button id="btn-resize-apply" class="btn small">应用</button>
      </div>
    </section>

    <section class="stage">
      <div class="canvas-wrap">
        <canvas id="board" width="660" height="660"></canvas>
        <div class="conn" id="conn"><span class="dot"></span><span id="conn-text">未连接</span></div>
        <div class="coords" id="coords">x — · y —</div>
      </div>
      <aside class="players" id="players">
        <h2>玩家</h2>
        <ul id="player-list"><li class="empty">尚未进入房间</li></ul>
        <p class="legend">灰点 = 已断线（宽限内）</p>
      </aside>
    </section>
  </section>

<style>
  .wander-page {
    width: min(100%, 1000px);
    margin: 0 auto;
    padding-bottom: 3rem;
  }
  header { margin-bottom: 1.5rem; }
  header p {
    margin: 0 0 0.25rem;
    color: #967632;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  header h1 {
    margin: 0;
    font-family: Georgia, serif;
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    line-height: 1;
  }
  header span { display: block; margin-top: 0.6rem; opacity: 0.68; }

  .lobby { margin-bottom: 1rem; }
  .lobby-row { display: flex; gap: 0.5rem; align-items: center; flex-wrap: wrap; }
  .or { opacity: 0.6; font-size: 0.85rem; }
  .hint { margin: 0.5rem 0 0; opacity: 0.6; font-size: 0.85rem; }

  .btn {
    border: 1px solid #ccc;
    background: #fafafa;
    color: #222;
    padding: 0.5rem 0.9rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.9rem;
  }
  .btn:hover { background: #f0f0f0; }
  .btn.primary { background: #2b6cff; border-color: #2b6cff; color: #fff; }
  .btn.primary:hover { background: #1f5be0; }
  .btn.ghost { background: transparent; }
  .btn.small { padding: 0.35rem 0.7rem; font-size: 0.82rem; }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }

  .code-input, .num-input {
    text-transform: uppercase;
    letter-spacing: 0.15em;
    padding: 0.5rem 0.6rem;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 0.95rem;
    width: 120px;
  }
  .num-input { text-transform: none; letter-spacing: normal; width: 90px; }

  .room {
    border: 1px solid #e3e3e3;
    border-radius: 12px;
    padding: 0.8rem 1rem;
    margin-bottom: 1rem;
    background: #fff;
  }
  .room-bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .room-meta { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .badge {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
    letter-spacing: 0.18em;
    background: #eef2ff;
    color: #2b3a8f;
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }
  .badge.owner { background: #fff4e0; color: #9a6b00; }
  .badge.public { background: #e6f9ec; color: #1f7a3d; }
  .muted { opacity: 0.6; font-size: 0.85rem; }
  .room-actions { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .resize-row { display: flex; gap: 0.5rem; align-items: center; margin-top: 0.7rem; }

  .stage { display: flex; gap: 1rem; align-items: flex-start; flex-wrap: wrap; }
  .canvas-wrap {
    position: relative;
    background: #f7f8fa;
    border: 1px solid #e3e3e3;
    border-radius: 12px;
    overflow: hidden;
    line-height: 0;
  }
  canvas { display: block; width: 660px; max-width: 100%; height: auto; touch-action: none; }
  .conn {
    position: absolute; top: 8px; left: 8px;
    display: flex; align-items: center; gap: 0.4rem;
    background: rgba(255,255,255,0.85);
    padding: 0.25rem 0.55rem; border-radius: 999px;
    font-size: 0.78rem; color: #444;
  }
  .conn .dot { width: 8px; height: 8px; border-radius: 50%; background: #c0392b; }
  .conn.online .dot { background: #27ae60; }
  .coords {
    position: absolute; bottom: 8px; left: 8px;
    background: rgba(255,255,255,0.85);
    padding: 0.2rem 0.5rem; border-radius: 6px;
    font-size: 0.75rem; font-family: ui-monospace, monospace; color: #444;
  }

  .players {
    flex: 1 1 200px;
    min-width: 200px;
    border: 1px solid #e3e3e3;
    border-radius: 12px;
    padding: 0.8rem 1rem;
    background: #fff;
  }
  .players h2 { margin: 0 0 0.6rem; font-size: 1rem; }
  .players ul { list-style: none; margin: 0; padding: 0; }
  .players li {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.3rem 0; font-size: 0.88rem;
  }
  .players li .swatch { width: 12px; height: 12px; border-radius: 3px; flex: none; }
  .players li .pname { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .players li .pcoord { opacity: 0.55; font-family: ui-monospace, monospace; font-size: 0.75rem; }
  .players li.offline { opacity: 0.5; }
  .players li.you .pname::after { content: " (你)"; color: #2b6cff; font-size: 0.75rem; }
  .players li.empty { opacity: 0.5; }
  .legend { margin: 0.6rem 0 0; opacity: 0.5; font-size: 0.74rem; }

  .hidden { display: none !important; }
</style>

<script>
  import { WanderSocket, getOrCreateDevUserId } from "../lib/wanderSocket";
  import type { RoomSnapshot, PlayerView, Dir, WorldSize } from "../lib/wanderProtocol";

  const root = document.querySelector(".wander-page") as HTMLElement;
  const canvas = document.getElementById("board") as HTMLCanvasElement;
  const ctx = canvas.getContext("2d")!;

  const elLobby = document.getElementById("lobby")!;
  const elRoom = document.getElementById("room")!;
  const btnPublic = document.getElementById("btn-public") as HTMLButtonElement;
  const btnCreate = document.getElementById("btn-create") as HTMLButtonElement;
  const btnJoin = document.getElementById("btn-join") as HTMLButtonElement;
  const inputCode = document.getElementById("input-code") as HTMLInputElement;
  const elCode = document.getElementById("room-code")!;
  const elPublic = document.getElementById("room-public")!;
  const elWorld = document.getElementById("room-world")!;
  const elCount = document.getElementById("room-count")!;
  const elOwner = document.getElementById("room-owner")!;
  const btnShare = document.getElementById("btn-share") as HTMLButtonElement;
  const btnResize = document.getElementById("btn-resize") as HTMLButtonElement;
  const btnResizeApply = document.getElementById("btn-resize-apply") as HTMLButtonElement;
  const btnLeave = document.getElementById("btn-leave") as HTMLButtonElement;
  const resizeRow = document.getElementById("resize-row")!;
  const resizeW = document.getElementById("resize-w") as HTMLInputElement;
  const resizeH = document.getElementById("resize-h") as HTMLInputElement;
  const elConn = document.getElementById("conn")!;
  const elConnText = document.getElementById("conn-text")!;
  const elCoords = document.getElementById("coords")!;
  const elPlayerList = document.getElementById("player-list")!;

  // ---- client state ----
  let socket = new WanderSocket();
  let connected = false;
  let youId: string | null = null;
  let roomId: string | null = null;
  let roomCode = "";
  let publicRoomCode = "";
  let ownerId: string | null = null;
  let world: WorldSize = { w: 1000, h: 1000 };
  let stateVersion = 0;
  let playersById = new Map<string, PlayerView>();
  // Authoritative integer cell per player (from snapshots). The local player's
  // target is advanced optimistically on keypress; we only reconcile to the
  // server when it diverges by >1 cell (a real desync / rejected move), never
  // snap backward — that backward snap was the source of the "jitter".
  let targets = new Map<string, { x: number; y: number; facing: Dir }>();
  // Eased float position per player; the render glides toward `targets` so
  // motion is smooth instead of teleporting one grid cell at a time.
  let renders = new Map<string, { x: number; y: number; facing: Dir }>();
  let localTarget: { x: number; y: number; facing: Dir } | null = null;

  const STEP_MS = 100; // time to glide across one cell
  const SPEED = 1 / (STEP_MS / 1000); // cells per second (~10)

  const VIEW = 33; // cells visible across the canvas (odd → player centered)
  const SIZE = canvas.width;
  const cell = SIZE / VIEW;

  function setConn(on: boolean, text?: string) {
    connected = on;
    elConn.classList.toggle("online", on);
    elConnText.textContent = text ?? (on ? "已连接" : "未连接");
  }

  function showRoom() {
    elLobby.classList.add("hidden");
    elRoom.classList.remove("hidden");
  }
  function showLobby() {
    elLobby.classList.remove("hidden");
    elRoom.classList.add("hidden");
    resizeRow.classList.add("hidden");
    btnResize.classList.add("hidden");
  }

  function applySnapshot(snap: RoomSnapshot) {
    roomId = snap.roomId;
    roomCode = snap.roomCode;
    ownerId = snap.ownerId;
    world = snap.world;
    stateVersion = snap.stateVersion;
    playersById = new Map(snap.players.map((p) => [p.userId, p]));

    // Rebuild authoritative targets from the snapshot; drop players who left.
    const next = new Map<string, { x: number; y: number; facing: Dir }>();
    for (const p of snap.players) next.set(p.userId, { x: p.x, y: p.y, facing: p.facing });
    targets = next;
    for (const uid of [...renders.keys()]) if (!targets.has(uid)) renders.delete(uid);
    for (const [uid, t] of targets) if (!renders.has(uid)) renders.set(uid, { x: t.x, y: t.y, facing: t.facing });

    // Local player: trust optimistic input; only reconcile to the server on a
    // real (>1 cell) divergence (e.g. server rejected a move / reconnected).
    if (youId && localTarget) {
      const s = targets.get(youId);
      if (s) {
        const div = Math.abs(s.x - localTarget.x) + Math.abs(s.y - localTarget.y);
        if (div > 1) localTarget = { x: s.x, y: s.y, facing: s.facing };
        targets.set(youId, { ...localTarget }); // render follows optimistic target
      }
    }

    elCode.textContent = snap.roomCode;
    elWorld.textContent = `地图 ${snap.world.w}×${snap.world.h}`;
    const online = snap.players.filter((p) => p.status === "active").length;
    elCount.textContent = `${online} 人在线`;
    const amOwner = youId != null && snap.ownerId === youId;
    elOwner.classList.toggle("hidden", !amOwner);
    btnResize.classList.toggle("hidden", !amOwner);
    elPublic.classList.toggle("hidden", !(publicRoomCode && snap.roomCode === publicRoomCode));

    renderPlayerList(snap.players);
  }

  function renderPlayerList(players: PlayerView[]) {
    if (players.length === 0) {
      elPlayerList.innerHTML = `<li class="empty">房间里还没有人</li>`;
      return;
    }
    const sorted = [...players].sort((a, b) => a.displayName.localeCompare(b.displayName));
    elPlayerList.innerHTML = sorted
      .map((p) => {
        const off = p.status === "disconnected" ? " offline" : "";
        const you = p.userId === youId ? " you" : "";
        return `<li class="${off}${you}">
          <span class="swatch" style="background:${p.color}"></span>
          <span class="pname">${escapeHtml(p.displayName)}</span>
          <span class="pcoord">${p.x},${p.y}</span>
        </li>`;
      })
      .join("");
  }

  function escapeHtml(s: string) {
    return s.replace(/[&<>"']/g, (c) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c] as string),
    );
  }

  // ---- canvas rendering ----
  function camTopLeft() {
    const me = youId ? renders.get(youId) : undefined;
    const cx = me ? me.x : Math.floor(world.w / 2);
    const cy = me ? me.y : Math.floor(world.h / 2);
    return { camX: cx - Math.floor(VIEW / 2), camY: cy - Math.floor(VIEW / 2) };
  }

  let lastT = 0;
  function stepRenders(dtSec: number) {
    for (const [uid, t] of targets) {
      let r = renders.get(uid);
      if (!r) {
        renders.set(uid, { x: t.x, y: t.y, facing: t.facing });
        continue;
      }
      const dx = t.x - r.x;
      const dy = t.y - r.y;
      if (dx === 0 && dy === 0) {
        r.facing = t.facing;
        continue;
      }
      const maxStep = SPEED * dtSec;
      if (Math.abs(dx) >= Math.abs(dy)) {
        r.x += Math.max(-maxStep, Math.min(maxStep, dx));
      } else {
        r.y += Math.max(-maxStep, Math.min(maxStep, dy));
      }
      r.facing = t.facing;
    }
  }

  function draw(ts?: number) {
    const dtSec = lastT && ts ? Math.min(0.05, (ts - lastT) / 1000) : 0;
    lastT = ts ?? 0;
    stepRenders(dtSec);

    ctx.clearRect(0, 0, SIZE, SIZE);
    const { camX, camY } = camTopLeft();

    // grid + world border
    ctx.lineWidth = 1;
    for (let ix = 0; ix <= VIEW; ix += 1) {
      const wx = camX + ix;
      const inWorld = wx >= 0 && wx < world.w;
      ctx.strokeStyle = !inWorld ? "rgba(0,0,0,0.06)" : ix % 5 === 0 ? "rgba(0,0,0,0.12)" : "rgba(0,0,0,0.06)";
      const sx = ix * cell;
      ctx.beginPath();
      ctx.moveTo(sx, 0);
      ctx.lineTo(sx, SIZE);
      ctx.stroke();
    }
    for (let iy = 0; iy <= VIEW; iy += 1) {
      const wy = camY + iy;
      const inWorld = wy >= 0 && wy < world.h;
      ctx.strokeStyle = !inWorld ? "rgba(0,0,0,0.06)" : iy % 5 === 0 ? "rgba(0,0,0,0.12)" : "rgba(0,0,0,0.06)";
      const sy = iy * cell;
      ctx.beginPath();
      ctx.moveTo(0, sy);
      ctx.lineTo(SIZE, sy);
      ctx.stroke();
    }

    // players — drawn at their eased render position (smooth glide)
    for (const [uid, t] of targets) {
      const r = renders.get(uid) ?? t;
      const p = playersById.get(uid);
      const sx = (r.x - camX + 0.5) * cell;
      const sy = (r.y - camY + 0.5) * cell;
      if (sx < -cell || sy < -cell || sx > SIZE + cell || sy > SIZE + cell) continue;
      const rad = cell * 0.34;
      ctx.globalAlpha = p && p.status === "disconnected" ? 0.4 : 1;
      ctx.fillStyle = p ? p.color : "#888";
      ctx.beginPath();
      ctx.arc(sx, sy, rad, 0, Math.PI * 2);
      ctx.fill();
      // facing notch
      const d = DIR_VEC[r.facing] ?? DIR_VEC.down;
      ctx.strokeStyle = "rgba(255,255,255,0.9)";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(sx, sy);
      ctx.lineTo(sx + d.x * rad, sy + d.y * rad);
      ctx.stroke();
      if (uid === youId) {
        ctx.strokeStyle = "#2b6cff";
        ctx.lineWidth = 2.5;
        ctx.beginPath();
        ctx.arc(sx, sy, rad + 3, 0, Math.PI * 2);
        ctx.stroke();
      }
      // name
      ctx.globalAlpha = 1;
      ctx.fillStyle = "#333";
      ctx.font = "11px system-ui, sans-serif";
      ctx.textAlign = "center";
      ctx.fillText(p ? p.displayName : uid, sx, sy - rad - 4);
    }
    ctx.globalAlpha = 1;

    // coords HUD (grid coords, tracked on the optimistic target)
    if (localTarget) {
      elCoords.textContent = `x ${localTarget.x} · y ${localTarget.y} · 地图 ${world.w}×${world.h}`;
    } else {
      elCoords.textContent = `x — · y —`;
    }

    // debug hook for acceptance tests (harmless in prod)
    if (youId) {
      const me = renders.get(youId);
      (window as unknown as { __wanderDebug: unknown }).__wanderDebug = {
        youId,
        renderX: me ? me.x : null,
        renderY: me ? me.y : null,
        targetX: localTarget ? localTarget.x : null,
        targetY: localTarget ? localTarget.y : null,
        online: playersById.size,
      };
    }

    requestAnimationFrame(draw);
  }

  const DIR_VEC: Record<Dir, { x: number; y: number }> = {
    up: { x: 0, y: -1 },
    down: { x: 0, y: 1 },
    left: { x: -1, y: 0 },
    right: { x: 1, y: 0 },
  };

  // ---- input ----
  const KEY_DIR: Record<string, Dir> = {
    ArrowUp: "up",
    ArrowDown: "down",
    ArrowLeft: "left",
    ArrowRight: "right",
    w: "up",
    s: "down",
    a: "left",
    d: "right",
    W: "up",
    S: "down",
    A: "left",
    D: "right",
  };

  function tryMove(dir: Dir) {
    if (!roomId || !connected || !youId) return;
    const v = DIR_VEC[dir];
    const r = renders.get(youId) ?? localTarget;
    const baseX = r ? Math.round(r.x) : 0;
    const baseY = r ? Math.round(r.y) : 0;
    // Rate-limit: don't queue another step until the previous one has mostly
    // rendered. This keeps motion smooth (the eased render tracks tightly
    // behind input) instead of the target racing far ahead.
    if (localTarget && r) {
      const ahead = Math.abs(localTarget.x - r.x) + Math.abs(localTarget.y - r.y);
      if (ahead > 0.6) return;
    }
    const nx = Math.max(0, Math.min(world.w - 1, baseX + v.x));
    const ny = Math.max(0, Math.min(world.h - 1, baseY + v.y));
    if (nx === baseX && ny === baseY) return; // at a wall → no-op
    localTarget = { x: nx, y: ny, facing: dir };
    socket.move(dir);
  }

  window.addEventListener(
    "keydown",
    (e) => {
      if (document.activeElement === inputCode) return;
      const dir = KEY_DIR[e.key];
      if (dir) {
        e.preventDefault();
        tryMove(dir);
      }
    },
    { passive: false },
  );

  // ---- socket wiring ----
  async function boot() {
    getOrCreateDevUserId();
    setConn(false, "连接中…");
    try {
      await socket.connect();
    } catch (err) {
      setConn(false, (err as Error).message || "连接失败");
      return;
    }
    setConn(true);
    publicRoomCode = socket.publicRoomCode ?? "";
    socket.onMessage((msg) => {
      if (msg.type === "room.snapshot") applySnapshot(msg);
      else if (msg.type === "room.create.ok") {
        youId = msg.you;
        applySnapshot({
          type: "room.snapshot",
          protocolVersion: 1,
          roomId: msg.roomId,
          roomCode: msg.roomCode,
          ownerId: msg.ownerId,
          world: msg.world,
          stateVersion: msg.stateVersion,
          players: msg.players,
        });
        localTarget = { x: msg.player.x, y: msg.player.y, facing: msg.player.facing };
        renders.set(youId, { x: msg.player.x, y: msg.player.y, facing: msg.player.facing });
        targets.set(youId, { ...localTarget });
        showRoom();
      } else if (msg.type === "room.join.ok") {
        youId = msg.you;
        applySnapshot({
          type: "room.snapshot",
          protocolVersion: 1,
          roomId: msg.roomId,
          roomCode: msg.roomCode,
          ownerId: msg.ownerId,
          world: msg.world,
          stateVersion: msg.stateVersion,
          players: msg.players,
        });
        localTarget = { x: msg.player.x, y: msg.player.y, facing: msg.player.facing };
        renders.set(youId, { x: msg.player.x, y: msg.player.y, facing: msg.player.facing });
        targets.set(youId, { ...localTarget });
        showRoom();
      } else if (msg.type === "room.leave.ok") {
        roomId = null;
        youId = null;
        playersById = new Map();
        localTarget = null;
        showLobby();
      } else if (msg.type === "world.resized") {
        world = msg.world;
        stateVersion = msg.stateVersion;
        elWorld.textContent = `地图 ${msg.world.w}×${msg.world.h}`;
      } else if (msg.type === "game.error") {
        if (msg.error.code === "AUTH_REQUIRED") {
          setConn(false, "请先登录");
        } else {
          flashHint(msg.error.message);
        }
      } else if (msg.type === "session.kicked") {
        setConn(false, "已被断开：" + msg.reason);
        showLobby();
      }
    });
    socket.onClose(() => setConn(false, "连接断开"));

    // Default landing: if no ?room=CODE is given, drop straight into the
    // public room so strangers immediately see each other. Otherwise join the
    // shared private room from the URL.
    const auto = (root.dataset.roomCode || "").trim().toUpperCase();
    if (auto) {
      inputCode.value = auto;
      socket.joinRoom(auto);
    } else {
      socket.joinPublicRoom();
    }
  }

  let hintTimer: ReturnType<typeof setTimeout> | null = null;
  function flashHint(text: string) {
    const hint = document.getElementById("lobby-hint");
    if (!hint) return;
    const prev = hint.textContent;
    hint.textContent = text;
    hint.style.color = "#c0392b";
    if (hintTimer) clearTimeout(hintTimer);
    hintTimer = setTimeout(() => {
      hint.textContent = prev;
      hint.style.color = "";
    }, 2500);
  }

  // ---- buttons ----
  btnPublic.addEventListener("click", () => {
    if (!connected) return;
    socket.joinPublicRoom();
  });
  btnCreate.addEventListener("click", () => {
    if (!connected) return;
    socket.createRoom();
  });
  btnJoin.addEventListener("click", () => {
    if (!connected) return;
    const code = inputCode.value.trim().toUpperCase();
    if (!code) return;
    socket.joinRoom(code);
  });
  inputCode.addEventListener("keydown", (e) => {
    if (e.key === "Enter") btnJoin.click();
  });
  btnLeave.addEventListener("click", () => socket.leaveRoom());
  btnShare.addEventListener("click", async () => {
    const url = `${location.origin}${location.pathname}?room=${roomCode}`;
    try {
      await navigator.clipboard.writeText(url);
      flashHint("邀请链接已复制");
    } catch {
      prompt("复制此链接分享给朋友：", url);
    }
  });
  btnResize.addEventListener("click", () => {
    resizeW.value = String(world.w);
    resizeH.value = String(world.h);
    resizeRow.classList.toggle("hidden");
  });
  btnResizeApply.addEventListener("click", () => {
    const w = Math.max(1, Math.min(Number(resizeW.value) || world.w, 1_000_000));
    const h = Math.max(1, Math.min(Number(resizeH.value) || world.h, 1_000_000));
    socket.resizeWorld(w, h);
    resizeRow.classList.add("hidden");
  });

  requestAnimationFrame(draw);
  boot();
</script>
