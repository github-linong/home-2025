---
/** Main content banner — latest unread notice only. */
---

<div data-system-notice-bar-wrap class="mb-4 hidden">
  <div data-system-notice-bar class="alert alert-info shadow-sm py-2.5">
    <div class="flex w-full min-w-0 items-center justify-between gap-2">
      <a data-notice-latest-link href="#" class="min-w-0 flex-1 no-underline text-inherit">
        <div data-notice-latest-title class="truncate text-sm font-semibold leading-snug" />
        <div data-notice-latest-message class="truncate text-xs opacity-80" />
      </a>
      <button
        type="button"
        class="btn btn-ghost btn-xs shrink-0 px-2"
        data-notice-dismiss
        aria-label="关闭公告"
      >
        关闭
      </button>
    </div>
  </div>
</div>

<script>
  import {
    getBannerNotice,
    levelToAlertClass,
    markNoticeRead,
    NOTICE_CHANGE_EVENT,
    readNoticesFromDom,
  } from "../lib/systemNoticeUi.mjs";

  function bindBar(wrap: HTMLElement) {
    if (wrap.dataset.bound === "1") return;
    wrap.dataset.bound = "1";

    const bar = wrap.querySelector<HTMLElement>("[data-system-notice-bar]");
    const latestLink = wrap.querySelector<HTMLAnchorElement>("[data-notice-latest-link]");
    const latestTitle = wrap.querySelector<HTMLElement>("[data-notice-latest-title]");
    const latestMessage = wrap.querySelector<HTMLElement>("[data-notice-latest-message]");
    const dismissBtn = wrap.querySelector<HTMLElement>("[data-notice-dismiss]");

    if (!bar || !latestLink || !latestTitle || !latestMessage) {
      wrap.remove();
      return;
    }

    const barEl = bar;
    const latestLinkEl = latestLink;
    const latestTitleEl = latestTitle;
    const latestMessageEl = latestMessage;

    const notices = readNoticesFromDom();
    if (!notices.length) {
      wrap.remove();
      return;
    }

    function updateBar() {
      const latest = getBannerNotice(notices);
      if (!latest) {
        wrap.classList.add("hidden");
        return;
      }

      wrap.classList.remove("hidden");
      barEl.classList.remove("alert-info", "alert-warning", "alert-error");
      barEl.classList.add(levelToAlertClass(latest.level));

      latestLinkEl.href = latest.url;
      latestTitleEl.textContent = latest.title;
      latestMessageEl.textContent = latest.message;
    }

    dismissBtn?.addEventListener("click", () => {
      const latest = getBannerNotice(notices);
      if (!latest) return;
      markNoticeRead(latest.id);
    });

    document.addEventListener(NOTICE_CHANGE_EVENT, updateBar);
    updateBar();
  }

  function init() {
    document.querySelectorAll<HTMLElement>("[data-system-notice-bar-wrap]").forEach(bindBar);
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
