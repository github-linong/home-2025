---
import { profile } from "../data/profile";
---

<div
    class="block sticky pointer-events-none bottom-10 bg-base-200 justify-center h-12 [mask-image:linear-gradient(transparent,#000000)]"
>
</div>

<div class="social-icons px-4 pb-5 pt-1 flex self-center justify-center sticky bottom-0 bg-base-200">
    <a
        href={profile.links.github}
        target="_blank"
        rel="noreferrer"
        class="mx-3"
        aria-label="GitHub"
        title="GitHub @github-linong"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            style="fill: currentColor;"
            ><path
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M12.026 2c-5.509 0-9.974 4.465-9.974 9.974 0 4.406 2.857 8.145 6.821 9.465.499.09.679-.217.679-.481 0-.237-.008-.865-.011-1.696-2.775.602-3.361-1.338-3.361-1.338-.452-1.152-1.107-1.459-1.107-1.459-.905-.619.069-.605.069-.605 1.002.07 1.527 1.028 1.527 1.028.89 1.524 2.336 1.084 2.902.829.091-.645.351-1.085.635-1.334-2.214-.251-4.542-1.107-4.542-4.93 0-1.087.389-1.979 1.024-2.675-.101-.253-.446-1.268.099-2.64 0 0 .837-.269 2.742 1.021a9.582 9.582 0 0 1 2.496-.336 9.554 9.554 0 0 1 2.496.336c1.906-1.291 2.742-1.021 2.742-1.021.545 1.372.203 2.387.099 2.64.64.696 1.024 1.587 1.024 2.675 0 3.833-2.33 4.675-4.552 4.922.355.308.675.916.675 1.846 0 1.334-.012 2.41-.012 2.737 0 .267.178.577.687.479C19.146 20.115 22 16.379 22 11.974 22 6.465 17.535 2 12.026 2z"
            ></path>
        </svg>
    </a>
    <a
        href="/about#contact"
        class="mx-3"
        aria-label={`微信 ${profile.contact.wechat}`}
        title={`微信 ${profile.contact.wechat} · 公众号「${profile.contact.wechatPublicAccount}」`}
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            style="fill: currentColor;"
            aria-hidden="true"
        >
            <path
                d="M8.691 2.188C3.891 2.188 0 5.476 0 9.53c0 2.212 1.17 4.203 3.002 5.55a.59.59 0 0 1 .213.665l-.39 1.48c-.019.07-.048.141-.048.213 0 .163.13.295.29.295a.326.326 0 0 0 .167-.054l1.903-1.114a.864.864 0 0 1 .717-.098 10.16 10.16 0 0 0 2.837.403c.276 0 .543-.027.811-.05-.857-2.578.157-4.934 1.942-6.459 1.722-1.47 4.098-1.927 6.31-1.927-.18-3.868-3.96-6.856-8.263-6.856zm-3.24 5.048a1.03 1.03 0 0 1 0-2.06c.564 0 1.023.46 1.023 1.03 0 .563-.46 1.03-1.023 1.03zm6.48 0a1.03 1.03 0 0 1 0-2.06c.563 0 1.022.46 1.022 1.03 0 .563-.459 1.03-1.022 1.03z"
            ></path>
            <path
                d="M23.997 14.612c0-3.423-3.4-6.203-7.584-6.203-4.184 0-7.584 2.78-7.584 6.203s3.4 6.203 7.584 6.203c.79 0 1.555-.1 2.278-.283a.72.72 0 0 1 .597.082l1.584.927a.272.272 0 0 0 .14.044c.134 0 .24-.108.24-.241 0-.06-.023-.12-.038-.177l-.325-1.233a.493.493 0 0 1 .177-.552c1.531-1.13 2.515-2.79 2.515-4.77zm-10.146-.867a.857.857 0 1 1 0-1.714.857.857 0 0 1 0 1.714zm5.145 0a.857.857 0 1 1 0-1.714.857.857 0 0 1 0 1.714z"
            ></path>
        </svg>
    </a>
    <a href="/rss.xml" target="_blank" class="mx-3" aria-label="RSS Feed" title="RSS Feed">
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            style="fill: currentColor;"
            ><path d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"></path><path
                d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"></path><circle cx="6" cy="18" r="2"
            ></circle>
        </svg>
    </a>
</div>
