---
/**
 * Card-effect showcase driven by the novel codex JSON data.
 * Each section demos one visual style with a slice of the same dataset.
 */
import {
  ANIMAL_CHARACTER_PROFILES,
  HUMAN_CHARACTER_PROFILES,
  NOVEL_CODEX_SOURCE,
} from "../../lib/novelCharacters.js";

const flipCards = HUMAN_CHARACTER_PROFILES.slice(0, 6);
const holoCards = ANIMAL_CHARACTER_PROFILES.slice(0, 6);
const glassCards = ANIMAL_CHARACTER_PROFILES.slice(6, 12);
const spotlightCards = HUMAN_CHARACTER_PROFILES.slice(6, 12);
const rosterRows = [
  ...HUMAN_CHARACTER_PROFILES.slice(12).map((row) => ({ ...row, kind: "人物" })),
  ...ANIMAL_CHARACTER_PROFILES.slice(12).map((row) => ({ ...row, kind: "动物" })),
];
const tiltCards = [...HUMAN_CHARACTER_PROFILES.slice(12), ...ANIMAL_CHARACTER_PROFILES.slice(12)];
const beamCards = [...HUMAN_CHARACTER_PROFILES.slice(9, 12), ...ANIMAL_CHARACTER_PROFILES.slice(9, 12)];
const duotoneCards = HUMAN_CHARACTER_PROFILES.slice(0, 6);
const ticketCards = HUMAN_CHARACTER_PROFILES.slice(6, 10);
const stackCards = ANIMAL_CHARACTER_PROFILES.slice(6, 11);
const accordionCards = ANIMAL_CHARACTER_PROFILES.slice(1, 5);
const polaroidCards = HUMAN_CHARACTER_PROFILES.slice(9, 15);
const glitchCards = ANIMAL_CHARACTER_PROFILES.slice(9, 15);
const stampCards = HUMAN_CHARACTER_PROFILES.slice(3, 9);
const editorialCards = HUMAN_CHARACTER_PROFILES.slice(0, 6);
const kenburnsCards = [HUMAN_CHARACTER_PROFILES[0], ANIMAL_CHARACTER_PROFILES[1]];
const revealCards = ANIMAL_CHARACTER_PROFILES.slice(2, 6);
const blendCards = HUMAN_CHARACTER_PROFILES.slice(9, 15);
const textclipCards = [
  HUMAN_CHARACTER_PROFILES[0],
  HUMAN_CHARACTER_PROFILES[9],
  ANIMAL_CHARACTER_PROFILES[1],
  ANIMAL_CHARACTER_PROFILES[12],
];
const cineCards = [
  ANIMAL_CHARACTER_PROFILES[1],
  ANIMAL_CHARACTER_PROFILES[10],
  ANIMAL_CHARACTER_PROFILES[12],
  ANIMAL_CHARACTER_PROFILES[0],
];
const parallaxCards = [HUMAN_CHARACTER_PROFILES[10], HUMAN_CHARACTER_PROFILES[12]];
const zoomrevCards = HUMAN_CHARACTER_PROFILES.slice(3, 7);
const letterboxCards = [ANIMAL_CHARACTER_PROFILES[11], ANIMAL_CHARACTER_PROFILES[6]];

const sections = [
  { id: "flip", title: "翻转卡 Flip Card", note: "悬停或点击翻面：正面立绘 + 身份，背面完整介绍。适合信息分层，图鉴感最强。" },
  { id: "holo", title: "收藏卡 Holo Card", note: "游戏收藏卡质感：渐变描边 + 悬停光泽扫过 + 轻微抬升。适合突出稀有度与阵营。" },
  { id: "glass", title: "玻璃遮罩卡 Glass Overlay", note: "整图铺底，毛玻璃信息面板常驻底部、悬停展开介绍。适合以插画为主角的展示。" },
  { id: "spotlight", title: "聚光灯卡 Spotlight", note: "光标附近浮现径向光晕（纯桌面端效果），暗色主题下更明显。适合科技感列表。" },
  { id: "roster", title: "档案条 Roster", note: "紧凑横条：小头像 + 单行身份 + 标签。适合成员多、需要快速扫读的场景。" },
  { id: "tilt", title: "3D 倾斜卡 Tilt", note: "卡片跟随光标做 3D 透视倾斜并伴随高光（桌面端效果），立体感最强，适合重点角色展示。" },
  { id: "beam", title: "流光描边卡 Border Beam", note: "一束光沿卡片边框持续旋转（纯 CSS @property 动画）。适合强调「进行中 / 高亮」状态。" },
  { id: "duotone", title: "双色调卡 Duotone", note: "默认黑白灰度，悬停或触摸时恢复彩色并轻微放大。适合回忆、档案或「阵亡名单」类叙事。" },
  { id: "ticket", title: "票券卡 Ticket", note: "登机牌式布局：左侧存根 + 打孔缺口 + 虚线撕裂线（CSS mask 实现）。适合凭证、邀请函场景。" },
  { id: "stack", title: "堆叠卡 Card Stack", note: "卡组叠放，点击顶层卡片切到下一张。适合逐个介绍角色的沉浸式浏览。" },
  { id: "accordion", title: "手风琴卡 Accordion", note: "横向并排压缩，悬停或点击展开为主图，其余自动收窄。适合少量重点角色的全景对比。" },
  { id: "polaroid", title: "拍立得卡 Polaroid", note: "白框相纸 + 胶带 + 随机偏转角度，悬停摆正放大。适合生活化、回忆向的相册风展示。" },
  { id: "glitch", title: "故障风卡 Glitch", note: "悬停触发 RGB 通道分离与扫描线抖动，呼应末世科幻氛围。适合异常、危险或电子档案场景。" },
  { id: "stamp", title: "邮票卡 Stamp", note: "CSS mask 打出锯齿孔边做成纪念邮票。适合成就徽章、纪念收藏类展示。" },
  { id: "editorial", title: "杂志编辑卡 Editorial", note: "无图大序号纯排版，靠字号、留白和细线分层。适合风格稳重的正文式介绍列表。" },
  { id: "kenburns", title: "电影横幅卡 Ken Burns", note: "整图作背景 + 持续缓慢推拉镜头 + 左侧暗部渐变压字，电影片头质感。适合页头 Hero 或专题入口。" },
  { id: "reveal", title: "上滑揭示卡 Slide Reveal", note: "整图铺满，常态只露标题条，悬停或聚焦时信息面板整体上滑盖住图片。适合图为主、按需读文的浏览。" },
  { id: "blend", title: "色调滤镜卡 Color Blend", note: "在背景图上叠加彩色渐变（mix-blend-mode），悬停还原本色。适合给同组内容统一氛围色。" },
  { id: "textclip", title: "文字镂空卡 Text Clip", note: "背景图填充进大号文字（background-clip: text），名字本身就是画面。适合海报感的角色首屏。" },
  { id: "cine", title: "轮播横幅卡 Cinema Slideshow", note: "多张 Ken Burns 横幅交叉淡入自动轮播，每张推拉方向不同；可点圆点切换，悬停暂停。适合首页 Hero 轮换位。" },
  { id: "parallax", title: "视差横幅卡 Scroll Parallax", note: "滚动页面时背景图以不同速度平移（CSS 滚动驱动动画，新浏览器生效、旧浏览器静态降级）。适合长文中的分隔横幅。" },
  { id: "zoomrev", title: "推近揭示卡 Zoom Reveal", note: "悬停时镜头缓慢推近、暗角加深、介绍文字上浮，流媒体海报墙的经典交互。适合角色墙 / 作品墙。" },
  { id: "letterbox", title: "宽银幕字幕卡 Letterbox", note: "21:9 遮幅画框 + 底部居中电影字幕，悬停时黑边收窄、字幕换成台词式介绍。适合金句、场面感展示。" },
];
---

<div class="not-prose codex-gallery space-y-10" data-codex-gallery>
  <section class="space-y-2">
    <p class="text-sm leading-relaxed m-0 text-base-content/75">
      数据来自
      <a href={NOVEL_CODEX_SOURCE.page} class="link link-primary">《{NOVEL_CODEX_SOURCE.title}》设定页</a>
      的人物与动物图鉴（`src/data/novel-codex.json`，15 位人物 + 15 个进化动物）。
      下面用同一组数据演示 23 种卡片效果，每种效果取其中一部分角色（部分角色会在不同效果中复用）。
    </p>
    <p class="text-xs text-base-content/45 m-0">{NOVEL_CODEX_SOURCE.note}</p>
    <nav class="flex flex-wrap gap-1.5 pt-1" aria-label="卡片效果目录">
      {sections.map((s) => <a href={`#${s.id}`} class="badge badge-outline badge-lg">{s.title}</a>)}
    </nav>
  </section>

  {/* 1. 翻转卡 */}
  <section id="flip" class="scroll-mt-28 space-y-3">
    <h2 class="text-xl font-bold m-0">{sections[0].title}</h2>
    <p class="text-sm text-base-content/60 m-0">{sections[0].note}</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        flipCards.map((p) => (
          <button type="button" class="flip-card" aria-label={`翻转查看 ${p.name} 的介绍`}>
            <div class="flip-inner">
              <div class="flip-face flip-front rounded-2xl border border-base-300 bg-base-100 overflow-hidden">
                <img src={p.image} alt={`${p.name} AI 插画`} width="640" height="640" loading="lazy" decoding="async" class="w-full aspect-square object-cover" />
                <div class="p-3 text-left">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-semibold">{p.name}</span>
                    <span class="badge badge-outline badge-sm shrink-0">{p.group}</span>
                  </div>
                  <p class="text-xs text-base-content/55 m-0 mt-1 truncate">{p.role}</p>
                </div>
              </div>
              <div class="flip-face flip-back rounded-2xl border border-primary/30 bg-base-100 p-4 text-left">
                <h3 class="font-semibold m-0">
                  {p.name}
                  {p.aliases && <span class="ml-1.5 text-xs font-normal text-base-content/45">· {p.aliases}</span>}
                </h3>
                <p class="text-xs text-primary/80 m-0 mt-1">{p.role}</p>
                <p class="text-sm text-base-content/75 m-0 mt-2 leading-relaxed">{p.intro}</p>
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {p.tags.map((tag) => <span class="badge badge-ghost badge-sm">{tag}</span>)}
                </div>
              </div>
            </div>
          </button>
        ))
      }
    </div>
  </section>

  {/* 2. 收藏卡 */}
  <section id="holo" class="scroll-mt-28 space-y-3">
    <h2 class="text-xl font-bold m-0">{sections[1].title}</h2>
    <p class="text-sm text-base-content/60 m-0">{sections[1].note}</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        holoCards.map((p) => (
          <article class="holo-card rounded-2xl p-[2px]">
            <div class="rounded-[calc(1rem-1px)] bg-base-100 overflow-hidden h-full flex flex-col">
              <div class="relative">
                <img src={p.image} alt={`${p.name} AI 插画`} width="640" height="640" loading="lazy" decoding="async" class="w-full aspect-square object-cover" />
                <span class="holo-shine" aria-hidden="true" />
                <span class="absolute top-2 left-2 badge badge-warning badge-sm font-semibold shadow">{p.group}</span>
              </div>
              <div class="p-3 grow flex flex-col">
                <div class="flex items-baseline justify-between gap-2">
                  <h3 class="font-semibold m-0">{p.name}</h3>
                  {p.aliases && <span class="text-xs text-base-content/45 truncate">{p.aliases}</span>}
                </div>
                <p class="text-xs text-base-content/55 m-0 mt-1">{p.role}</p>
                <div class="flex flex-wrap gap-1.5 mt-auto pt-3">
                  {p.tags.map((tag) => <span class="badge badge-ghost badge-sm">{tag}</span>)}
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* 3. 玻璃遮罩卡 */}
  <section id="glass" class="scroll-mt-28 space-y-3">
    <h2 class="text-xl font-bold m-0">{sections[2].title}</h2>
    <p class="text-sm text-base-content/60 m-0">{sections[2].note}</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        glassCards.map((p) => (
          <article class="glass-card rounded-2xl overflow-hidden border border-base-300" tabindex="0">
            <img src={p.image} alt={`${p.name} AI 插画`} width="640" height="640" loading="lazy" decoding="async" class="w-full aspect-square object-cover" />
            <div class="glass-panel">
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-semibold m-0 text-white drop-shadow">{p.name}</h3>
                <span class="badge badge-sm border-white/40 bg-white/15 text-white">{p.group}</span>
              </div>
              <p class="glass-more text-xs text-white/80 m-0 mt-1">{p.role}</p>
              <p class="glass-more text-sm text-white/90 m-0 mt-2 leading-relaxed">{p.intro}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* 4. 聚光灯卡 */}
  <section id="spotlight" class="scroll-mt-28 space-y-3">
    <h2 class="text-xl font-bold m-0">{sections[3].title}</h2>
    <p class="text-sm text-base-content/60 m-0">{sections[3].note}</p>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        spotlightCards.map((p) => (
          <article class="spot-card rounded-2xl border border-base-300 bg-base-100 p-4 flex gap-3">
            <img src={p.image} alt={`${p.name} AI 插画`} width="640" height="640" loading="lazy" decoding="async" class="w-16 h-16 rounded-xl object-cover shrink-0 border border-base-300" />
            <div class="min-w-0">
              <div class="flex flex-wrap items-baseline gap-x-2">
                <h3 class="font-semibold m-0">{p.name}</h3>
                {p.aliases && <span class="text-xs text-base-content/45">{p.aliases}</span>}
                <span class="badge badge-outline badge-sm ml-auto">{p.group}</span>
              </div>
              <p class="text-xs text-base-content/55 m-0 mt-1">{p.role}</p>
              <p class="text-sm text-base-content/75 m-0 mt-2 leading-relaxed">{p.intro}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* 5. 档案条 */}
  <section id="roster" class="scroll-mt-28 space-y-3">
    <h2 class="text-xl font-bold m-0">{sections[4].title}</h2>
    <p class="text-sm text-base-content/60 m-0">{sections[4].note}</p>
    <ul class="m-0 p-0 list-none divide-y divide-base-300 rounded-2xl border border-base-300 bg-base-100 overflow-hidden">
      {
        rosterRows.map((p) => (
          <li class="roster-row flex items-center gap-3 px-3 py-2.5">
            <img src={p.image} alt={`${p.name} AI 插画`} width="640" height="640" loading="lazy" decoding="async" class="w-10 h-10 rounded-full object-cover shrink-0 border border-base-300" />
            <div class="min-w-0 grow">
              <div class="flex items-baseline gap-2">
                <span class="font-medium text-sm">{p.name}</span>
                <span class="text-xs text-base-content/50 truncate">{p.role}</span>
              </div>
            </div>
            <div class="hidden sm:flex flex-wrap gap-1 justify-end max-w-56">
              {p.tags.slice(0, 2).map((tag) => <span class="badge badge-ghost badge-sm">{tag}</span>)}
            </div>
            <span class={`badge badge-sm shrink-0 ${p.kind === "动物" ? "badge-success badge-outline" : "badge-outline"}`}>
              {p.kind}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  {/* 6. 3D 倾斜卡 */}
  <section id="tilt" class="scroll-mt-28 space-y-3">
    <h2 class="text-xl font-bold m-0">{sections[5].title}</h2>
    <p class="text-sm text-base-content/60 m-0">{sections[5].note}</p>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        tiltCards.map((p) => (
          <article class="tilt-card rounded-2xl border border-base-300 bg-base-100 overflow-hidden">
            <div class="relative">
              <img src={p.image} alt={`${p.name} AI 插画`} width="640" height="640" loading="lazy" decoding="async" class="w-full aspect-square object-cover" />
              <span class="tilt-glare" aria-hidden="true" />
            </div>
            <div class="p-3">
              <div class="flex items-center justify-between gap-2">
                <h3 class="font-semibold m-0">{p.name}</h3>
                <span class="badge badge-outline badge-sm shrink-0">{p.group}</span>
              </div>
              <p class="text-xs text-base-content/55 m-0 mt-1 truncate">{p.role}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* 7. 流光描边卡 */}
  <section id="beam" class="scroll-mt-28 space-y-3">
    <h2 class="text-xl font-bold m-0">{sections[6].title}</h2>
    <p class="text-sm text-base-content/60 m-0">{sections[6].note}</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        beamCards.map((p) => (
          <article class="beam-card rounded-2xl bg-base-100 p-4 flex gap-3 items-start">
            <img src={p.image} alt={`${p.name} AI 插画`} width="640" height="640" loading="lazy" decoding="async" class="w-14 h-14 rounded-xl object-cover shrink-0 border border-base-300" />
            <div class="min-w-0">
              <div class="flex flex-wrap items-baseline gap-x-2">
                <h3 class="font-semibold m-0">{p.name}</h3>
                {p.aliases && <span class="text-xs text-base-content/45">{p.aliases}</span>}
              </div>
              <p class="text-xs text-base-content/55 m-0 mt-1">{p.role}</p>
              <div class="flex flex-wrap gap-1.5 mt-2">
                {p.tags.slice(0, 3).map((tag) => <span class="badge badge-ghost badge-sm">{tag}</span>)}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* 8. 双色调卡 */}
  <section id="duotone" class="scroll-mt-28 space-y-3">
    <h2 class="text-xl font-bold m-0">{sections[7].title}</h2>
    <p class="text-sm text-base-content/60 m-0">{sections[7].note}</p>
    <div class="grid gap-4 grid-cols-2 lg:grid-cols-3">
      {
        duotoneCards.map((p) => (
          <article class="duo-card rounded-2xl overflow-hidden relative border border-base-300" tabindex="0">
            <img src={p.image} alt={`${p.name} AI 插画`} width="640" height="640" loading="lazy" decoding="async" class="w-full aspect-square object-cover" />
            <div class="absolute inset-x-0 bottom-0 p-3 bg-gradient-to-t from-black/75 via-black/35 to-transparent pointer-events-none">
              <h3 class="font-semibold m-0 text-white drop-shadow">{p.name}</h3>
              <p class="text-xs text-white/75 m-0 mt-0.5 truncate">{p.role}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* 9. 票券卡 */}
  <section id="ticket" class="scroll-mt-28 space-y-3">
    <h2 class="text-xl font-bold m-0">{sections[8].title}</h2>
    <p class="text-sm text-base-content/60 m-0">{sections[8].note}</p>
    <div class="grid gap-4 md:grid-cols-2">
      {
        ticketCards.map((p) => (
          <article class="ticket-card bg-base-100 border border-base-300 rounded-xl flex overflow-hidden">
            <div class="w-28 shrink-0 p-3 flex flex-col items-center gap-2 border-r border-dashed border-base-300 text-center">
              <img src={p.image} alt={`${p.name} AI 插画`} width="640" height="640" loading="lazy" decoding="async" class="w-16 h-16 rounded-lg object-cover border border-base-300" />
              <span class="badge badge-outline badge-sm">{p.group}</span>
            </div>
            <div class="p-3 min-w-0 grow">
              <div class="flex items-baseline justify-between gap-2">
                <h3 class="font-semibold m-0">
                  {p.name}
                  {p.aliases && <span class="ml-1.5 text-xs font-normal text-base-content/45">· {p.aliases}</span>}
                </h3>
                <span class="text-[0.65rem] uppercase tracking-widest text-base-content/35 shrink-0">Codex Pass</span>
              </div>
              <p class="text-xs text-base-content/55 m-0 mt-1">{p.role}</p>
              <p class="text-sm text-base-content/75 m-0 mt-2 leading-relaxed line-clamp-2">{p.intro}</p>
              <div class="flex flex-wrap gap-1.5 mt-2">
                {p.tags.slice(0, 3).map((tag) => <span class="badge badge-ghost badge-sm">{tag}</span>)}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  {/* 10. 堆叠卡 */}
  <section id="stack" class="scroll-mt-28 space-y-3">
    <h2 class="text-xl font-bold m-0">{sections[9].title}</h2>
    <p class="text-sm text-base-content/60 m-0">{sections[9].note}</p>
    <div class="flex flex-col items-center gap-3">
      <div class="stack-wrap w-64 sm:w-72" role="group" aria-label="点击切换角色卡">
        {
          stackCards.map((p, index) => (
            <article class="stack-card rounded-2xl border border-base-300 bg-base-100 overflow-hidden shadow-lg" data-pos={index}>
              <img src={p.image} alt={`${p.name} AI 插画`} width="640" height="640" loading="lazy" decoding="async" class="w-full aspect-square object-cover" />
              <div class="p-3">
