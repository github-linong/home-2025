<style>
  /* ---- 1. Flip card ---- */
  .flip-card {
    display: block;
    width: 100%;
    perspective: 1200px;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .flip-inner {
    position: relative;
    width: 100%;
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .flip-face {
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .flip-back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
    overflow: auto;
  }
  .flip-card.is-flipped .flip-inner,
  .flip-card:focus-visible .flip-inner {
    transform: rotateY(180deg);
  }
  @media (hover: hover) {
    .flip-card:hover .flip-inner {
      transform: rotateY(180deg);
    }
  }

  /* ---- 2. Holo card ---- */
  .holo-card {
    background: linear-gradient(135deg, oklch(75% 0.15 85), oklch(65% 0.2 300), oklch(70% 0.17 200));
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .holo-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, transparent 35%, rgba(255, 255, 255, 0.45) 50%, transparent 65%);
    transform: translateX(-110%);
    pointer-events: none;
  }
  @media (hover: hover) {
    .holo-card:hover {
      transform: translateY(-4px) scale(1.01);
      box-shadow: 0 12px 32px -12px oklch(65% 0.2 300 / 0.55);
    }
    .holo-card:hover .holo-shine {
      transition: transform 0.7s ease;
      transform: translateX(110%);
    }
  }

  /* ---- 3. Glass overlay card ---- */
  .glass-card {
    position: relative;
  }
  .glass-panel {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.75rem 0.875rem 0.875rem;
    background: rgba(15, 20, 30, 0.45);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.18);
  }
  .glass-more {
    display: none;
  }
  .glass-card:hover .glass-more,
  .glass-card:focus-within .glass-more,
  .glass-card:focus .glass-more {
    display: block;
  }

  /* ---- 4. Spotlight card ---- */
  .spot-card {
    position: relative;
    overflow: hidden;
    --spot-x: 50%;
    --spot-y: 50%;
  }
  @media (hover: hover) {
    .spot-card::before {
      content: "";
      position: absolute;
      inset: 0;
      opacity: 0;
      transition: opacity 0.25s ease;
      background: radial-gradient(
        320px circle at var(--spot-x) var(--spot-y),
        oklch(70% 0.15 250 / 0.18),
        transparent 70%
      );
      pointer-events: none;
    }
    .spot-card:hover::before {
      opacity: 1;
    }
    .spot-card:hover {
      border-color: oklch(70% 0.15 250 / 0.5);
    }
  }

  /* ---- 5. Roster row ---- */
  .roster-row {
    transition: background-color 0.15s ease;
  }
  .roster-row:hover {
    background-color: oklch(70% 0.05 250 / 0.08);
  }

  /* ---- 6. Tilt card ---- */
  .tilt-card {
    --tilt-x: 0deg;
    --tilt-y: 0deg;
    --glare-x: 50%;
    --glare-y: 50%;
    --glare-o: 0;
    transform: perspective(900px) rotateX(var(--tilt-x)) rotateY(var(--tilt-y));
    transition: transform 0.15s ease-out;
    will-change: transform;
  }
  .tilt-glare {
    position: absolute;
    inset: 0;
    opacity: var(--glare-o);
    background: radial-gradient(
      240px circle at var(--glare-x) var(--glare-y),
      rgba(255, 255, 255, 0.35),
      transparent 60%
    );
    transition: opacity 0.2s ease;
    pointer-events: none;
  }

  /* ---- 7. Border beam card ---- */
  @property --beam-angle {
    syntax: "<angle>";
    initial-value: 0deg;
    inherits: false;
  }
  .beam-card {
    position: relative;
    border: 1px solid transparent;
    background-clip: padding-box;
  }
  .beam-card::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1.5px;
    background: conic-gradient(
      from var(--beam-angle),
      transparent 0deg 280deg,
      oklch(72% 0.16 250) 320deg,
      oklch(80% 0.14 320) 340deg,
      transparent 360deg
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    animation: beam-spin 4s linear infinite;
    pointer-events: none;
  }
  @keyframes beam-spin {
    to {
      --beam-angle: 360deg;
    }
  }

  /* ---- 8. Duotone card ---- */
  .duo-card img {
    filter: grayscale(1) contrast(1.05);
    transition: filter 0.4s ease, transform 0.4s ease;
  }
  .duo-card:hover img,
  .duo-card:focus img,
  .duo-card:focus-within img {
    filter: none;
    transform: scale(1.04);
  }

  /* ---- 9. Ticket card ---- */
  .ticket-card {
    /* Punch a notch where the stub (w-28 = 7rem) meets the body. */
    --notch-x: 7rem;
    -webkit-mask: radial-gradient(circle 8px at var(--notch-x) 0, transparent 7px, #000 8px),
      radial-gradient(circle 8px at var(--notch-x) 100%, transparent 7px, #000 8px);
    -webkit-mask-composite: source-in;
    mask: radial-gradient(circle 8px at var(--notch-x) 0, transparent 7px, #000 8px),
      radial-gradient(circle 8px at var(--notch-x) 100%, transparent 7px, #000 8px);
    mask-composite: intersect;
  }

  /* ---- 10. Card stack ---- */
  .stack-wrap {
    position: relative;
    aspect-ratio: 4 / 5.1;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
  }
  .stack-card {
    position: absolute;
    inset: 0;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.3, 1), opacity 0.35s ease;
  }
  .stack-card[data-pos="0"] {
    z-index: 5;
  }
  .stack-card[data-pos="1"] {
    transform: translateX(7%) scale(0.95) rotate(2.5deg);
    z-index: 4;
  }
  .stack-card[data-pos="2"] {
    transform: translateX(14%) scale(0.9) rotate(5deg);
    z-index: 3;
  }
  .stack-card[data-pos="3"] {
    transform: translateX(20%) scale(0.85) rotate(7.5deg);
    z-index: 2;
    opacity: 0.85;
  }
  .stack-card[data-pos="4"] {
    transform: translateX(25%) scale(0.8) rotate(10deg);
    z-index: 1;
    opacity: 0;
  }

  /* ---- 11. Accordion card ---- */
  .acc-item {
    flex: 1;
    min-width: 0;
    cursor: pointer;
    transition: flex 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .acc-item.is-active {
    flex: 3.2;
  }
  @media (hover: hover) {
    .acc-row:hover .acc-item.is-active:not(:hover) {
      flex: 1;
    }
    .acc-item:hover {
      flex: 3.2;
    }
  }
  .acc-detail {
    opacity: 0;
    transition: opacity 0.3s ease 0.15s;
  }
  .acc-item.is-active .acc-detail {
    opacity: 1;
  }
  @media (hover: hover) {
    .acc-row:hover .acc-item.is-active:not(:hover) .acc-detail {
      opacity: 0;
    }
    .acc-item:hover .acc-detail {
      opacity: 1;
    }
  }

  /* ---- 12. Polaroid card ---- */
  .pola-card {
    position: relative;
    transform: rotate(var(--rot, 0deg));
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .pola-card:nth-child(3n + 1) {
    --rot: -2.5deg;
  }
  .pola-card:nth-child(3n + 2) {
    --rot: 1.8deg;
  }
  .pola-card:nth-child(3n) {
    --rot: -1deg;
  }
  .pola-card::before {
    content: "";
    position: absolute;
    top: -10px;
    left: 50%;
    width: 72px;
    height: 22px;
    transform: translateX(-50%) rotate(-2deg);
    background: rgba(222, 202, 140, 0.55);
    box-shadow: inset 0 0 4px rgba(0, 0, 0, 0.08);
  }
  .pola-card:hover {
    transform: rotate(0deg) scale(1.04);
    box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.35);
    z-index: 1;
  }

  /* ---- 13. Glitch card ---- */
  .glitch-layer,
  .glitch-scan {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }
  .glitch-layer {
    background-image: var(--img);
    background-size: cover;
    background-position: center;
    mix-blend-mode: screen;
  }
  .glitch-r {
    /* red channel ghost */
    filter: sepia(1) saturate(6) hue-rotate(-50deg);
  }
  .glitch-c {
    /* cyan channel ghost */
    filter: sepia(1) saturate(6) hue-rotate(160deg);
  }
  .glitch-scan {
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.25) 0 1px,
      transparent 1px 3px
    );
  }
  .glitch-card:hover .glitch-scan,
  .glitch-card:focus .glitch-scan {
    opacity: 1;
  }
  .glitch-card:hover .glitch-r,
  .glitch-card:focus .glitch-r {
    opacity: 0.5;
    animation: glitch-shift-r 0.5s steps(2) infinite;
  }
  .glitch-card:hover .glitch-c,
  .glitch-card:focus .glitch-c {
    opacity: 0.5;
    animation: glitch-shift-c 0.5s steps(2) infinite reverse;
  }
  @keyframes glitch-shift-r {
    0% {
      transform: translate(-4px, 0);
      clip-path: inset(12% 0 58% 0);
    }
    50% {
      transform: translate(3px, 2px);
      clip-path: inset(52% 0 8% 0);
    }
    100% {
      transform: translate(-2px, -1px);
      clip-path: inset(30% 0 35% 0);
    }
  }
  @keyframes glitch-shift-c {
    0% {
      transform: translate(4px, 1px);
      clip-path: inset(55% 0 10% 0);
    }
    50% {
      transform: translate(-3px, -2px);
      clip-path: inset(8% 0 62% 0);
    }
    100% {
      transform: translate(2px, 2px);
      clip-path: inset(38% 0 28% 0);
    }
  }

  /* ---- 14. Stamp card ---- */
  .stamp-card {
    /* Perforated edge: punch a dot grid, then re-fill the content box. */
    --hole: 5px;
    padding: calc(var(--hole) * 1.6);
    -webkit-mask: radial-gradient(circle var(--hole), transparent 98%, #000)
        round calc(var(--hole) * -1) calc(var(--hole) * -1) / calc(var(--hole) * 4) calc(var(--hole) * 4),
      linear-gradient(#000 0 0) content-box;
    mask: radial-gradient(circle var(--hole), transparent 98%, #000)
        round calc(var(--hole) * -1) calc(var(--hole) * -1) / calc(var(--hole) * 4) calc(var(--hole) * 4),
      linear-gradient(#000 0 0) content-box;
  }

  /* ---- 15. Editorial card ---- */
  .edi-card {
    transition: border-color 0.25s ease;
  }
  .edi-card:hover {
    border-color: oklch(70% 0.15 250 / 0.7);
  }
  .edi-card:hover .edi-num {
    color: oklch(70% 0.15 250 / 0.55);
  }
  .edi-num {
    transition: color 0.25s ease;
  }

  /* ---- 16. Ken Burns card ---- */
  .kb-img {
    animation: kb-zoom 18s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes kb-zoom {
    from {
      transform: scale(1) translate(0, 0);
    }
    to {
      transform: scale(1.15) translate(2%, -2%);
    }
  }

  /* ---- 17. Slide reveal card ---- */
  .rev-panel {
    /* Keep only the title bar visible; slide the whole panel up on hover. */
    --peek: 3rem;
    background: linear-gradient(rgba(10, 14, 20, 0.55), rgba(10, 14, 20, 0.92));
    transform: translateY(calc(100% - var(--peek)));
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .rev-head {
    min-height: var(--peek);
    align-content: center;
  }
  .rev-card:hover .rev-panel,
  .rev-card:focus .rev-panel,
  .rev-card:focus-within .rev-panel {
    transform: translateY(0);
  }

  /* ---- 18. Color blend card ---- */
  .blend-media::after {
    content: "";
    position: absolute;
    inset: 0;
    mix-blend-mode: color;
    opacity: 1;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }
  .blend-card:nth-child(3n + 1) .blend-media::after {
    background: linear-gradient(135deg, oklch(65% 0.19 45), oklch(50% 0.17 320));
  }
  .blend-card:nth-child(3n + 2) .blend-media::after {
    background: linear-gradient(135deg, oklch(62% 0.15 210), oklch(55% 0.16 280));
  }
  .blend-card:nth-child(3n) .blend-media::after {
    background: linear-gradient(135deg, oklch(68% 0.16 140), oklch(58% 0.14 90));
  }
  .blend-card:hover .blend-media::after,
  .blend-card:focus .blend-media::after {
    opacity: 0;
  }

  /* ---- 19. Text clip card ---- */
  .clip-text {
    background-image: var(--img);
    background-size: cover;
    background-position: center 25%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 900;
    font-size: clamp(3.5rem, 10vw, 5.5rem);
    letter-spacing: 0.06em;
    transition: background-position 0.6s ease;
  }
  .clip-card:hover .clip-text {
    background-position: center 45%;
  }

  /* ---- 20. Cinema slideshow ---- */
  .cine-slide {
    opacity: 0;
    transition: opacity 0.9s ease;
    pointer-events: none;
  }
  .cine-slide.is-active {
    opacity: 1;
    pointer-events: auto;
  }
  .cine-slide.is-active .cine-img {
    animation: kb-zoom 9s ease-in-out infinite alternate;
  }
  /* Vary the pan direction per slide so each cut feels different. */
  .cine-slide:nth-child(2).is-active .cine-img {
    animation-name: kb-zoom-left;
  }
  .cine-slide:nth-child(3).is-active .cine-img {
    animation-name: kb-zoom-up;
  }
  @keyframes kb-zoom-left {
    from {
      transform: scale(1.15) translate(2%, 0);
    }
    to {
      transform: scale(1) translate(0, 0);
    }
  }
  @keyframes kb-zoom-up {
    from {
      transform: scale(1.05) translate(0, 2%);
    }
    to {
      transform: scale(1.18) translate(-1%, -2%);
    }
  }
  .cine-dot {
    background: transparent;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.25s ease, transform 0.25s ease;
  }
  .cine-dot.is-active {
    background: #fff;
    transform: scale(1.2);
  }

  /* ---- 21. Scroll parallax ---- */
  .para-img {
    height: 145%;
    top: -22%;
  }
  @supports (animation-timeline: view()) {
    .para-img {
      animation: para-shift linear both;
      animation-timeline: view();
    }
    @keyframes para-shift {
      from {
        transform: translateY(-6%);
      }
      to {
        transform: translateY(6%);
      }
    }
  }

  /* ---- 22. Zoom reveal ---- */
  .zoom-img {
    transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .zoom-scrim {
    opacity: 0.75;
    transition: opacity 0.5s ease;
  }
  .zoom-body {
    transform: translateY(calc(100% - 4.5rem));
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .zoom-intro {
    opacity: 0;
    transition: opacity 0.4s ease 0.15s;
  }
  .zoom-card:hover .zoom-img,
  .zoom-card:focus .zoom-img {
    transform: scale(1.09);
  }
  .zoom-card:hover .zoom-scrim,
  .zoom-card:focus .zoom-scrim {
    opacity: 1;
  }
  .zoom-card:hover .zoom-body,
  .zoom-card:focus .zoom-body {
    transform: translateY(0);
  }
  .zoom-card:hover .zoom-intro,
  .zoom-card:focus .zoom-intro {
    opacity: 1;
  }

  /* ---- 23. Letterbox ---- */
  .letter-bar {
    position: absolute;
    left: 0;
    right: 0;
    height: 11%;
    background: #000;
    transition: height 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
    z-index: 1;
  }
  .letter-bar-top {
    top: 0;
  }
  .letter-bar-bottom {
    bottom: 0;
  }
  .letter-sub {
    z-index: 2;
    transition: bottom 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .letter-line-2 {
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .letter-card:hover .letter-bar,
  .letter-card:focus .letter-bar {
    height: 4%;
  }
  .letter-card:hover .letter-sub,
  .letter-card:focus .letter-sub {
    bottom: 7%;
  }
  .letter-card:hover .letter-line-2,
  .letter-card:focus .letter-line-2 {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .beam-card::before,
    .kb-img,
    .cine-slide.is-active .cine-img,
    .para-img {
      animation: none;
    }
    .rev-panel,
    .clip-text,
    .zoom-img,
    .zoom-body,
    .letter-bar,
    .letter-sub {
      transition: none;
    }
    .glitch-card:hover .glitch-r,
    .glitch-card:hover .glitch-c,
    .glitch-card:focus .glitch-r,
    .glitch-card:focus .glitch-c {
      animation: none;
    }
    .flip-inner,
    .stack-card,
    .tilt-card,
    .acc-item,
    .pola-card,
    .duo-card img {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector("[data-codex-gallery]");
  if (root) {
    // Tap-to-flip for touch devices (hover also works on desktop).
    root.querySelectorAll(".flip-card").forEach((card) => {
      card.addEventListener("click", () => card.classList.toggle("is-flipped"));
    });

    // Track pointer for the spotlight gradient.
    root.querySelectorAll<HTMLElement>(".spot-card").forEach((card) => {
      card.addEventListener("pointermove", (event: PointerEvent) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--spot-x", `${event.clientX - rect.left}px`);
        card.style.setProperty("--spot-y", `${event.clientY - rect.top}px`);
      });
    });

    // 3D tilt follows the pointer; reset on leave.
    root.querySelectorAll<HTMLElement>(".tilt-card").forEach((card) => {
      card.addEventListener("pointermove", (event: PointerEvent) => {
        const rect = card.getBoundingClientRect();
        const px = (event.clientX - rect.left) / rect.width;
        const py = (event.clientY - rect.top) / rect.height;
        card.style.setProperty("--tilt-y", `${(px - 0.5) * 16}deg`);
        card.style.setProperty("--tilt-x", `${(0.5 - py) * 12}deg`);
        card.style.setProperty("--glare-x", `${px * 100}%`);
        card.style.setProperty("--glare-y", `${py * 100}%`);
        card.style.setProperty("--glare-o", "1");
      });
      card.addEventListener("pointerleave", () => {
        card.style.setProperty("--tilt-x", "0deg");
        card.style.setProperty("--tilt-y", "0deg");
        card.style.setProperty("--glare-o", "0");
      });
    });

    // Accordion: tap/click marks a panel active (hover also works on desktop).
    const accItems = Array.from(root.querySelectorAll<HTMLElement>(".acc-item"));
    accItems.forEach((item) => {
      item.addEventListener("click", () => {
        accItems.forEach((other) => other.classList.toggle("is-active", other === item));
      });
    });

    // Cinema slideshow: auto-advance with crossfade; dots jump, hover pauses.
    const cine = root.querySelector<HTMLElement>("[data-cine]");
    if (cine) {
      const slides = Array.from(cine.querySelectorAll<HTMLElement>(".cine-slide"));
      const dots = Array.from(cine.querySelectorAll<HTMLElement>(".cine-dot"));
      let index = 0;
      let timer = 0;
      const show = (next: number) => {
        index = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle("is-active", i === index));
        dots.forEach((dot, i) => dot.classList.toggle("is-active", i === index));
      };
      const play = () => {
        timer = window.setInterval(() => show(index + 1), 4200);
      };
      dots.forEach((dot, i) => dot.addEventListener("click", () => show(i)));
      cine.addEventListener("pointerenter", () => window.clearInterval(timer));
      cine.addEventListener("pointerleave", play);
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) play();
    }

    // Card stack: clicking sends the top card to the back.
    const stack = root.querySelector<HTMLElement>(".stack-wrap");
    if (stack) {
      const cards = Array.from(stack.querySelectorAll<HTMLElement>(".stack-card"));
      stack.addEventListener("click", () => {
        cards.forEach((card) => {
          const pos = Number(card.dataset.pos);
          card.dataset.pos = String((pos + cards.length - 1) % cards.length);
        });
      });
    }
  }
</script>
