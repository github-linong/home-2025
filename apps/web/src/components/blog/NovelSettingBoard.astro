---
import DisasterTimelineChart from "./DisasterTimelineChart.astro";
import SpeciesCooperationTimeline from "./SpeciesCooperationTimeline.astro";
import CropTimeline from "./CropTimeline.astro";
import QiangYiRelationGraph from "./QiangYiRelationGraph.astro";
import SocietyFactionGraph from "./SocietyFactionGraph.astro";
import SocietyGeoMap from "./SocietyGeoMap.astro";
import { DISASTER_TIMELINE_EVENTS } from "../../lib/disasterTimeline.js";
import {
  SPECIES_FACTION_CARDS,
  SPECIES_SYMBIOSIS_DOCTRINE,
  SPECIES_SYMBIOSIS_PRINCIPLES,
  SPECIES_SYMBIOSIS_THESIS,
} from "../../lib/speciesCooperation.js";
import { CROP_KIND_CARDS } from "../../lib/cropTimeline.js";
import {
  SOCIETY_ALLIANCE_LORDS,
  SOCIETY_FACTION_ROWS,
  SOCIETY_BASE_ROWS,
  SOCIETY_CAMP_NOTE,
  SOCIETY_FOREST_CARDS,
  SOCIETY_REGION_CARDS,
  SOCIETY_SPACE_CARDS,
  SOCIETY_TEAM_ROWS,
} from "../../lib/societyFactions.js";
import {
  SOCIETY_MOUNTAIN_ROWS,
  SOCIETY_PACK_ROWS,
  SOCIETY_TERRITORY_ADJACENCY,
  SOCIETY_TERRITORY_OUTPOST_NOTE,
  SOCIETY_TERRITORY_ROWS,
  SOCIETY_XIAQING_FRONTS,
  SOCIETY_XIAQING_LAYOUT_DIAGRAM,
  SOCIETY_XIAQING_LAYOUT_NOTE,
} from "../../lib/societyMap.js";
import {
  EVOLUTION_BODY_TRACKS,
  EVOLUTION_BRAIN_FUNCS,
  EVOLUTION_DANGER_TIERS,
  EVOLUTION_DIMENSION_CARDS,
  EVOLUTION_MULTI_SYSTEM,
  EVOLUTION_ORGAN_TRACKS,
  EVOLUTION_RULE_ROWS,
  EVOLUTION_SENSE_TRACKS,
  EVOLUTION_SPECIAL_TRACKS,
  EVOLUTION_XIAQING_LINE,
} from "../../lib/evolutionSystem.js";
import {
  QIANG_YI_CONTENT_GRADES,
  QIANG_YI_CORE,
  QIANG_YI_PROP_ROWS,
  QIANG_YI_SYNTH_ROWS,
} from "../../lib/qiangYiCatalog.js";
import {
  ANIMAL_CHARACTER_PROFILES,
  HUMAN_CHARACTER_PROFILES,
} from "../../lib/novelCharacters.js";
import { RESEARCH_NODES, RESEARCH_OUTPUT_ROWS } from "../../lib/researchNodes.js";
---

<div class="not-prose novel-setting-board" data-setting-board>
  <div class="space-y-8">
    {/* 概览 */}
    <section id="overview" class="scroll-mt-44 lg:scroll-mt-28 space-y-3" data-section="overview">
      <h2 class="text-xl font-bold m-0">概览</h2>
      <dl class="flex flex-wrap items-center gap-y-1.5 text-sm m-0 border-b border-base-300 pb-3">
        {
          [
            ["作者", "南极蓝"],
            ["平台", "起点中文网"],
            ["时间", "天灾第十年"],
            ["类型", "科幻 / 末世"],
            ["感情线", "有男主·戏份少"],
          ].map(([label, value], index) => (
            <>
              {index > 0 && (
                <span class="mx-2 text-base-content/25 select-none" aria-hidden="true">
                  |
                </span>
              )}
              <div class="flex items-baseline gap-1.5 m-0">
                <dt class="text-base-content/45 m-0 shrink-0">{label}</dt>
                <dd class="font-medium m-0">{value}</dd>
              </div>
            </>
          ))
        }
      </dl>

      <p class="text-sm leading-relaxed m-0 text-base-content/80">
        <span class="font-semibold text-base-content">一句话：</span>
        灾后第十年，力量型进化者夏青离开安全区认领三号领地，以科学种田为基，与进化动物共生协作。
        主线偏种田、基建与科研日常；战斗不是唯一爽点。
      </p>

      <p class="text-sm leading-relaxed m-0 text-base-content/75">
        <span class="font-semibold text-base-content">夏青：</span>
        三号领地领主。对外曾报四级力量型；实际早期力量 / 视觉 / 听觉三系隐藏，后确认磁觉成为四系（脑域若激发可问鼎五系）。狙击 + 领地管理并重。
      </p>

      <p class="text-xs text-base-content/45 m-0">
        据公开百科与简介整理，细节以原文为准。
      </p>
    </section>

    {/* 人物与动物图鉴 */}
    <section id="characters" class="scroll-mt-44 lg:scroll-mt-28 space-y-5" data-section="characters">
      <div>
        <h2 class="text-xl font-bold m-0 mb-2">人物与动物图鉴</h2>
        <p class="text-sm text-base-content/60 m-0 leading-relaxed">
          先认角色，再读势力与时间线。介绍只保留身份、关系和剧情功能；动物按平等协作伙伴书写，不使用宠物式定位。
          配图为依据书中外貌描写生成的 AI 插画，仅作辅助想象，非官方立绘。
        </p>
      </div>

      <div>
        <h3 class="font-semibold text-base m-0 mb-3">主要人物</h3>
        <div class="grid gap-3 md:grid-cols-2">
          {
            HUMAN_CHARACTER_PROFILES.map((person) => (
              <article class="board-card rounded-xl border border-base-300 bg-base-100">
                <div class="flex items-start gap-3 mb-2">
                  <img
                    src={person.image}
                    alt={`${person.name} AI 插画`}
                    width="640"
                    height="640"
                    loading="lazy"
                    decoding="async"
                    class="w-20 h-20 sm:w-24 sm:h-24 rounded-lg object-cover shrink-0 border border-base-300"
                  />
                  <div class="min-w-0 grow">
                    <div class="flex flex-wrap items-start justify-between gap-2">
                      <h4 class="font-semibold text-base m-0">
                        {person.name}
                        {person.aliases && (
                          <span class="ml-1.5 text-xs font-normal text-base-content/45">
                            · {person.aliases}
                          </span>
                        )}
                      </h4>
                      <span class="badge badge-outline badge-sm shrink-0">{person.group}</span>
                    </div>
                    <p class="text-xs text-base-content/50 m-0 mt-1">{person.role}</p>
                    <div class="flex flex-wrap gap-1.5 mt-2">
                      {person.tags.map((tag) => <span class="badge badge-ghost badge-sm">{tag}</span>)}
                    </div>
                  </div>
                </div>
                <p class="text-sm text-base-content/75 m-0 leading-relaxed">{person.intro}</p>
              </article>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-base m-0 mb-3">进化动物</h3>
        <div class="grid gap-3 md:grid-cols-2">
          {
            ANIMAL_CHARACTER_PROFILES.map((animal) => (
              <article class="board-card rounded-xl border border-success/25 bg-success/5">
                <div class="flex items-start gap-3 mb-2">
                  <img
                    src={animal.image}
                    alt={`${animal.name} AI 插画`}
                    width="640"
                    height="640"
                    loading="lazy"
                    decoding="async"
                    class="w-20 h-20 sm:w-24 sm:h-24 rounded-lg object-cover shrink-0 border border-success/25"
                  />
                  <div class="min-w-0 grow">
                    <div class="flex flex-wrap items-start justify-between gap-2">
                      <h4 class="font-semibold text-base m-0">
                        {animal.name}
                        {animal.aliases && (
                          <span class="ml-1.5 text-xs font-normal text-base-content/45">
                            · {animal.aliases}
                          </span>
                        )}
                      </h4>
                      <span class="badge badge-success badge-outline badge-sm shrink-0">{animal.group}</span>
                    </div>
                    <p class="text-xs text-base-content/50 m-0 mt-1">{animal.role}</p>
                    <div class="flex flex-wrap gap-1.5 mt-2">
                      {animal.tags.map((tag) => <span class="badge badge-ghost badge-sm">{tag}</span>)}
                    </div>
                  </div>
                </div>
                <p class="text-sm text-base-content/75 m-0 leading-relaxed">{animal.intro}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* 天灾时间线 */}
    <section id="disaster" class="scroll-mt-44 lg:scroll-mt-28 space-y-4" data-section="disaster">
      <div>
        <h2 class="text-xl font-bold m-0 mb-2">天灾时间线</h2>
        <p class="text-sm text-base-content/60 m-0 leading-relaxed">
          全蓝星人普遍将核污染水排海视为天灾起点。公开设定里，灾变层层叠加上来；开篇后按领地建设阶段推进。
          农作物线见「种田与科技」，族群合作线见「跨物种关系」。开篇后节点以章节阶段示意，并非精确日历年表。
        </p>
      </div>
      <DisasterTimelineChart />
      <details class="rounded-xl border border-base-300 bg-base-100 open:shadow-sm" data-timeline-table>
        <summary class="cursor-pointer select-none px-4 py-2.5 text-sm font-medium text-base-content/75">
          完整对照表（可展开）
        </summary>
        <div class="overflow-x-auto border-t border-base-300 board-table-wrap">
          <table class="board-table w-full text-sm">
            <thead>
              <tr>
                <th>阶段</th>
                <th>事件</th>
                <th>影响</th>
              </tr>
            </thead>
            <tbody>
              {
                DISASTER_TIMELINE_EVENTS.map((item) => (
                  <tr data-era={item.era}>
                    <td>{item.stage}</td>
                    <td>{item.event}</td>
                    <td>{item.impact}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </details>
    </section>

    {/* 戕与颐 */}
    <section id="elements" class="scroll-mt-44 lg:scroll-mt-28 space-y-4" data-section="elements">
      <div>
        <h2 class="text-xl font-bold m-0 mb-2">戕与颐</h2>
        <p class="text-sm text-base-content/60 m-0 leading-relaxed">
          华国科学家命名的两种神秘元素：对立统一、维持生态。除浓度与灯色外，后文还出现颐6、颐7一类具特殊功效的合成 / 提取组分，以及按颐含量分档的营养液体系。
        </p>
      </div>
      <div>
        <h3 class="font-semibold text-base m-0 mb-3">关系图</h3>
        <QiangYiRelationGraph />
      </div>
      <div class="grid gap-3 md:grid-cols-3">
        {
          QIANG_YI_CORE.map((row) => (
            <article class="board-card rounded-xl border border-base-300 bg-base-100">
              <h3 class="font-semibold m-0 mb-2">{row.name}</h3>
              <p class="text-sm m-0 leading-relaxed text-base-content/75">{row.note}</p>
            </article>
          ))
        }
      </div>

      <div>
        <h3 class="font-semibold text-base m-0 mb-3">含量分档 · 营养液</h3>
        <div class="overflow-x-auto rounded-xl border border-base-300 board-table-wrap">
          <table class="board-table w-full text-sm">
            <thead>
              <tr>
                <th>档位</th>
                <th>含量门槛</th>
                <th>功效</th>
              </tr>
            </thead>
            <tbody>
              {
                QIANG_YI_CONTENT_GRADES.map((row) => (
                  <tr>
                    <td>{row.name}</td>
                    <td>{row.range}</td>
                    <td>{row.effect}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-base m-0 mb-3">颐 N / 戕 N 特殊组分</h3>
        <p class="text-sm text-base-content/60 m-0 mb-3 leading-relaxed">
          数字编号的合成元素与单纯「颐含量 = N」不同：颐6、颐7是具名有效组分，功效专一，常自高颐生物提取。
        </p>
        <div class="overflow-x-auto rounded-xl border border-base-300 board-table-wrap">
          <table class="board-table w-full text-sm">
            <thead>
              <tr>
                <th>名称</th>
                <th>来源 / 定位</th>
                <th>特殊功效</th>
              </tr>
            </thead>
            <tbody>
              {
                QIANG_YI_SYNTH_ROWS.map((row) => (
                  <tr>
                    <td>{row.name}</td>
                    <td>{row.range}</td>
                    <td>{row.effect}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-base m-0 mb-3">衍生现象与道具</h3>
        <div class="overflow-x-auto rounded-xl border border-base-300 board-table-wrap">
          <table class="board-table w-full text-sm">
            <thead>
              <tr>
                <th>名称</th>
                <th>说明</th>
              </tr>
            </thead>
            <tbody>
              {
                QIANG_YI_PROP_ROWS.map((row) => (
                  <tr>
                    <td>{row.name}</td>
                    <td>{row.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="text-xs text-base-content/45 m-0 mt-2">
          注：元素浓度与山川水系绑定；颐石有效半径、刺激液副作用与泉水暴露风险，都会改写领地与势力博弈。
        </p>
      </div>
    </section>

    {/* 社会与空间 */}
    <section id="society" class="scroll-mt-44 lg:scroll-mt-28 space-y-4" data-section="society">
      <div>
        <h2 class="text-xl font-bold m-0 mb-2">社会与空间</h2>
        <p class="text-sm text-base-content/60 m-0 leading-relaxed">
          华国现存基地分属红 / 兰 / 晖 / 白 / 桂等大区。晖三是主舞台，但晖一、晖二、白一、红一、兰五等通过地理通路、科研申请、抢肥与暗网持续交叉。
        </p>
      </div>

      <div>
        <h3 class="font-semibold text-base m-0 mb-3">五大区</h3>
        <div class="grid gap-3 md:grid-cols-2 xl:grid-cols-3">
          {
            SOCIETY_REGION_CARDS.map((card) => (
              <article class="board-card rounded-xl border border-base-300 bg-base-100">
                <h3 class="font-semibold m-0 mb-2">{card.title}</h3>
                <p class="text-sm m-0 mb-2 leading-relaxed">{card.summary}</p>
                <p class="text-sm text-base-content/55 m-0 leading-relaxed">{card.detail}</p>
              </article>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-base m-0 mb-3">具名基地速览</h3>
        <div class="overflow-x-auto rounded-xl border border-base-300 board-table-wrap">
          <table class="board-table w-full text-sm">
            <thead>
              <tr>
                <th>基地</th>
                <th>大区</th>
                <th>与晖三线关系</th>
              </tr>
            </thead>
            <tbody>
              {
                SOCIETY_BASE_ROWS.map((row) => (
                  <tr>
                    <td>{row.name}</td>
                    <td>{row.group}</td>
                    <td>{row.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-base m-0 mb-3">进化林地理</h3>
        <p class="text-sm text-base-content/60 m-0 mb-3 leading-relaxed">
          晖三周缘进化林按山脊 / 湖泊排序编号；几几号山是一片相连山峰，不是单峰名。烈火山在晖一安区外，是烈火盘据点。
        </p>
        <div class="overflow-x-auto rounded-xl border border-base-300 board-table-wrap mb-3">
          <table class="board-table w-full text-sm">
            <thead>
              <tr>
                <th>编号</th>
                <th>定位</th>
                <th>备注</th>
              </tr>
            </thead>
            <tbody>
              {
                SOCIETY_MOUNTAIN_ROWS.map((row) => (
                  <tr>
                    <td>{row.code}</td>
                    <td>{row.name}</td>
                    <td>{row.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div class="grid gap-3 md:grid-cols-2">
          {
            SOCIETY_FOREST_CARDS.map((card) => (
              <article class="board-card rounded-xl border border-base-300 bg-base-100">
                <h3 class="font-semibold m-0 mb-2">{card.title}</h3>
                <p class="text-sm m-0 mb-2 leading-relaxed">{card.summary}</p>
                <p class="text-sm text-base-content/55 m-0 leading-relaxed">{card.detail}</p>
              </article>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-base m-0 mb-3">基地下属战队</h3>
        <p class="text-sm text-base-content/60 m-0 mb-3 leading-relaxed">
          大区冲突经常落到「基地对立、战队可合作」：寒霜可与青龙互通情报，烈火则盘踞烈火山直接施压北部一区。
        </p>
        <div class="overflow-x-auto rounded-xl border border-base-300 board-table-wrap">
          <table class="board-table w-full text-sm">
            <thead>
              <tr>
                <th>战队</th>
                <th>挂属</th>
                <th>姿态</th>
                <th>备注</th>
              </tr>
            </thead>
            <tbody>
              {
                SOCIETY_TEAM_ROWS.map((row) => (
                  <tr>
                    <td>{row.name}</td>
                    <td>{row.base}</td>
                    <td>{row.stance}</td>
                    <td>{row.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-base m-0 mb-3">晖三本地空间</h3>
        <div class="grid gap-3 md:grid-cols-2">
          {
            SOCIETY_SPACE_CARDS.map((card) => (
              <article class="board-card rounded-xl border border-base-300 bg-base-100">
                <h3 class="font-semibold m-0 mb-2">{card.title}</h3>
                <p class="text-sm m-0 mb-2 leading-relaxed">{card.summary}</p>
                <p class="text-sm text-base-content/55 m-0 leading-relaxed">{card.detail}</p>
              </article>
            ))
          }
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-base m-0 mb-3">华国基地地理示意</h3>
        <p class="text-sm text-base-content/60 m-0 mb-3 leading-relaxed">
          上北下南，按相对直距排：贴林主轴六十一→六十→五十二→五十五→四十九→五十→五十一；二十二号山与南部狼群在更南约数百里处。
          下方地图：SVG / ECharts / AntV G6 / Leaflet。行政区「贴边相邻」见 Leaflet → 区划相邻（层级 Voronoi；「完整拼图」可铺满全国）。
        </p>
        <SocietyGeoMap />
        <div class="mt-3 overflow-x-auto rounded-xl border border-base-300 board-table-wrap">
          <table class="board-table w-full text-sm">
            <thead>
              <tr>
                <th>族群 / 支系</th>
                <th>方位要点</th>
                <th>备注</th>
              </tr>
            </thead>
            <tbody>
              {
                SOCIETY_PACK_ROWS.map((row) => (
                  <tr>
                    <td>{row.code}</td>
                    <td>{row.name}</td>
                    <td>{row.note}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-base m-0 mb-3">势力与基地关系图</h3>
        <SocietyFactionGraph />
      </div>

      <div>
        <h3 class="font-semibold text-base m-0 mb-3">主要势力概览</h3>
        <p class="text-sm text-base-content/60 m-0 mb-3 leading-relaxed">
          {SOCIETY_CAMP_NOTE}
        </p>
        <div class="overflow-x-auto rounded-xl border border-base-300 board-table-wrap">
          <table class="board-table w-full text-sm">
            <thead>
              <tr>
                <th>分类</th>
                <th>阵营色</th>
                <th>势力</th>
                <th>职能 / 定位</th>
                <th>与主角线关系</th>
              </tr>
            </thead>
            <tbody>
              {
                SOCIETY_FACTION_ROWS.map((row) => (
                  <tr>
                    <td>{row.group}</td>
                    <td>{row.camp}</td>
                    <td>{row.name}</td>
                    <td>{row.role}</td>
                    <td>{row.stance}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>

      <div class="board-card rounded-xl border border-base-300 bg-base-200/50 text-sm leading-relaxed">
        <p class="font-semibold m-0 mb-1">通讯设定</p>
        <p class="m-0 text-base-content/75">
          天灾冲垮现代化通讯后，长期依赖简易电台。晖三基地内部分恢复手机通讯与短信；区外信号塔未复，领地内常无信号。领主频道、对讲机与联盟群是区外协作的关键通道。
        </p>
      </div>
    </section>

    {/* 进化体系 */}
    <section id="evolution" class="scroll-mt-44 lg:scroll-mt-28 space-y-4" data-section="evolution">
      <div>
        <h2 class="text-xl font-bold m-0 mb-2">进化体系</h2>
        <p class="text-sm text-base-content/60 m-0 leading-relaxed">
