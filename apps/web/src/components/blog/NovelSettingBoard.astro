        <h3 class="font-semibold m-0 mb-2">理念侧写</h3>
        <p class="text-sm text-base-content/75 m-0 leading-relaxed">
          主线情感并非浪漫霸权，而是「以地为本」：从食物链顶端征服者，转向生态协作者。
          跨物种协议、领地联盟与有机农场扩张，把「信任、平等分工、科研可验证、谨慎保护」写成可复制的制度。
        </p>
      </article>
    </section>
  </div>
</div>

<style>
  .novel-setting-board {
    --board-pad-x: 1rem;
    --board-pad-y: 0.875rem;
  }

  .novel-setting-board :global(.board-card) {
    padding: var(--board-pad-y) var(--board-pad-x);
  }

  .novel-setting-board :global(.board-list) {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.375rem;
  }

  .novel-setting-board :global(.board-table) {
    border-collapse: collapse;
    margin: 0;
  }

  .novel-setting-board :global(.board-table th),
  .novel-setting-board :global(.board-table td) {
    padding: 0.55rem var(--board-pad-x);
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid color-mix(in oklab, currentColor 12%, transparent);
    line-height: 1.45;
  }

  .novel-setting-board :global(.board-table th) {
    font-weight: 600;
    background: color-mix(in oklab, currentColor 6%, transparent);
    white-space: nowrap;
  }

  .novel-setting-board :global(.board-table tbody tr:nth-child(even) td) {
    background: color-mix(in oklab, currentColor 4%, transparent);
  }

  .novel-setting-board :global(.board-table tr:last-child td) {
    border-bottom: none;
  }

  .novel-setting-board :global(h2),
  .novel-setting-board :global(h3) {
    margin-top: 0;
  }
</style>

<script>
  function syncTimelineTable(era) {
    document.querySelectorAll("[data-timeline-table] tbody tr[data-era]").forEach((row) => {
      if (!(row instanceof HTMLElement)) return;
      const show = era === "all" || row.dataset.era === era;
      row.hidden = !show;
    });
  }

  function bindTimelineTable() {
    const section = document.getElementById("disaster");
    if (!section || section.dataset.timelineTableBound === "true") return;
    section.dataset.timelineTableBound = "true";
    section.addEventListener("timeline-era-change", (event) => {
      const era = event.detail?.era || "prelude";
      syncTimelineTable(era);
    });
    const active = section.querySelector("[data-disaster-timeline]")?.getAttribute("data-active-era");
    syncTimelineTable(active || "prelude");
  }

  document.addEventListener("astro:page-load", bindTimelineTable);
  bindTimelineTable();
</script>
