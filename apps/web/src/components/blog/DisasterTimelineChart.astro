---
/**
 * Vertical ECharts timeline with era tabs — readable one-row-per-event layout.
 */
import {
  DISASTER_TIMELINE_ERA_TABS,
  DISASTER_TIMELINE_EVENTS,
} from "../../lib/disasterTimeline.js";

const events = DISASTER_TIMELINE_EVENTS;
const tabs = DISASTER_TIMELINE_ERA_TABS;
---

<div
  class="disaster-timeline-chart rounded-xl border border-base-300 bg-base-100 overflow-hidden"
  data-disaster-timeline
  data-events={JSON.stringify(events)}
  data-active-era="prelude"
>
  <div
    class="flex flex-wrap gap-2 border-b border-base-300/80 px-3 py-2.5"
    role="tablist"
    aria-label="时间线分段"
    data-timeline-tabs
  >
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          role="tab"
          class="timeline-era-tab"
          data-era={tab.id}
          aria-selected={index === 0 ? "true" : "false"}
        >
          {tab.label}
        </button>
      ))
    }
  </div>

  <div
    class="w-full"
    data-disaster-timeline-canvas
    role="img"
    aria-label="纵向天灾与故事时间线"
  >
  </div>

  {/* Server-rendered fallback: hidden once the ECharts chart mounts. */}
  <ol class="timeline-fallback" data-timeline-fallback>
    {
      events.map((item) => (
        <li class="timeline-fallback-item" data-fallback-era={item.era}>
          <span class="timeline-fallback-stage">{item.stage}</span>
          <span class="timeline-fallback-body">
            <strong>{item.event}</strong>
            <span class="timeline-fallback-impact">{item.impact}</span>
          </span>
        </li>
      ))
    }
  </ol>

  <p class="px-3 pb-2.5 text-[0.7rem] leading-snug text-base-content/40 m-0">
    改为纵向排布，一次只看一段；悬停节点可看完整影响说明。
  </p>
</div>

<style>
  .timeline-era-tab {
    border: 1px solid color-mix(in oklab, currentColor 16%, transparent);
    border-radius: 9999px;
    background: color-mix(in oklab, currentColor 4%, transparent);
    color: color-mix(in oklab, currentColor 72%, transparent);
    font-size: 0.75rem;
    line-height: 1.25rem;
    padding: 0.2rem 0.7rem;
    cursor: pointer;
    transition:
      background-color 120ms ease,
      border-color 120ms ease,
      color 120ms ease;
  }

  .timeline-era-tab[aria-selected="true"] {
    border-color: color-mix(in oklab, currentColor 55%, transparent);
    background: color-mix(in oklab, currentColor 12%, transparent);
    color: inherit;
    font-weight: 600;
  }

  .timeline-fallback {
    list-style: none;
    margin: 0;
    padding: 0.75rem 1rem;
    display: grid;
    gap: 0.65rem;
  }

  [data-chart-ready="true"] .timeline-fallback {
    display: none;
  }

  .timeline-fallback-item {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    border-left: 2px solid color-mix(in oklab, currentColor 25%, transparent);
    padding-left: 0.75rem;
  }

  .timeline-fallback-stage {
    flex: none;
    width: 9rem;
    font-size: 0.72rem;
    color: color-mix(in oklab, currentColor 55%, transparent);
  }

  .timeline-fallback-body {
    display: grid;
    gap: 0.15rem;
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .timeline-fallback-impact {
    color: color-mix(in oklab, currentColor 60%, transparent);
    font-size: 0.74rem;
  }
</style>

<script>
  import * as echarts from "echarts/core";
  import { LineChart, ScatterChart } from "echarts/charts";
  import { GridComponent, TooltipComponent } from "echarts/components";
  import { CanvasRenderer } from "echarts/renderers";

  echarts.use([
    LineChart,
    ScatterChart,
    GridComponent,
    TooltipComponent,
    CanvasRenderer,
  ]);

  /** @type {WeakMap<Element, import('echarts/core').ECharts>} */
  const chartByRoot = new WeakMap();

  /**
   * @typedef {{ era: 'prelude' | 'story', yearLabel: string, stage: string, event: string, impact: string }} TimelineEvent
   */

  /**
   * @param {TimelineEvent[]} all
   * @param {string} era
   */
  function filterEvents(all, era) {
    if (era === "all") return all;
    return all.filter((item) => item.era === era);
  }

  /**
   * @param {HTMLElement} root
   * @param {string} era
   */
  function syncFallback(root, era) {
    root.querySelectorAll("[data-fallback-era]").forEach((item) => {
      if (!(item instanceof HTMLElement)) return;
      item.hidden = era !== "all" && item.dataset.fallbackEra !== era;
    });
  }

  /**
   * @param {TimelineEvent[]} events
   * @param {number} viewWidth
   */
  function buildOption(events, viewWidth) {
    const categories = events.map((e) => e.yearLabel);
    const labelWidth = Math.max(160, Math.min(420, viewWidth - 120));

    return {
      animationDuration: 360,
      grid: {
        left: viewWidth < 480 ? 64 : 78,
        right: 18,
        top: 10,
        bottom: 10,
        containLabel: false,
      },
      tooltip: {
        trigger: "item",
        borderWidth: 0,
        backgroundColor: "rgba(32, 36, 28, 0.92)",
        textStyle: { color: "#f4f1ea", fontSize: 12 },
        formatter(params) {
          const item = events[params.dataIndex];
          if (!item) return "";
          return [
            `<div style="font-weight:600;margin-bottom:4px">${item.stage}</div>`,
            `<div style="margin-bottom:4px">${item.event}</div>`,
            `<div style="opacity:.85;max-width:280px;line-height:1.45">${item.impact}</div>`,
          ].join("");
        },
      },
      xAxis: {
        type: "value",
        min: 0,
        max: 1,
        show: false,
      },
      yAxis: {
        type: "category",
        data: categories,
        inverse: true,
        axisTick: { show: false },
        axisLine: { show: false },
        splitLine: {
          show: true,
          lineStyle: {
            type: "dashed",
            color: "rgba(90, 100, 70, 0.1)",
          },
        },
        axisLabel: {
          color: "rgba(60, 70, 50, 0.55)",
          fontSize: 11,
          width: viewWidth < 480 ? 52 : 66,
          overflow: "truncate",
        },
      },
      series: [
        {
          type: "line",
          data: events.map((e) => [0.06, e.yearLabel]),
          symbol: "none",
          silent: true,
          lineStyle: {
            width: 2.5,
            color: "#5f6f45",
            cap: "round",
          },
          z: 1,
        },
        {
          type: "scatter",
          data: events.map((e) => [0.06, e.yearLabel]),
          symbol: "circle",
          symbolSize: 11,
          itemStyle: {
            color: "#3f4d2e",
            borderColor: "#e8eadf",
            borderWidth: 2,
          },
          emphasis: {
            scale: 1.25,
            itemStyle: { color: "#2f3a22" },
          },
          label: {
            show: true,
            position: "right",
            distance: 14,
            align: "left",
            formatter(params) {
              const item = events[params.dataIndex];
              if (!item) return "";
              return `{title|${item.event}}\n{sub|${item.impact}}`;
            },
            rich: {
              title: {
                fontSize: 13,
                fontWeight: 600,
                color: "rgba(40, 46, 34, 0.95)",
                lineHeight: 20,
                width: labelWidth,
              },
              sub: {
                fontSize: 11,
                color: "rgba(60, 70, 50, 0.58)",
                lineHeight: 17,
                width: labelWidth,
                overflow: "break",
              },
            },
          },
          z: 2,
        },
      ],
    };
  }

  /**
   * @param {HTMLElement} canvas
   * @param {number} count
   */
  function sizeCanvas(canvas, count) {
    const row = canvas.clientWidth < 480 ? 64 : 58;
    canvas.style.height = `${Math.max(280, count * row + 24)}px`;
  }

  /**
   * @param {HTMLElement} root
   * @param {number} retriesLeft
   */
  function mount(root, retriesLeft = 20) {
    const canvas = root.querySelector("[data-disaster-timeline-canvas]");
    if (!(canvas instanceof HTMLElement)) return;

    /** @type {TimelineEvent[]} */
    let all = [];
    try {
      all = JSON.parse(root.getAttribute("data-events") || "[]");
    } catch {
      all = [];
    }
    if (!all.length) return;

    const era = root.getAttribute("data-active-era") || "prelude";
    const events = filterEvents(all, era);
    if (!events.length) return;

    syncFallback(root, era);

    // During view transitions or while hidden the box measures 0 wide;
    // initializing ECharts then produces an invisible chart, so retry later.
    if (canvas.clientWidth === 0) {
      const prev = chartByRoot.get(root);
      if (prev && !prev.isDisposed()) prev.dispose();
      chartByRoot.delete(root);
      delete root.dataset.chartReady;
      if (retriesLeft > 0) {
        setTimeout(() => mount(root, retriesLeft - 1), 150);
      }
      return;
    }

    try {
      sizeCanvas(canvas, events.length);

      let chart = chartByRoot.get(root);
      if (!chart || chart.isDisposed()) {
        chart = echarts.init(canvas, undefined, { renderer: "canvas" });
        chartByRoot.set(root, chart);
      }

      chart.setOption(buildOption(events, canvas.clientWidth || 640), true);
      chart.resize();
      root.dataset.chartReady = "true";
    } catch (err) {
      // Keep the server-rendered fallback list visible if the chart fails.
      delete root.dataset.chartReady;
      canvas.style.height = "";
      console.error("disaster timeline chart failed:", err);
      return;
    }

    root.dispatchEvent(
      new CustomEvent("timeline-era-change", {
        bubbles: true,
        detail: { era },
      }),
    );
  }

  /**
   * @param {HTMLElement} root
   */
  function bindTabs(root) {
    if (root.dataset.tabsBound === "true") return;
    root.dataset.tabsBound = "true";

    root.querySelectorAll("[data-era]").forEach((btn) => {
      btn.addEventListener("click", () => {
        if (!(btn instanceof HTMLElement)) return;
        const era = btn.dataset.era || "prelude";
        root.setAttribute("data-active-era", era);
        root.querySelectorAll("[data-era]").forEach((el) => {
          el.setAttribute(
            "aria-selected",
            el === btn ? "true" : "false",
          );
        });
        mount(root);
      });
    });
  }

  function mountAll() {
    document.querySelectorAll("[data-disaster-timeline]").forEach((root) => {
      if (!(root instanceof HTMLElement)) return;
      bindTabs(root);
      mount(root);
    });
  }

  function onResize() {
    document.querySelectorAll("[data-disaster-timeline]").forEach((root) => {
      if (root instanceof HTMLElement) mount(root);
    });
  }

  document.addEventListener("astro:page-load", mountAll);
  window.addEventListener("resize", onResize);
  mountAll();
</script>
