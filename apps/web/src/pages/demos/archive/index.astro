---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import createSlug from "../../../lib/createSlug";

const allDemos = (await getCollection("demos"))
  .filter((d) => d.data.tags?.includes("legacy"))
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "zh"));

const q = Astro.url.searchParams.get("q")?.toLowerCase().trim() ?? "";
const cat = Astro.url.searchParams.get("cat")?.trim() ?? "";

const filtered = allDemos.filter((d) => {
  if (cat && d.data.category !== cat) return false;
  if (!q) return true;
  const hay = [d.data.title, d.data.description, d.slug, d.data.category, ...(d.data.tags ?? [])]
    .join(" ")
    .toLowerCase();
  return hay.includes(q);
});
---

<BaseLayout
  title="Demo 归档"
  sideBarActiveItemID="demos"
>
  <div class="not-prose">
    <a href="/demos" class="link link-hover text-sm" data-astro-reload>← 项目展示</a>
    <h1 class="text-3xl font-bold mt-2">Demo 归档</h1>
    <p class="opacity-80 mt-2 mb-4">
      共 {allDemos.length} 个历史交互示例，按名称排序。需要按标签筛选时请用
      <a href="/search/?type=demo" class="link" data-astro-reload>统一搜索</a>。
    </p>

    <form method="get" action="/search/" class="flex flex-wrap gap-2 mb-4 max-w-3xl">
      <input
        type="search"
        name="q"
        value={q}
        placeholder="搜索标题、描述、标签…"
        class="input input-bordered flex-1 min-w-[200px]"
      />
      <input type="hidden" name="type" value="demo" />
      {cat && <input type="hidden" name="tag" value={cat} />}
      <button type="submit" class="btn btn-primary">去搜索</button>
      <a href="/search/?type=demo" class="btn btn-outline">标签筛选</a>
      {(q || cat) && <a href="/demos/archive/" class="btn btn-ghost">清除</a>}
    </form>

    <p class="text-sm opacity-70 mb-4">
      {q || cat ? `匹配 ${filtered.length} / ${allDemos.length}` : "按名称排序"}
    </p>

    <div class="overflow-x-auto">
      <table class="table table-sm table-zebra">
        <thead>
          <tr>
            <th>#</th>
            <th>项目</th>
            <th>分类</th>
            <th>文章</th>
          </tr>
        </thead>
        <tbody>
          {
            filtered.map((demo, i) => {
              const url = "/demos/" + createSlug(demo.data.title, demo.slug);
              const posts = demo.data.relatedPosts?.length ?? 0;
              return (
                <tr>
                  <td class="opacity-50">{i + 1}</td>
                  <td class="max-w-lg">
                    <a class="link link-hover font-medium" href={url}>
                      {demo.data.title}
                    </a>
                    <div class="text-xs opacity-60 truncate mt-0.5">{demo.data.description}</div>
                  </td>
                  <td class="whitespace-nowrap text-xs">
                    {demo.data.category && (
                      <span class="badge badge-outline badge-sm">{demo.data.category}</span>
                    )}
                  </td>
                  <td class="text-xs opacity-70">{posts > 0 ? `${posts} 篇` : "—"}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</BaseLayout>
