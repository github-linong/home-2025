---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug";
import { CURATED_DEMO_SLUGS } from "../../data/curated-demos";

export async function getStaticPaths({ paginate }) {
  const allDemos = await getCollection("demos");
  const bySlug = new Map(allDemos.map((d) => [d.slug, d]));

  const isLegacy = (d: (typeof allDemos)[0]) => d.data.tags?.includes("legacy");
  const isProject = (d: (typeof allDemos)[0]) => d.data.tags?.includes("project");

  const featured = allDemos
    .filter((d) => !isLegacy(d) && !isProject(d))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const blogLinked = allDemos.filter(
    (d) => isLegacy(d) && (d.data.relatedPosts?.length ?? 0) > 0,
  );

  const curated = [...CURATED_DEMO_SLUGS]
    .map((slug) => bySlug.get(slug))
    .filter((d): d is NonNullable<typeof d> => !!d);

  const seen = new Set<string>();
  const highlights: (typeof allDemos)[0][] = [];
  for (const demo of [...featured, ...curated, ...blogLinked]) {
    if (seen.has(demo.slug)) continue;
    seen.add(demo.slug);
    highlights.push(demo);
  }

  highlights.sort((a, b) => {
    const badgeRank = (d: (typeof allDemos)[0]) => {
      if (!isLegacy(d) && !isProject(d)) return 0;
      if (d.data.badge === "精选" || CURATED_DEMO_SLUGS.has(d.slug)) return 1;
      if ((d.data.relatedPosts?.length ?? 0) > 0) return 2;
      return 3;
    };
    const r = badgeRank(a) - badgeRank(b);
    if (r !== 0) return r;
    return a.data.title.localeCompare(b.data.title, "zh");
  });

  return paginate(highlights, { pageSize: 10 });
}

const { page } = Astro.props;
const allDemos = await getCollection("demos");
const legacyCount = allDemos.filter((d) => d.data.tags?.includes("legacy")).length;

function demoUrl(demo: (typeof page.data)[0]) {
  return "/demos/" + createSlug(demo.data.title, demo.slug);
}
---

<BaseLayout
  title="项目展示"
  sideBarActiveItemID="demos"
>
  <div>
    <div class="text-3xl w-full font-bold mb-2">项目展示</div>
    <p class="opacity-80 mb-4">
      开源项目与历史 Demo。卡片上的标签区分精选、博客配套等；完整列表见归档。
    </p>
    <div class="mb-6 flex flex-wrap gap-2 items-center">
      <a href="/search/?type=demo" class="btn btn-primary btn-sm" data-astro-reload>搜索项目</a>
      <a href="/demos/archive/" class="btn btn-outline btn-sm" data-astro-reload>浏览全部归档</a>
      <span class="text-sm opacity-60">
        第 {page.currentPage} / {page.lastPage} 页 · 共 {page.total} 个
      </span>
    </div>
  </div>

  {
    page.data.map((demo) => (
      <>
        <HorizontalCard
          title={demo.data.title}
          img={demo.data.heroImage}
          desc={demo.data.description}
          url={demoUrl(demo)}
          target="_self"
          badge={demo.data.badge}
          tags={demo.data.tags}
        />
        <div class="divider my-0" />
      </>
    ))
  }

  <div class="flex justify-between items-center">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="btn btn-ghost my-10" data-astro-reload>
          <svg
            class="h-6 w-6 fill-current"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
          >
            <path d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" />
          </svg>
          上一页
        </a>
      ) : (
        <div />
      )
    }
    {
      page.url.next ? (
        <a href={page.url.next} class="btn btn-ghost my-10" data-astro-reload>
          下一页
          <svg
            class="h-6 w-6 fill-current"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
          >
            <path d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" />
          </svg>
        </a>
      ) : (
        <div />
      )
    }
  </div>

  {
    legacyCount > 0 && (
      <div class="alert alert-info mt-2">
        <div>
          <div class="font-semibold">全部历史 Demo（{legacyCount} 个）</div>
          <div class="text-sm opacity-90">
            含 Bug 复现、思否配套与一次性实验；可按分类搜索浏览。
          </div>
        </div>
        <a href="/demos/archive/" class="btn btn-sm btn-primary" data-astro-reload>
          浏览全部
        </a>
      </div>
    )
  }
</BaseLayout>
