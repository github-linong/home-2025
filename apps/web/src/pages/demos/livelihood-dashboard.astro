---
// Standalone civic-livelihood dashboard: a transparent 3D avatar walks to the
// panel the LLM picked and explains the data out loud.
const PANELS = [
  {
    id: "population",
    title: "人口概况",
    summary:
      "常住人口486.2万人，同比增长0.6%；城镇化率71.4%；出生率6.8‰，65岁以上人口占比15.2%。",
    metrics: [
      { label: "常住人口", value: "486.2万", note: "同比 +0.6%" },
      { label: "城镇化率", value: "71.4%", note: "较上年 +0.9pp" },
      { label: "出生率", value: "6.8‰", note: "65岁以上占比 15.2%" },
    ],
  },
  {
    id: "employment",
    title: "就业与收入",
    summary:
      "城镇新增就业12.6万人，调查失业率4.9%；分区就业率：城东区97.2%最高，城西区95.1%，江北区94.3%，高新区96.8%，老城区92.6%最低；居民人均可支配收入4.86万元，同比增长5.2%。",
    bars: [
      { label: "城东", value: 97.2 },
      { label: "高新", value: 96.8 },
      { label: "城西", value: 95.1 },
      { label: "江北", value: 94.3 },
      { label: "老城", value: 92.6 },
    ],
  },
  {
    id: "medical",
    title: "医疗保障",
    summary:
      "基本医保参保率98.6%；每千人医疗床位7.9张；社区医院128家，家庭医生签约率78.4%；门诊次均费用同比下降3.1%。",
    metrics: [
      { label: "医保参保率", value: "98.6%", note: "全省第2" },
      { label: "每千人床位", value: "7.9张", note: "较上年 +0.4" },
      { label: "社区医院", value: "128家", note: "签约率 78.4%" },
    ],
  },
  {
    id: "education",
    title: "教育资源",
    summary:
      "幼儿园普惠率92.3%，义务教育师生比1:13.5；今年新建改扩建学校14所，新增学位2.1万个；课后服务覆盖率100%。",
    progress: [
      { label: "幼儿园普惠率", value: 92.3 },
      { label: "课后服务覆盖率", value: 100 },
      { label: "学位建设完成率", value: 86.5 },
    ],
  },
  {
    id: "food-price",
    title: "菜篮子价格指数",
    summary:
      "当月菜篮子价格指数102.4，同比上涨1.8%，环比下降0.6%；近12个月最高105.8（2月），最低99.6（6月），整体温和波动。",
    line: [101.2, 103.4, 105.8, 104.1, 102.0, 100.3, 99.6, 100.8, 101.5, 102.9, 103.2, 102.4],
  },
  {
    id: "elder-care",
    title: "养老服务",
    summary:
      "养老床位4.2万张，每千名老人拥有床位38.5张；社区养老服务中心覆盖率89%；助餐点412个，长护险参保102万人。",
    progress: [
      { label: "社区养老中心覆盖率", value: 89 },
      { label: "床位使用率", value: 76 },
      { label: "助餐点建设进度", value: 94 },
    ],
  },
];

const MODULE_TABS = ["运行态势", "质量管理", "能耗驾驶舱", "安全与风险", "工艺链路", "产能监控"];
const LIVE_KPIS = [
  { label: "产线在线率", value: "98.4%", trend: "+0.7%" },
  { label: "当日订单达成", value: "126/133", trend: "94.7%" },
  { label: "设备健康度", value: "92.1", trend: "+1.4" },
  { label: "异常工单", value: "7", trend: "-3" },
];
const OPERATION_TIMELINE = [
  { time: "09:10", text: "吊装线A完成自动巡检，温控恢复正常" },
  { time: "10:35", text: "城东厂区新增订单 18 单，产能负载 +4.2%" },
  { time: "11:20", text: "港机装配段切换夜间节能策略，功耗下降 6.1%" },
  { time: "13:05", text: "风电设备部件质检一次通过率提升至 99.1%" },
];
const RANKING = [
  { name: "城东园区", score: 97.2, info: "效率领先" },
  { name: "高新园区", score: 96.8, info: "良率优秀" },
  { name: "临港园区", score: 95.4, info: "稳定运行" },
  { name: "江北园区", score: 94.3, info: "持续改善" },
  { name: "老城园区", score: 92.6, info: "需优化" },
];
const MARQUEE_ITEMS = [
  "今日安全生产 0 事故，重点设备状态全部绿色",
  "产线切换平均耗时 8.2 分钟，较上周缩短 12%",
  "民生重点项目交付准时率 98.9%，同比提升 3.4%",
  "能源侧峰谷调度已执行 16 次，累计节电 2.8 万度",
];

const clientPanels = PANELS.map(({ id, title, summary }) => ({ id, title, summary }));
const clientGuideContext = [
  `模块: ${MODULE_TABS.join(" / ")}`,
  `实时KPI: ${LIVE_KPIS.map((item) => `${item.label}=${item.value}(${item.trend})`).join("；")}`,
  `运营播报: ${OPERATION_TIMELINE.map((item) => `${item.time}${item.text}`).join("；")}`,
  `园区排名: ${RANKING.map((item) => `${item.name}${item.score}%(${item.info})`).join("；")}`,
  `滚动消息: ${MARQUEE_ITEMS.join("；")}`,
].join("\n");

const LINE_W = 260;
const LINE_H = 96;
function linePoints(values: number[]) {
  const min = Math.min(...values);
  const max = Math.max(...values);
  const span = max - min || 1;
  return values
    .map((value, index) => {
      const x = (index / (values.length - 1)) * LINE_W;
      const y = LINE_H - 10 - ((value - min) / span) * (LINE_H - 24);
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(" ");
}
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>民生数据大屏 · 数字人导览 Demo</title>
  </head>
  <body>
    <div id="screen">
      <header id="screenHeader">
        <a id="backLink" href="/demos/livelihood-dashboard-guide">← 返回</a>
        <h1>幸福城市 · 民生数据大屏</h1>
        <span id="screenClock"></span>
      </header>
      <nav id="moduleTabs" aria-label="大屏模块">
        {
          MODULE_TABS.map((tab, index) => (
            <button type="button" class:list={["module-tab", index === 0 && "active"]}>{tab}</button>
          ))
        }
      </nav>
      <section id="liveKpis" aria-label="实时指标">
        {
          LIVE_KPIS.map((kpi) => (
            <article class="live-kpi">
              <span class="live-kpi-label">{kpi.label}</span>
              <strong>{kpi.value}</strong>
              <em>{kpi.trend}</em>
            </article>
          ))
        }
      </section>

      <main id="panelGrid">
        {
          PANELS.map((panel) => (
            <section class="panel" data-panel-id={panel.id}>
              <h2>{panel.title}</h2>
              {panel.metrics && (
                <div class="metrics">
                  {panel.metrics.map((metric) => (
                    <div class="metric">
                      <strong>{metric.value}</strong>
                      <span>{metric.label}</span>
                      <em>{metric.note}</em>
                    </div>
                  ))}
                </div>
              )}
              {panel.bars && (
                <div class="bars">
                  {panel.bars.map((bar) => (
                    <div class="bar-row">
                      <span class="bar-label">{bar.label}</span>
                      <div class="bar-track">
                        <div
                          class="bar-fill"
                          style={`width:${(bar.value - 88) * (100 / 12)}%`}
                        />
                      </div>
                      <span class="bar-value">{bar.value}%</span>
                    </div>
                  ))}
                </div>
              )}
              {panel.progress && (
                <div class="bars">
                  {panel.progress.map((item) => (
                    <div class="bar-row">
                      <span class="bar-label wide">{item.label}</span>
                      <div class="bar-track">
                        <div class="bar-fill" style={`width:${item.value}%`} />
                      </div>
                      <span class="bar-value">{item.value}%</span>
                    </div>
                  ))}
                </div>
              )}
              {panel.line && (
                <div class="line-wrap">
                  <svg
                    viewBox={`0 0 ${LINE_W} ${LINE_H}`}
                    preserveAspectRatio="none"
                    aria-label="近12个月价格指数走势"
                  >
                    <polyline class="line-path" points={linePoints(panel.line)} />
                  </svg>
                  <div class="line-meta">
                    <span>当月 102.4</span>
                    <span>同比 +1.8%</span>
                    <span>环比 -0.6%</span>
                  </div>
                </div>
              )}
            </section>
          ))
        }
      </main>
      <section id="opsGrid">
        <article class="ops-card" aria-label="运营播报">
          <h3>运营播报</h3>
          <ul>
            {
              OPERATION_TIMELINE.map((item) => (
                <li>
                  <time>{item.time}</time>
                  <span>{item.text}</span>
                </li>
              ))
            }
          </ul>
        </article>
        <article class="ops-card" aria-label="园区运行排名">
          <h3>园区运行排名</h3>
          <ol>
            {
              RANKING.map((item, index) => (
                <li>
                  <b>{index + 1}</b>
                  <span>{item.name}</span>
                  <em>{item.score}%</em>
                  <small>{item.info}</small>
                </li>
              ))
            }
          </ol>
        </article>
      </section>
      <section id="marquee" aria-label="滚动播报">
        <div class="marquee-track">
          {[...MARQUEE_ITEMS, ...MARQUEE_ITEMS].map((item) => (
            <span>{item}</span>
          ))}
        </div>
      </section>
      <div id="focusDot" aria-hidden="true"></div>

      <div id="avatarOverlay">
        <div id="avatarStage"></div>
        <button id="btnStart">启动数字人讲解员</button>
        <span id="avatarStatus" hidden></span>
      </div>

      <form id="askBar">
        <div id="askChips">
          <button type="button" class="chip">哪个区就业率最高？</button>
          <button type="button" class="chip">菜篮子价格走势怎么样？</button>
          <button type="button" class="chip">养老床位够不够？</button>
        </div>
        <div id="askRow">
          <input
            id="askInput"
            type="text"
            placeholder="启动数字人后，问问大屏上的数据…"
            autocomplete="off"
            disabled
          />
          <button id="btnAsk" type="submit" disabled>提问</button>
        </div>
        <p id="answerText" hidden></p>
      </form>
    </div>

    <script type="application/json" id="panelData" set:html={JSON.stringify(clientPanels)} />
    <script
      type="application/json"
      id="guideContextData"
      set:html={JSON.stringify(clientGuideContext)}
    />

    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      html,
      body {
        height: 100%;
      }
      body {
        font-family: "PingFang SC", "Microsoft YaHei", system-ui, sans-serif;
        background: radial-gradient(120% 120% at 50% 0%, #0c2144 0%, #060d1f 60%, #04070f 100%);
        color: #d9e6ff;
        overflow: hidden;
      }
      #screen {
        position: relative;
        display: flex;
        flex-direction: column;
        height: 100vh;
        padding: 12px 16px 132px;
        gap: 8px;
      }
      #screenHeader {
        display: flex;
        align-items: center;
        gap: 16px;
      }
      #screenHeader h1 {
        flex: 1;
        text-align: center;
        font-size: 26px;
        letter-spacing: 6px;
        background: linear-gradient(180deg, #eaf4ff, #7fb4ff);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        text-shadow: 0 0 24px rgba(88, 156, 255, 0.35);
      }
      #backLink,
      #screenClock {
        width: 130px;
        font-size: 12px;
        color: #7d9cc9;
        text-decoration: none;
      }
      #screenClock {
        text-align: right;
        font-variant-numeric: tabular-nums;
      }
      #panelGrid {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: repeat(2, 1fr);
        gap: 8px;
        min-height: 0;
      }
      #moduleTabs {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 8px;
      }
      .module-tab {
        border: 1px solid rgba(91, 142, 220, 0.45);
        border-radius: 999px;
        background: rgba(14, 34, 66, 0.75);
        color: #8ab0e2;
        font-size: 12px;
        line-height: 30px;
        cursor: pointer;
      }
      .module-tab.active {
        color: #d8f4ff;
        border-color: rgba(94, 220, 255, 0.85);
        box-shadow: 0 0 20px rgba(94, 220, 255, 0.2) inset;
      }
      #liveKpis {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 10px;
      }
      .live-kpi {
        border: 1px solid rgba(72, 120, 199, 0.4);
        border-radius: 8px;
        background: linear-gradient(180deg, rgba(18, 44, 86, 0.8), rgba(9, 23, 44, 0.8));
        padding: 6px 10px;
        display: grid;
        grid-template-columns: 1fr auto auto;
        align-items: baseline;
        column-gap: 8px;
      }
      .live-kpi-label {
        color: #8ab0e2;
        font-size: 11px;
      }
      .live-kpi strong {
        color: #e7f3ff;
        font-size: 18px;
        font-variant-numeric: tabular-nums;
      }
      .live-kpi em {
        color: #5edcff;
        font-style: normal;
        font-size: 12px;
      }
      .panel {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 14px 16px;
        border: 1px solid rgba(94, 154, 255, 0.28);
        border-radius: 10px;
        background: linear-gradient(160deg, rgba(20, 46, 92, 0.55), rgba(9, 20, 42, 0.72));
        box-shadow: inset 0 0 24px rgba(56, 116, 226, 0.12);
        overflow: hidden;
        transition: border-color 0.4s, box-shadow 0.4s, transform 0.4s;
      }
      .panel h2 {
        font-size: 15px;
        font-weight: 600;
        color: #9cc4ff;
        padding-left: 10px;
        border-left: 3px solid #3f8cff;
      }
      .panel.focused {
        border-color: rgba(94, 220, 255, 0.9);
        box-shadow:
          0 0 0 1px rgba(94, 220, 255, 0.5),
          0 0 32px rgba(64, 186, 255, 0.35),
          inset 0 0 32px rgba(64, 186, 255, 0.18);
        transform: scale(1.015);
        z-index: 5;
      }
      .metrics {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        align-items: center;
      }
      .metric {
        display: flex;
        flex-direction: column;
        gap: 4px;
        text-align: center;
      }
      .metric strong {
        font-size: clamp(18px, 2.1vw, 28px);
        color: #5edcff;
        font-variant-numeric: tabular-nums;
      }
      .metric span {
        font-size: 12px;
        color: #a8bfe6;
      }
      .metric em {
        font-style: normal;
        font-size: 11px;
        color: #6d89b8;
      }
      .bars {
        flex: 1;
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
      }
      .bar-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
      }
      .bar-label {
        width: 34px;
        color: #a8bfe6;
      }
      .bar-label.wide {
        width: 118px;
      }
      .bar-track {
        flex: 1;
        height: 8px;
        border-radius: 4px;
        background: rgba(63, 105, 175, 0.25);
        overflow: hidden;
      }
      .bar-fill {
        height: 100%;
        border-radius: 4px;
        background: linear-gradient(90deg, #2f7bff, #5edcff);
      }
      .bar-value {
        width: 48px;
        text-align: right;
        color: #5edcff;
        font-variant-numeric: tabular-nums;
      }
      .line-wrap {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-height: 0;
      }
      .line-wrap svg {
        flex: 1;
        width: 100%;
        min-height: 0;
      }
      .line-path {
        fill: none;
        stroke: #5edcff;
        stroke-width: 2;
        filter: drop-shadow(0 0 6px rgba(94, 220, 255, 0.6));
      }
      .line-meta {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        color: #a8bfe6;
      }
      #avatarOverlay {
        position: absolute;
        left: 0;
        top: 0;
        width: clamp(180px, 11.5vw, 220px);
        height: clamp(290px, 20vw, 360px);
        z-index: 20;
        pointer-events: none;
        transition: transform 1.1s cubic-bezier(0.33, 1, 0.68, 1);
        will-change: transform;
        opacity: 1;
      }
      #focusDot {
        position: absolute;
        width: 14px;
        height: 14px;
        border-radius: 999px;
        border: 1px solid rgba(94, 220, 255, 0.95);
        background: rgba(94, 220, 255, 0.35);
        box-shadow: 0 0 14px rgba(94, 220, 255, 0.72);
        transform: translate(-50%, -50%) scale(0.8);
        opacity: 0;
        z-index: 22;
        pointer-events: none;
        transition: opacity 0.22s ease, transform 0.22s ease;
      }
      #focusDot.is-visible {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
      }
      #avatarOverlay.is-fading {
        opacity: 0.12;
        transition: opacity 0.22s ease;
      }
      #avatarOverlay.is-visible {
        opacity: 1;
        transition: opacity 0.26s ease;
      }
      #avatarStage {
        width: 100%;
        height: 100%;
      }
      #avatarStage :global(canvas) {
        background: transparent !important;
      }
      #btnStart {
        position: absolute;
        left: 50%;
        bottom: 36px;
        transform: translateX(-50%);
        pointer-events: auto;
        padding: 10px 18px;
        border: 1px solid rgba(94, 220, 255, 0.6);
        border-radius: 999px;
        background: rgba(10, 32, 66, 0.9);
        color: #bfeaff;
        font-size: 13px;
        cursor: pointer;
        white-space: nowrap;
      }
      #btnStart:hover {
        background: rgba(24, 62, 118, 0.95);
      }
      #btnStart:disabled {
        opacity: 0.6;
        cursor: wait;
      }
      #avatarStatus {
        position: absolute;
        left: 50%;
        bottom: 8px;
        transform: translateX(-50%);
        padding: 2px 10px;
        border-radius: 999px;
        background: rgba(6, 16, 34, 0.75);
        font-size: 11px;
        color: #8fb6e8;
        white-space: nowrap;
        opacity: 0;
        transition: opacity 0.28s ease;
      }
      #askBar {
        position: absolute;
        left: 50%;
        bottom: 16px;
        transform: translateX(-50%);
        width: min(720px, calc(100vw - 260px));
        display: flex;
        flex-direction: column;
        gap: 8px;
        z-index: 30;
      }
      #opsGrid {
        display: grid;
        grid-template-columns: 1.45fr 1fr;
        gap: 8px;
      }
      .ops-card {
        border: 1px solid rgba(84, 132, 209, 0.38);
        border-radius: 10px;
        padding: 10px 12px;
        background: linear-gradient(160deg, rgba(16, 39, 75, 0.8), rgba(9, 22, 43, 0.82));
      }
      .ops-card h3 {
        font-size: 13px;
        color: #9cc4ff;
        margin-bottom: 8px;
      }
      .ops-card ul,
      .ops-card ol {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .ops-card li {
        display: grid;
        grid-template-columns: auto 1fr auto auto;
        gap: 8px;
        align-items: center;
        padding: 4px 0;
        border-bottom: 1px dashed rgba(95, 140, 209, 0.24);
      }
      .ops-card li:last-child {
        border-bottom: none;
      }
      .ops-card time,
      .ops-card b {
        color: #5edcff;
        font-size: 12px;
        font-variant-numeric: tabular-nums;
      }
      .ops-card span {
        color: #c8defd;
        font-size: 12px;
      }
      .ops-card em {
        font-style: normal;
        color: #d9f3ff;
        font-size: 12px;
      }
      .ops-card small {
        color: #8ba8d3;
        font-size: 11px;
      }
      #marquee {
        position: absolute;
        left: 20px;
        right: 20px;
        bottom: 100px;
        height: 24px;
        border: 1px solid rgba(95, 150, 228, 0.36);
        border-radius: 999px;
        background: rgba(8, 22, 44, 0.75);
        overflow: hidden;
      }
      .marquee-track {
        height: 100%;
        display: inline-flex;
        align-items: center;
        gap: 34px;
        padding: 0 20px;
        white-space: nowrap;
        animation: marqueeMove 28s linear infinite;
      }
      .marquee-track span {
        font-size: 12px;
        color: #9cc4ff;
      }
      @keyframes marqueeMove {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-50%);
