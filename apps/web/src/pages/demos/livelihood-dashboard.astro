      }
      #avatarStatus.is-visible,
      #answerText.is-visible {
        opacity: 1;
      }
    </style>

    <script>
      import type { HeadAudio } from "@met4citizen/headaudio/dist/headaudio.min.mjs";
      import { TalkingHead } from "@met4citizen/talkinghead";
      import * as THREE from "three";
      import { CCDIKSolver } from "three/addons/animation/CCDIKSolver.js";
      import { attachHeadAudio, type HeadInternals } from "../../lib/avatar/headAudio";
      import { audioBufferToPcm, createVisemeTimeline } from "../../lib/avatar/speech";
      import { createAvatarConfig, createHeadOptions } from "../../lib/avatar/visuals";

      type GuidePanel = { id: string; title: string; summary: string; anchors?: string[] };
      type FocusEvent2 = { type: "focus"; target: string; at: number; anchorId?: string };
      type GuideMessage = {
        type: "avatar_response";
        version: 2;
        speech: { text: string; language: string };
        timeline: FocusEvent2[];
      };
      type PanelAnchor = {
        id: string;
        x: number;
        y: number;
        intents?: string[];
        hint?: "index" | "hand_raise";
      };

      const GUIDE_ENDPOINT = "/api/demo/guide";
      const TTS_ENDPOINT = "/api/demo/tts";
      const OVERLAY_MARGIN = 10;
      const AVATAR_AUTOLOAD_KEY = "livelihood-dashboard:avatar-autoload:v1";
      const AVATAR_GESTURE_DELAY_MS = 850;
      const AVATAR_FADE_MOVE_MS = 220;
      const AVATAR_PANEL_OVERLAP_RATIO = 0.18;
      const AVATAR_PANEL_SIDE_GAP = 10;
      const AVATAR_FOCUS_VERTICAL_OFFSET = 18;
      const POINTING_ERROR_THRESHOLD_PX = 55;
      const MOUSE_POINT_COOLDOWN_MS = 0;
      const MOUSE_POINT_MIN_DELTA_PX = 4;
      const LOOK_AT_THROTTLE_MS = 80;
      const LOOK_AT_DURATION_MS = 1800;
      const ARM_AIM_MAX_PITCH = 1.62;
      const ARM_AIM_MAX_YAW = 2.15;
      const ARM_AIM_RELAX = 0.24;
      const ARM_AIM_HARD_RELAX = 0.44;
      const PANEL_ANCHORS: Record<string, PanelAnchor[]> = {
        population: [
          { id: "population_total", x: 0.16, y: 0.42, intents: ["人口", "常住"] },
          { id: "population_birth", x: 0.8, y: 0.42, intents: ["出生", "老龄", "65"] },
        ],
        employment: [
          { id: "employment_top_rate", x: 0.84, y: 0.31, intents: ["最高", "就业率", "城东"] },
          { id: "employment_trend", x: 0.62, y: 0.68, intents: ["收入", "新增就业"] },
        ],
        medical: [
          { id: "medical_coverage", x: 0.17, y: 0.44, intents: ["医保", "参保"] },
          { id: "medical_beds", x: 0.5, y: 0.44, intents: ["床位"] },
        ],
        education: [
          { id: "education_after_school", x: 0.82, y: 0.56, intents: ["课后", "覆盖率"] },
          { id: "education_build", x: 0.76, y: 0.74, intents: ["学位", "建设"] },
        ],
        "food-price": [
          { id: "food_price_latest", x: 0.84, y: 0.58, intents: ["走势", "当月", "环比"] },
          { id: "food_price_peak", x: 0.36, y: 0.34, intents: ["最高", "峰值"] },
        ],
        "elder-care": [
          { id: "elder_coverage", x: 0.81, y: 0.53, intents: ["养老中心", "覆盖"] },
          { id: "elder_bed_usage", x: 0.78, y: 0.66, intents: ["床位", "使用率"] },
        ],
      };

      const $ = (id: string) => document.getElementById(id)!;
      const screenRoot = $("screen");
      const overlay = $("avatarOverlay");
      const avatarStage = $("avatarStage");
      const focusDot = $("focusDot");
      const btnStart = $("btnStart") as HTMLButtonElement;
      const avatarStatus = $("avatarStatus");
      const askBar = $("askBar") as HTMLFormElement;
      const askInput = $("askInput") as HTMLInputElement;
      const btnAsk = $("btnAsk") as HTMLButtonElement;
      const answerText = $("answerText");
      const screenClock = $("screenClock");
      const panels = JSON.parse($("panelData").textContent || "[]") as GuidePanel[];
      const guideContext = JSON.parse($("guideContextData").textContent || "\"\"") as string;

      let head: TalkingHead | null = null;
      let headAudio: HeadAudio | null = null;
      let headAudioReady = false;
      let requestController: AbortController | null = null;
      let ttsController: AbortController | null = null;
      let focusTimers: number[] = [];
      let overlayMoveTimer: number | null = null;
      let activeFocusHint = "";
      let currentAimTarget: { x: number; y: number } | null = null;
      let lastMouseGestureAt = 0;
      let lastMouseTarget: { x: number; y: number } | null = null;
      let handBones: {
        left: { hand: any | null; index: any | null };
        right: { hand: any | null; index: any | null };
      } | null = null;
      let armBones: {
        left: {
          shoulder: any | null;
          upper: any | null;
          fore: any | null;
          hand: any | null;
          index1: any | null;
          index2: any | null;
        };
        right: {
          shoulder: any | null;
          upper: any | null;
          fore: any | null;
          hand: any | null;
          index1: any | null;
          index2: any | null;
        };
      } | null = null;
      let armBaseRotations: {
        left: {
          shoulder: { x: number; y: number; z: number };
          upper: { x: number; y: number; z: number };
          fore: { x: number; y: number; z: number };
          hand: { x: number; y: number; z: number };
          index1: { x: number; y: number; z: number };
          index2: { x: number; y: number; z: number };
        };
        right: {
          shoulder: { x: number; y: number; z: number };
          upper: { x: number; y: number; z: number };
          fore: { x: number; y: number; z: number };
          hand: { x: number; y: number; z: number };
          index1: { x: number; y: number; z: number };
          index2: { x: number; y: number; z: number };
        };
      } | null = null;
      let ikRuntime: {
        solver: CCDIKSolver;
        mesh: THREE.SkinnedMesh;
        leftTarget: THREE.Bone;
        rightTarget: THREE.Bone;
        leftNeutral: THREE.Vector3;
        rightNeutral: THREE.Vector3;
      } | null = null;
      let aimRaf = 0;
      let currentYaw = 0;
      let targetYaw = 0;
      let hasYaw = false;
      let lastLookAtAt = 0;
      let streamStarted = false;
      let disposed = false;
      /** Voice/guide session blocks mouse look-at until speech finishes. */
      let voiceSessionActive = false;
      let voiceSessionId = 0;
      const lifecycleController = new AbortController();

      function beginVoiceSession() {
        voiceSessionId += 1;
        voiceSessionActive = true;
        return voiceSessionId;
      }

      function endVoiceSession(sessionId?: number) {
        if (sessionId != null && sessionId !== voiceSessionId) return;
        voiceSessionActive = false;
      }

      function isMouseLookEnabled() {
        return Boolean(head) && !disposed && !voiceSessionActive;
      }

      function isAvatarAutoloadEnabled() {
        try {
          return window.localStorage.getItem(AVATAR_AUTOLOAD_KEY) === "1";
        } catch {
          return false;
        }
      }

      function setAvatarAutoloadEnabled(enabled: boolean) {
        try {
          if (enabled) window.localStorage.setItem(AVATAR_AUTOLOAD_KEY, "1");
          else window.localStorage.removeItem(AVATAR_AUTOLOAD_KEY);
        } catch {
          // Ignore storage failures (private mode / blocked storage).
        }
      }

      setInterval(() => {
        screenClock.textContent = new Date().toLocaleString("zh-CN", { hour12: false });
      }, 1000);

      function setFadingVisibility(el: HTMLElement, visible: boolean) {
        if (visible) {
          if (el.hidden) el.hidden = false;
          requestAnimationFrame(() => el.classList.add("is-visible"));
          return;
        }
        el.classList.remove("is-visible");
        const onEnd = (event: TransitionEvent) => {
          if (event.propertyName !== "opacity") return;
          el.hidden = true;
          el.removeEventListener("transitionend", onEnd);
        };
        el.addEventListener("transitionend", onEnd);
      }

      function setStatus(text: string) {
        avatarStatus.textContent = text;
        setFadingVisibility(avatarStatus, Boolean(text));
      }

      // ---- overlay movement ------------------------------------------------

      function moveOverlayTo(x: number, y: number) {
        overlay.style.transform = `translate(${Math.round(x)}px, ${Math.round(y)}px)`;
      }

      function dockPosition() {
        const root = screenRoot.getBoundingClientRect();
        return {
          x: Math.round(root.width / 2 - overlay.offsetWidth / 2),
          y: Math.round(root.height / 2 - overlay.offsetHeight / 2),
        };
      }

      function moveToDock({ instant = false } = {}) {
        const dock = dockPosition();
        if (instant) {
          // First placement must not animate from the overlay's default
          // top-left position.
          overlay.style.transition = "none";
          moveOverlayTo(dock.x, dock.y);
          void overlay.offsetWidth;
          overlay.style.transition = "";
          return;
        }
        fadeMoveOverlay(dock.x, dock.y);
      }

      function clampOverlayPosition(x: number, y: number) {
        const root = screenRoot.getBoundingClientRect();
        return {
          x: Math.max(OVERLAY_MARGIN, Math.min(x, root.width - overlay.offsetWidth - OVERLAY_MARGIN)),
          y: Math.max(OVERLAY_MARGIN, Math.min(y, root.height - overlay.offsetHeight - OVERLAY_MARGIN)),
        };
      }

      /** Comfortable stand position beside a focused panel (voice sessions only). */
      function standBesidePanel(panelRect: DOMRect, anchorPoint: { x: number; y: number }) {
        const root = screenRoot.getBoundingClientRect();
        const panelLeft = panelRect.left - root.left;
        const panelTop = panelRect.top - root.top;
        const standRight = anchorPoint.x < root.width / 2;
        const overlapX = overlay.offsetWidth * AVATAR_PANEL_OVERLAP_RATIO;
        const x = standRight
          ? panelLeft + panelRect.width - overlapX + AVATAR_PANEL_SIDE_GAP
          : panelLeft - overlay.offsetWidth + overlapX - AVATAR_PANEL_SIDE_GAP;
        const y = panelTop + panelRect.height - overlay.offsetHeight + AVATAR_FOCUS_VERTICAL_OFFSET;
        return { ...clampOverlayPosition(x, y), standRight };
      }

      function fadeMoveOverlay(x: number, y: number) {
        if (overlayMoveTimer !== null) {
          window.clearTimeout(overlayMoveTimer);
          overlayMoveTimer = null;
        }
        overlay.classList.remove("is-visible");
        overlay.classList.add("is-fading");
        overlayMoveTimer = window.setTimeout(() => {
          // Fade out, jump, then fade in — avoids visible sliding across panels.
          overlay.style.transition = "opacity 0.26s ease";
          moveOverlayTo(x, y);
          void overlay.offsetWidth;
          overlay.classList.remove("is-fading");
          overlay.classList.add("is-visible");
          overlay.style.transition = "";
          overlayMoveTimer = null;
        }, AVATAR_FADE_MOVE_MS);
      }

      function clearFocusHighlights() {
        document
          .querySelectorAll(".panel.focused")
          .forEach((panel) => panel.classList.remove("focused"));
      }

      function setFocusDot(point: { x: number; y: number } | null) {
        if (!point) {
          focusDot.classList.remove("is-visible");
          return;
        }
        focusDot.style.left = `${Math.round(point.x)}px`;
        focusDot.style.top = `${Math.round(point.y)}px`;
        focusDot.classList.add("is-visible");
      }

      function pickAnchor(panelId: string) {
        const anchors = PANEL_ANCHORS[panelId] ?? [];
        if (anchors.length === 0) return null;
        const hint = activeFocusHint.toLowerCase();
        for (const anchor of anchors) {
          if (anchor.intents?.some((intent) => hint.includes(intent.toLowerCase()))) return anchor;
        }
        return anchors[0];
      }

      function findAnchorById(panelId: string, anchorId?: string) {
        if (!anchorId) return null;
        const anchors = PANEL_ANCHORS[panelId] ?? [];
        return anchors.find((anchor) => anchor.id === anchorId) ?? null;
      }

      function estimatePointingError(
        target: { x: number; y: number },
        mirror: boolean,
        hint: "index" | "hand_raise",
      ) {
        const side: "left" | "right" = mirror ? "left" : "right";
        const projected = getProjectedPointForSide(side, hint);
        if (projected) {
          const dxProjected = target.x - projected.x;
          const dyProjected = target.y - projected.y;
          const errorProjected = Math.round(
            Math.sqrt(dxProjected * dxProjected + dyProjected * dyProjected),
          );
          return { errorPx: errorProjected, dx: dxProjected, dy: dyProjected };
        }
        const root = screenRoot.getBoundingClientRect();
        const rect = overlay.getBoundingClientRect();
        const overlayX = rect.left - root.left;
        const overlayY = rect.top - root.top;
        const fingerX = overlayX + rect.width * (mirror ? 0.61 : 0.39);
        const fingerY = overlayY + rect.height * (hint === "hand_raise" ? 0.2 : 0.32);
        const dx = target.x - fingerX;
        const dy = target.y - fingerY;
        const errorPx = Math.round(Math.sqrt(dx * dx + dy * dy));
        return { errorPx, dx, dy };
      }

      function pickBestMirrorForTarget(target: { x: number; y: number }, hint: "index" | "hand_raise") {
        const leftHand = estimatePointingError(target, true, hint);
        const rightHand = estimatePointingError(target, false, hint);
        return leftHand.errorPx <= rightHand.errorPx
          ? { mirror: true, estimate: leftHand }
          : { mirror: false, estimate: rightHand };
      }

      function pickMirrorByTargetSide(target: { x: number; y: number }) {
        const root = screenRoot.getBoundingClientRect();
        const rect = overlay.getBoundingClientRect();
        const centerX = rect.left - root.left + rect.width / 2;
        return target.x < centerX;
      }

      function getArmature() {
        return (head as HeadInternals | null)?.armature ?? null;
      }

      function getHeadRuntime() {
        return (head as
          | (HeadInternals & { camera?: any; renderer?: any; scene?: any; armature?: any })
          | null) ?? null;
      }

      function findBoneIndexByPattern(skeleton: THREE.Skeleton, patterns: RegExp[]) {
        for (let i = 0; i < skeleton.bones.length; i += 1) {
          const name = String(skeleton.bones[i]?.name ?? "");
          if (patterns.some((pattern) => pattern.test(name))) return i;
        }
        return -1;
      }

      function findSkinnedMeshForIk() {
        const runtime = getHeadRuntime();
        if (!runtime?.scene) return null;
        let found: THREE.SkinnedMesh | null = null;
        runtime.scene.traverse((node: THREE.Object3D) => {
          if (found) return;
          const maybeMesh = node as THREE.SkinnedMesh;
          if (!maybeMesh.isSkinnedMesh || !maybeMesh.skeleton) return;
          const skeleton = maybeMesh.skeleton;
          const hasLeftHand = findBoneIndexByPattern(skeleton, [/left.?hand$/i, /mixamoriglefthand/i]) >= 0;
          const hasRightHand = findBoneIndexByPattern(skeleton, [/right.?hand$/i, /mixamorigrighthand/i]) >= 0;
          if (hasLeftHand && hasRightHand) found = maybeMesh;
        });
        return found;
      }

      function buildIkRuntime() {
        const runtime = getHeadRuntime();
        const armature = getArmature();
        const mesh = findSkinnedMeshForIk();
        if (!runtime?.camera || !runtime?.renderer || !armature || !mesh?.skeleton) return null;
        const skeleton = mesh.skeleton;

        const leftShoulder = findBoneIndexByPattern(skeleton, [/left.?shoulder/i, /mixamorigleftshoulder/i]);
        const leftUpper = findBoneIndexByPattern(skeleton, [/left.?arm$/i, /mixamorigleftarm/i]);
        const leftFore = findBoneIndexByPattern(skeleton, [/left.?forearm/i, /mixamorigleftforearm/i]);
        const leftHand = findBoneIndexByPattern(skeleton, [/left.?hand$/i, /mixamoriglefthand/i]);
        const rightShoulder = findBoneIndexByPattern(skeleton, [/right.?shoulder/i, /mixamorigrightshoulder/i]);
        const rightUpper = findBoneIndexByPattern(skeleton, [/right.?arm$/i, /mixamorigrightarm/i]);
        const rightFore = findBoneIndexByPattern(skeleton, [/right.?forearm/i, /mixamorigrightforearm/i]);
        const rightHand = findBoneIndexByPattern(skeleton, [/right.?hand$/i, /mixamorigrighthand/i]);
        if (
          leftShoulder < 0 || leftUpper < 0 || leftFore < 0 || leftHand < 0 ||
          rightShoulder < 0 || rightUpper < 0 || rightFore < 0 || rightHand < 0
        ) {
          return null;
        }

        const leftHandBone = skeleton.bones[leftHand];
        const rightHandBone = skeleton.bones[rightHand];
        const leftTarget = new THREE.Bone();
        leftTarget.name = "IKTargetLeft";
        const rightTarget = new THREE.Bone();
        rightTarget.name = "IKTargetRight";

        const leftWorld = leftHandBone.getWorldPosition(new THREE.Vector3());
        const rightWorld = rightHandBone.getWorldPosition(new THREE.Vector3());
        const leftLocal = armature.worldToLocal(leftWorld.clone());
        const rightLocal = armature.worldToLocal(rightWorld.clone());
        leftTarget.position.copy(leftLocal);
        rightTarget.position.copy(rightLocal);
        armature.add(leftTarget);
        armature.add(rightTarget);

        skeleton.bones.push(leftTarget);
        skeleton.bones.push(rightTarget);
        skeleton.boneInverses.push(new THREE.Matrix4(), new THREE.Matrix4());
        skeleton.calculateInverses();

        const leftTargetIndex = skeleton.bones.length - 2;
        const rightTargetIndex = skeleton.bones.length - 1;
        const iks = [
          {
            target: leftTargetIndex,
            effector: leftHand,
            links: [
              {
                index: leftFore,
                rotationMin: new THREE.Vector3(-1.4, -0.8, -0.7),
                rotationMax: new THREE.Vector3(1.3, 0.8, 0.7),
              },
              {
                index: leftUpper,
                rotationMin: new THREE.Vector3(-1.2, -1.2, -1.2),
                rotationMax: new THREE.Vector3(1.5, 1.1, 1.2),
              },
            ],
            iteration: 6,
          },
          {
            target: rightTargetIndex,
            effector: rightHand,
            links: [
              {
                index: rightFore,
                rotationMin: new THREE.Vector3(-1.4, -0.8, -0.7),
                rotationMax: new THREE.Vector3(1.3, 0.8, 0.7),
              },
              {
                index: rightUpper,
                rotationMin: new THREE.Vector3(-1.2, -1.1, -1.2),
                rotationMax: new THREE.Vector3(1.5, 1.2, 1.2),
              },
            ],
            iteration: 6,
          },
        ];
        return {
          solver: new CCDIKSolver(mesh, iks),
          mesh,
          leftTarget,
          rightTarget,
          leftNeutral: leftLocal.clone(),
          rightNeutral: rightLocal.clone(),
        };
      }

      function updateIkAiming() {
        if (!currentAimTarget || !ikRuntime) return;
        const rootRect = screenRoot.getBoundingClientRect();
        const nx = clamp(currentAimTarget.x / Math.max(rootRect.width, 1) - 0.5, -0.5, 0.5) * 2;
        const ny = clamp(currentAimTarget.y / Math.max(rootRect.height, 1) - 0.5, -0.5, 0.5) * 2;
        const rect = overlay.getBoundingClientRect();
        const centerX = rect.left - rootRect.left + rect.width / 2;
        const dominantRight = currentAimTarget.x >= centerX;
        // Map screen-space target into armature-local IK target offsets.
        // For this rig local +Y lifts the hand, so downward cursor uses negative Y offset.
        const leftRawTarget = ikRuntime.leftNeutral.clone().add(
          new THREE.Vector3(nx * 0.42, -ny * 0.46, -nx * 0.16 + ny * 0.02),
        );
        const rightRawTarget = ikRuntime.rightNeutral.clone().add(
          new THREE.Vector3(nx * 0.42, -ny * 0.46, nx * 0.16 + ny * 0.02),
        );
        const clampToReach = (point: THREE.Vector3, neutral: THREE.Vector3, maxRadius = 0.58) => {
          const offset = point.clone().sub(neutral);
          const len = offset.length();
          if (len > maxRadius) offset.multiplyScalar(maxRadius / Math.max(len, 1e-6));
          return neutral.clone().add(offset);
        };
        const rightTarget = clampToReach(rightRawTarget, ikRuntime.rightNeutral, 0.42);
        const leftTarget = clampToReach(leftRawTarget, ikRuntime.leftNeutral, 0.42);
        if (dominantRight) {
          ikRuntime.rightTarget.position.lerp(rightTarget, 0.46);
          ikRuntime.leftTarget.position.lerp(ikRuntime.leftNeutral, 0.24);
        } else {
          ikRuntime.leftTarget.position.lerp(leftTarget, 0.46);
          ikRuntime.rightTarget.position.lerp(ikRuntime.rightNeutral, 0.24);
        }
        ikRuntime.solver.update();
      }

      function findNodeByName(root: any, patterns: RegExp[]) {
        if (!root || typeof root.traverse !== "function") return null;
        let matched: any | null = null;
        root.traverse((node: any) => {
          if (matched) return;
          const name = String(node?.name ?? "");
          if (patterns.some((pattern) => pattern.test(name))) matched = node;
        });
        return matched;
      }

      function resolveHandBones() {
        const runtime = getHeadRuntime();
        if (!runtime?.armature) return null;
        const leftHand = findNodeByName(runtime.armature, [/left.?hand/i, /hand_l/i, /mixamoriglefthand/i]);
        const rightHand = findNodeByName(runtime.armature, [/right.?hand/i, /hand_r/i, /mixamorigrighthand/i]);
        const leftIndex = findNodeByName(runtime.armature, [
          /left.?index/i,
          /left.*hand.*index/i,
          /index.?l/i,
          /mixamorigleft.*index/i,
        ]);
        const rightIndex = findNodeByName(runtime.armature, [
          /right.?index/i,
          /right.*hand.*index/i,
          /index.?r/i,
          /mixamorigright.*index/i,
        ]);
        handBones = {
          left: { hand: leftHand, index: leftIndex },
          right: { hand: rightHand, index: rightIndex },
        };
        return handBones;
      }

      function resolveArmBones() {
        const runtime = getHeadRuntime();
        if (!runtime?.armature) return null;
        const leftShoulder = findNodeByName(runtime.armature, [/left.?shoulder/i, /mixamorigleftshoulder/i]);
        const rightShoulder = findNodeByName(runtime.armature, [/right.?shoulder/i, /mixamorigrighthoulder/i, /mixamorigrightshoulder/i]);
        const leftUpper = findNodeByName(runtime.armature, [/left.?arm$/i, /mixamorigleftarm/i]);
        const rightUpper = findNodeByName(runtime.armature, [/right.?arm$/i, /mixamorigrigtharm/i, /mixamorigrightharm/i]);
        const leftFore = findNodeByName(runtime.armature, [/left.?forearm/i, /mixamorigleftforearm/i]);
        const rightFore = findNodeByName(runtime.armature, [/right.?forearm/i, /mixamorigrighthforearm/i, /mixamorigrightforearm/i]);
        const leftHand = findNodeByName(runtime.armature, [/left.?hand$/i, /mixamoriglefthand/i]);
        const rightHand = findNodeByName(runtime.armature, [/right.?hand$/i, /mixamorigrighthand/i]);
        const leftIndex1 = findNodeByName(runtime.armature, [/left.?hand.?index1/i, /mixamorigleft.*index1/i]);
        const rightIndex1 = findNodeByName(runtime.armature, [/right.?hand.?index1/i, /mixamorigright.*index1/i]);
        const leftIndex2 = findNodeByName(runtime.armature, [/left.?hand.?index2/i, /mixamorigleft.*index2/i]);
        const rightIndex2 = findNodeByName(runtime.armature, [/right.?hand.?index2/i, /mixamorigright.*index2/i]);
        armBones = {
          left: {
            shoulder: leftShoulder,
            upper: leftUpper,
            fore: leftFore,
            hand: leftHand,
            index1: leftIndex1,
            index2: leftIndex2,
          },
          right: {
            shoulder: rightShoulder,
            upper: rightUpper,
            fore: rightFore,
            hand: rightHand,
            index1: rightIndex1,
            index2: rightIndex2,
          },
        };
        const snap = (bone: any) => ({
          x: Number.isFinite(bone?.rotation?.x) ? bone.rotation.x : 0,
          y: Number.isFinite(bone?.rotation?.y) ? bone.rotation.y : 0,
          z: Number.isFinite(bone?.rotation?.z) ? bone.rotation.z : 0,
        });
        armBaseRotations = {
          left: {
            shoulder: snap(leftShoulder),
            upper: snap(leftUpper),
            fore: snap(leftFore),
            hand: snap(leftHand),
            index1: snap(leftIndex1),
            index2: snap(leftIndex2),
          },
          right: {
            shoulder: snap(rightShoulder),
            upper: snap(rightUpper),
            fore: snap(rightFore),
            hand: snap(rightHand),
            index1: snap(rightIndex1),
            index2: snap(rightIndex2),
          },
        };
        return armBones;
      }

      function getProjectedPointForSide(side: "left" | "right", hint: "index" | "hand_raise") {
        const runtime = getHeadRuntime();
        if (!runtime?.camera || !runtime?.renderer || !runtime?.armature) return null;
        const bones = handBones ?? resolveHandBones();
        const sideBones = bones?.[side];
        const node =
          hint === "index" ? sideBones?.index ?? sideBones?.hand : sideBones?.hand ?? sideBones?.index;
        if (!node || typeof node.getWorldPosition !== "function") return null;
        const canvas = runtime.renderer.domElement as HTMLCanvasElement | undefined;
        if (!canvas) return null;
        const rootRect = screenRoot.getBoundingClientRect();
        const canvasRect = canvas.getBoundingClientRect();
        const world = new THREE.Vector3();
        node.getWorldPosition(world);
        world.project(runtime.camera);
        const x = ((world.x + 1) * 0.5) * canvasRect.width + (canvasRect.left - rootRect.left);
        const y = ((1 - world.y) * 0.5) * canvasRect.height + (canvasRect.top - rootRect.top);
        if (!Number.isFinite(x) || !Number.isFinite(y)) return null;
        return { x, y };
      }

      function normalizeAngle(angle: number) {
        let value = angle;
        while (value > Math.PI) value -= Math.PI * 2;
        while (value < -Math.PI) value += Math.PI * 2;
        return value;
      }

      function clamp(value: number, min: number, max: number) {
        return Math.max(min, Math.min(max, value));
      }

      function lerp(from: number, to: number, alpha: number) {
        return from + (to - from) * alpha;
      }

      function updateArmAiming() {
        if (!head) return;
        const bones = armBones ?? resolveArmBones();
        const base = armBaseRotations;
        if (!bones || !base) return;
        const target = currentAimTarget;
        const rect = overlay.getBoundingClientRect();
        const rootRect = screenRoot.getBoundingClientRect();
        const centerX = rect.left - rootRect.left + rect.width / 2;
        const centerY = rect.top - rootRect.top + rect.height * 0.42;
        const hasTarget = Boolean(target);
        const dx = hasTarget ? target!.x - centerX : 0;
        const dy = hasTarget ? target!.y - centerY : 0;
        const angle = hasTarget ? Math.atan2(dy, dx) : 0;
        const distance = hasTarget ? Math.sqrt(dx * dx + dy * dy) : 0;
        const distanceNorm = clamp(distance / Math.max(rect.width, rect.height), 0, 1);
        const horizontal = Math.cos(angle); // right: +1, left: -1
        const vertical = -Math.sin(angle); // up: +1, down: -1
        const dominantSide: "left" | "right" = horizontal >= 0 ? "right" : "left";
        const dominantWeight = hasTarget ? 1 : 0;
        const supportWeight = hasTarget ? 0.18 : 0;

        const applySide = (side: "left" | "right", weight: number) => {
          const sideBones = bones[side];
          const sideBase = base[side];
          const sideSign = side === "left" ? -1 : 1;
          const isDominant = side === dominantSide;
          const blend = clamp(weight, 0, 1);
          const armOutward = clamp(horizontal * sideSign, -1, 1);
          const yaw = clamp(
            armOutward * ARM_AIM_MAX_YAW * blend * (isDominant ? 1 : 0.45),
            -ARM_AIM_MAX_YAW,
            ARM_AIM_MAX_YAW,
          );
          const pitch = clamp(
            vertical * ARM_AIM_MAX_PITCH * blend * (isDominant ? 1 : 0.55),
            -ARM_AIM_MAX_PITCH,
            ARM_AIM_MAX_PITCH,
          );
          const reach = blend * (0.35 + distanceNorm * 0.75);
          const relax = isDominant ? ARM_AIM_HARD_RELAX : ARM_AIM_RELAX;
          if (sideBones.shoulder?.rotation) {
            sideBones.shoulder.rotation.x = lerp(
              sideBones.shoulder.rotation.x,
              sideBase.shoulder.x + pitch * 0.48 + reach * 0.24,
              relax,
            );
            sideBones.shoulder.rotation.y = lerp(
              sideBones.shoulder.rotation.y,
              sideBase.shoulder.y + yaw * 0.26,
              relax,
            );
            sideBones.shoulder.rotation.z = lerp(
              sideBones.shoulder.rotation.z,
              sideBase.shoulder.z + yaw * 0.5 + sideSign * reach * 0.28,
              relax,
            );
          }
          if (sideBones.upper?.rotation) {
            sideBones.upper.rotation.x = lerp(
              sideBones.upper.rotation.x,
              sideBase.upper.x + pitch * 1.44 + reach * 0.5,
              relax,
            );
            sideBones.upper.rotation.y = lerp(
              sideBones.upper.rotation.y,
              sideBase.upper.y + yaw * 0.42,
              relax,
            );
            sideBones.upper.rotation.z = lerp(
              sideBones.upper.rotation.z,
              sideBase.upper.z + yaw * 1.35 + sideSign * reach * 0.46,
              relax,
            );
          }
          if (sideBones.fore?.rotation) {
            sideBones.fore.rotation.x = lerp(
              sideBones.fore.rotation.x,
              sideBase.fore.x + pitch * 1.35 + reach * 0.72,
              relax,
            );
            sideBones.fore.rotation.y = lerp(
              sideBones.fore.rotation.y,
              sideBase.fore.y + yaw * 0.42,
              relax,
            );
            sideBones.fore.rotation.z = lerp(
              sideBones.fore.rotation.z,
              sideBase.fore.z + yaw * 1.06 + sideSign * reach * 0.4,
              relax,
            );
          }
          if (sideBones.hand?.rotation) {
            sideBones.hand.rotation.x = lerp(
              sideBones.hand.rotation.x,
              sideBase.hand.x + pitch * 1.18 + reach * 0.3,
              relax,
            );
            sideBones.hand.rotation.y = lerp(
              sideBones.hand.rotation.y,
              sideBase.hand.y + yaw * 0.62,
              relax,
            );
            sideBones.hand.rotation.z = lerp(
              sideBones.hand.rotation.z,
              sideBase.hand.z + yaw * 0.78 + sideSign * reach * 0.18,
              relax,
            );
          }
          if (sideBones.index1?.rotation) {
            sideBones.index1.rotation.x = lerp(
              sideBones.index1.rotation.x,
              sideBase.index1.x + 0.36 + reach * (isDominant ? 0.95 : 0.42),
              relax,
            );
            sideBones.index1.rotation.y = lerp(
              sideBones.index1.rotation.y,
              sideBase.index1.y + yaw * 0.22,
              relax,
            );
            sideBones.index1.rotation.z = lerp(
              sideBones.index1.rotation.z,
              sideBase.index1.z + yaw * 0.16,
              relax,
            );
          }
          if (sideBones.index2?.rotation) {
            sideBones.index2.rotation.x = lerp(
              sideBones.index2.rotation.x,
              sideBase.index2.x + 0.24 + reach * (isDominant ? 0.72 : 0.28),
              relax,
            );
            sideBones.index2.rotation.y = lerp(
              sideBones.index2.rotation.y,
              sideBase.index2.y + yaw * 0.1,
              relax,
            );
            sideBones.index2.rotation.z = lerp(
              sideBones.index2.rotation.z,
              sideBase.index2.z + yaw * 0.08,
              relax,
            );
          }
        };

        applySide("left", hasTarget ? (dominantSide === "left" ? dominantWeight : supportWeight) : 0);
        applySide("right", hasTarget ? (dominantSide === "right" ? dominantWeight : supportWeight) : 0);
      }

      /** Convert screen-root local coords to viewport client coords for TalkingHead.lookAt. */
      function toClientPoint(target: { x: number; y: number }) {
        const root = screenRoot.getBoundingClientRect();
        return { x: root.left + target.x, y: root.top + target.y };
      }

      function lookAtScreenPoint(target: { x: number; y: number }, force = false) {
        if (!head || disposed) return;
        const now = performance.now();
        if (!force && now - lastLookAtAt < LOOK_AT_THROTTLE_MS) return;
        lastLookAtAt = now;
        currentAimTarget = target;
        const client = toClientPoint(target);
        try {
          head.lookAt(client.x, client.y, LOOK_AT_DURATION_MS);
          overlay.dataset.lookAtX = String(Math.round(client.x));
          overlay.dataset.lookAtY = String(Math.round(client.y));
        } catch (error) {
          console.warn("[dashboard] lookAt failed", error);
        }
      }

      function setAimTarget(target: { x: number; y: number }) {
        lookAtScreenPoint(target);
      }

      function pointAtTarget(target: { x: number; y: number }, force = false) {
        if (!head) return;
        lookAtScreenPoint(target, force);
        lastMouseGestureAt = performance.now();
      }

      function focusPanel(target: string, eventAnchorId?: string) {
        const panel = document.querySelector<HTMLElement>(
          `.panel[data-panel-id="${target}"]`,
        );
        if (!panel) return;
        clearFocusHighlights();
        panel.classList.add("focused");

        const root = screenRoot.getBoundingClientRect();
        const rect = panel.getBoundingClientRect();
        const panelLeft = rect.left - root.left;
        const panelTop = rect.top - root.top;
        const anchor = findAnchorById(target, eventAnchorId) ?? pickAnchor(target);
        const anchorPoint = anchor
          ? {
              x: panelLeft + rect.width * anchor.x,
              y: panelTop + rect.height * anchor.y,
            }
          : {
              x: panelLeft + rect.width / 2,
              y: panelTop + rect.height / 2,
            };
        const stand = standBesidePanel(rect, anchorPoint);
        fadeMoveOverlay(stand.x, stand.y);
        overlay.dataset.focusTarget = target;
        if (anchor) overlay.dataset.focusAnchor = anchor.id;
        setFocusDot(anchorPoint);

        // Look after the fade-hop lands so gaze uses the new eye screen position.
        focusTimers.push(
          window.setTimeout(() => {
            if (disposed || !voiceSessionActive) return;
            lookAtScreenPoint(anchorPoint, true);
            const gestureHint =
              anchor?.hint ?? (anchorPoint.y < panelTop + rect.height * 0.4 ? "hand_raise" : "index");
            const mirror = !stand.standRight;
            if (gestureHint === "hand_raise") {
              head?.playGesture("handup", 4, mirror, 420);
            } else {
              head?.playGesture("index", 4, mirror, 400);
            }
          }, AVATAR_FADE_MOVE_MS + 80),
        );
      }

      function scheduleFocusEvents(events: FocusEvent2[], durationSeconds: number) {
        clearFocusTimers();
        for (const event of events) {
          const delayMs = Math.max(0, Math.round(event.at * durationSeconds * 1_000));
          if (delayMs < 80) {
            focusPanel(event.target, event.anchorId);
            continue;
          }
          focusTimers.push(
            window.setTimeout(() => {
              if (!disposed) focusPanel(event.target, event.anchorId);
            }, delayMs),
          );
        }
      }

      function clearFocusTimers() {
        for (const timer of focusTimers) window.clearTimeout(timer);
        focusTimers = [];
      }

      function returnToDockSoon() {
        focusTimers.push(
          window.setTimeout(() => {
            clearFocusHighlights();
            delete overlay.dataset.focusTarget;
            delete overlay.dataset.focusAnchor;
            delete overlay.dataset.pointingErrorPx;
            setFocusDot(null);
            currentAimTarget = null;
            moveToDock();
          }, 2_000),
        );
      }

      // ---- avatar loading --------------------------------------------------

      async function initializeHeadAudio() {
        if (!head || headAudio || disposed) return;
        headAudio = await attachHeadAudio(head);
        headAudioReady = headAudio !== null;
      }

      async function loadAvatar() {
        if (head || disposed) return;
        btnStart.disabled = true;
        btnStart.textContent = "加载中…";
        try {
          head = new TalkingHead(
            avatarStage,
            createHeadOptions({
              cameraView: "full",
              cameraRotateEnable: false,
              cameraZoomEnable: false,
              cameraPanEnable: false,
            }),
          );
          await head.showAvatar(
            createAvatarConfig(),
            (event) => {
              if (event.lengthComputable && event.total) {
                btnStart.textContent = `加载 ${Math.round((event.loaded! / event.total) * 100)}%`;
              }
            },
          );
          if (disposed) return;
          if (import.meta.env.DEV) {
            (window as unknown as { __head?: unknown }).__head = head;
          }
          resolveHandBones();
          resolveArmBones();
          ikRuntime = null;
          await initializeHeadAudio();
          if (disposed) return;
          btnStart.remove();
          overlay.dataset.ready = "true";
          setAvatarAutoloadEnabled(true);
          askInput.disabled = false;
          btnAsk.disabled = false;
          askInput.placeholder = "问问大屏上的数据，比如：哪个区就业率最高？";
          setStatus("讲解员就绪（空闲时跟随鼠标）");
          askInput.focus();
          // Default: look toward screen center briefly so the gaze system is warm.
          const root = screenRoot.getBoundingClientRect();
          lookAtScreenPoint({ x: root.width / 2, y: root.height * 0.42 }, true);
        } catch (error) {
          console.error("[dashboard] avatar load failed", error);
          head?.stop();
          head = null;
          setAvatarAutoloadEnabled(false);
          btnStart.disabled = false;
          btnStart.textContent = "加载失败，点击重试";
        }
      }

      // ---- speech ----------------------------------------------------------

      function stopSpeech() {
        clearFocusTimers();
        if (overlayMoveTimer !== null) {
          window.clearTimeout(overlayMoveTimer);
          overlayMoveTimer = null;
        }
        window.speechSynthesis?.cancel();
        if (streamStarted) head?.streamInterrupt();
        head?.stopGesture(250);
      }

      function speakWithBrowserFallback(text: string, events: FocusEvent2[], sessionId: number) {
        if (!("speechSynthesis" in window) || !text.trim()) {
          endVoiceSession(sessionId);
          return;
        }
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = "zh-CN";
        utterance.onstart = () => {
          if (sessionId !== voiceSessionId) return;
          setStatus("浏览器播报中");
          scheduleFocusEvents(events, Math.max(2, Math.min(30, text.length * 0.22)));
        };
        const finish = () => {
          if (sessionId !== voiceSessionId) return;
          setStatus("讲解员就绪");
          endVoiceSession(sessionId);
          returnToDockSoon();
        };
        utterance.onend = finish;
        utterance.onerror = finish;
        window.speechSynthesis.speak(utterance);
      }

      async function speak(text: string, events: FocusEvent2[], sessionId: number) {
        if (!head || !text.trim()) {
          endVoiceSession(sessionId);
          return;
        }
        ttsController?.abort();
        const controller = new AbortController();
        ttsController = controller;
        setStatus("语音合成中");
        try {
          const response = await fetch(TTS_ENDPOINT, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ text: text.slice(0, 800) }),
            signal: controller.signal,
          });
          if (!response.ok) {
            const body = await response.json().catch(() => null);
            throw new Error(body?.error || `HTTP ${response.status}`);
          }
          const encodedAudio = await response.arrayBuffer();
          const decoder = new AudioContext();
          const audioBuffer = await decoder.decodeAudioData(encodedAudio.slice(0));
          await decoder.close();
          if (disposed || !head || sessionId !== voiceSessionId) {
            endVoiceSession(sessionId);
            return;
          }

          const pcm = audioBufferToPcm(audioBuffer);
          const timeline = headAudioReady ? null : createVisemeTimeline(audioBuffer);
          await head.streamStart(
            {
              lipsyncType: "visemes",
              sampleRate: audioBuffer.sampleRate,
              gain: 1,
            },
            () => {
              if (sessionId !== voiceSessionId) return;
              setStatus("讲解中");
              scheduleFocusEvents(events, audioBuffer.duration);
            },
            () => {
              if (sessionId !== voiceSessionId) return;
              setStatus("讲解员就绪");
              endVoiceSession(sessionId);
              returnToDockSoon();
            },
          );
          if (sessionId !== voiceSessionId) return;
          streamStarted = true;
          head.streamAudio({ audio: pcm, ...(timeline ?? {}) });
          head.streamNotifyEnd();
        } catch (error) {
          if ((error as Error).name === "AbortError" || disposed) {
            endVoiceSession(sessionId);
            return;
          }
          console.warn("[dashboard] CosyVoice unavailable, browser TTS fallback", error);
          speakWithBrowserFallback(text, events, sessionId);
        } finally {
          if (ttsController === controller) ttsController = null;
        }
      }

      // ---- ask flow ----------------------------------------------------------

      async function ask(prompt: string) {
        const question = prompt.trim();
        if (!question || !head || disposed) return;
        requestController?.abort();
        stopSpeech();
        clearFocusHighlights();
        askInput.value = "";
        setFadingVisibility(answerText, true);
        answerText.textContent = "思考中…";
        setStatus("思考中");
        btnAsk.disabled = true;
        const sessionId = beginVoiceSession();
        requestController = new AbortController();
        try {
          const response = await fetch(GUIDE_ENDPOINT, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              prompt: question.slice(0, 500),
              context: guideContext,
              panels: panels.map((panel) => ({
                ...panel,
                anchors: (PANEL_ANCHORS[panel.id] ?? []).map((anchor) => anchor.id),
              })),
            }),
            signal: requestController.signal,
          });
          if (!response.ok) throw new Error(`接口异常（HTTP ${response.status}）`);
          const reply = (await response.json()) as { ok: boolean; message: GuideMessage };
          const message = reply.message;
          if (message?.type !== "avatar_response" || message.version !== 2) {
            throw new Error("回复消息协议不兼容");
          }
          const answer = message.speech?.text?.trim() ?? "";
          activeFocusHint = `${question} ${answer}`.toLowerCase();
          const events = Array.isArray(message.timeline)
            ? message.timeline.filter((event) => event?.type === "focus")
            : [];
          answerText.textContent = answer || "没有收到回复";
          if (!disposed && answer && sessionId === voiceSessionId) void speak(answer, events, sessionId);
          else {
            setStatus("讲解员就绪");
            endVoiceSession(sessionId);
          }
        } catch (error) {
          if ((error as Error).name !== "AbortError") {
            answerText.textContent = `请求失败：${(error as Error).message}`;
            setStatus("请求失败");
          }
          endVoiceSession(sessionId);
        } finally {
          requestController = null;
          if (!disposed) btnAsk.disabled = false;
        }
      }

      function disposePage() {
        if (disposed) return;
        disposed = true;
        lifecycleController.abort();
        requestController?.abort();
        ttsController?.abort();
        stopSpeech();
        headAudio?.stop();
        headAudio?.disconnect();
        headAudio = null;
        if (streamStarted) head?.streamStop();
        head?.stop();
        head = null;
        endVoiceSession();
        if (ikRuntime) {
          ikRuntime.leftTarget.parent?.remove(ikRuntime.leftTarget);
          ikRuntime.rightTarget.parent?.remove(ikRuntime.rightTarget);
          ikRuntime = null;
        }
        handBones = null;
        armBones = null;
        armBaseRotations = null;
        currentAimTarget = null;
        if (aimRaf) {
          window.cancelAnimationFrame(aimRaf);
          aimRaf = 0;
        }
      }

      function handleMousePointing(event: MouseEvent) {
        if (!isMouseLookEnabled()) return;
        const root = screenRoot.getBoundingClientRect();
        const target = {
          x: event.clientX - root.left,
          y: event.clientY - root.top,
        };
        setFocusDot(target);
        if (lastMouseTarget) {
          const dx = target.x - lastMouseTarget.x;
          const dy = target.y - lastMouseTarget.y;
          if (Math.sqrt(dx * dx + dy * dy) < MOUSE_POINT_MIN_DELTA_PX) return;
        }
        lastMouseTarget = target;
        lookAtScreenPoint(target);
      }

      moveToDock({ instant: true });
      window.addEventListener("resize", () => {
        if (!overlay.dataset.focusTarget) moveToDock({ instant: true });
      });

      btnStart.addEventListener("click", loadAvatar);
      if (isAvatarAutoloadEnabled()) {
        queueMicrotask(() => {
          if (!disposed) void loadAvatar();
        });
      }
      askBar.addEventListener("submit", (event) => {
        event.preventDefault();
        ask(askInput.value);
      });
      document.querySelectorAll<HTMLButtonElement>(".chip").forEach((chip) => {
        chip.addEventListener("click", () => {
          if (head) ask(chip.textContent || "");
          else askInput.value = chip.textContent || "";
        });
      });
      screenRoot.addEventListener("mousemove", handleMousePointing, {
        signal: lifecycleController.signal,
      });
      screenRoot.addEventListener(
        "mouseleave",
        () => {
          if (!overlay.dataset.focusTarget) setFocusDot(null);
          lastMouseTarget = null;
        },
        { signal: lifecycleController.signal },
      );

      window.addEventListener("pagehide", disposePage, {
        signal: lifecycleController.signal,
      });
      window.addEventListener("beforeunload", disposePage, {
        signal: lifecycleController.signal,
      });
    </script>
  </body>
</html>
