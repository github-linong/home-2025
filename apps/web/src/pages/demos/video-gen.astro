  function fileToDataUrl(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  /**
   * Validate image dimensions and return { width, height, valid, error }
   */
  function validateImageDimensions(dataUrl, minWidth = 300, minHeight = 300, maxAspectRatio = 2.5) {
    return new Promise((resolve) => {
      const img = new Image();
      img.onload = () => {
        const { width, height } = img;
        const aspectRatio = Math.max(width / height, height / width);
        if (width < minWidth || height < minHeight) {
          resolve({ width, height, valid: false, error: `图片尺寸 ${width}×${height}，要求最小 ${minWidth}×${minHeight}` });
        } else if (aspectRatio > maxAspectRatio) {
          resolve({ width, height, valid: false, error: `图片宽高比超出范围（最大 1:${maxAspectRatio}）` });
        } else {
          resolve({ width, height, valid: true });
        }
      };
      img.onerror = () => resolve({ valid: false, error: "无法读取图片尺寸" });
      img.src = dataUrl;
    });
  }

  /* ---- Example prompts ---- */
  document.querySelectorAll(".prompt-example").forEach((btn) => {
    btn.addEventListener("click", () => { promptEl.value = btn.dataset.prompt || ""; promptEl.focus(); });
  });

  /* ---- Status helpers ---- */
  function showStatus(msg, type = "info") {
    statusBox.classList.remove("hidden", "border-success", "border-error", "border-warning", "text-success", "text-error", "text-warning");
    statusBox.classList.add(type === "error" ? "border-error" : type === "success" ? "border-success" : "border-warning");
    statusBox.classList.add(type === "error" ? "text-error" : type === "success" ? "text-success" : "text-warning");
    statusBox.textContent = msg;
  }
  function hideStatus() { statusBox.classList.add("hidden"); }

  function setGenerating(value) {
    generating = value;
    btnGenerate.disabled = value;
    btnSpinner.classList.toggle("hidden", !value);
    btnLabel.textContent = value ? "生成中…" : "🎬 生成视频";
  }

  /* ---- Timer ---- */
  function startTimer() {
    const start = Date.now();
    timerInterval = setInterval(() => {
      const sec = Math.floor((Date.now() - start) / 1000);
      progressTimer.textContent = `${String(Math.floor(sec / 60)).padStart(2, "0")}:${String(sec % 60).padStart(2, "0")}`;
    }, 1000);
  }
  function stopTimer() {
    if (timerInterval) { clearInterval(timerInterval); timerInterval = null; }
  }

  /* ---- Cancel (hide progress, let API finish in background) ---- */
  btnCancelGen.addEventListener("click", () => {
    progressArea.classList.add("hidden");
    stopTimer();
    setGenerating(false);
  });

  /* ---- Generate ---- */
  btnGenerate.addEventListener("click", async () => {
    if (generating) return;
    const prompt = promptEl.value.trim();
    if (!prompt) { showStatus("请输入视频描述", "error"); promptEl.focus(); return; }

    const m = getCurrentModel();
    if (m.type === "i2v" && !refImageDataUrl) { showStatus("图生视频模式需要上传首帧参考图", "error"); return; }
    if (m.type === "videoedit" && !videoDataUrl) { showStatus("视频编辑模式需要上传待编辑视频", "error"); return; }
    if (m.type === "r2v" && !refImageDataUrls.length && !refVideoDataUrl) { showStatus("参考生视频需要至少一张参考图或一个参考视频", "error"); return; }

    hideStatus();
    setGenerating(true);

    // Show progress
    videoPlaceholder.classList.add("hidden");
    resultVideo.classList.add("hidden");
    progressArea.classList.remove("hidden");
    progressModel.textContent = m.label;
    progressText.textContent = "正在生成，通常需要 1-5 分钟…";
    progressTimer.textContent = "00:00";
    startTimer();

    if (currentBlobUrl) { URL.revokeObjectURL(currentBlobUrl); currentBlobUrl = null; }

    try {
      const body = {
        prompt,
        model: modelEl.value,
      };

      // Prompt extend (only for models that support it)
      if (m.promptExtend || m.type === "videoedit") {
        body.prompt_extend = promptExtendToggle.checked;
      }

      // Size params
      if (m.paramStyle === "resolution") {
        body.resolution = resolutionEl.value;
        if (m.ratios) body.ratio = ratioEl.value;
      } else if (m.sizes) {
        body.size = sizeEl.value;
      }

      // Duration
      const dur = parseInt(durationSlider.value, 10);
      if (dur >= (m.minDuration || 5) && dur <= (m.maxDuration || 5)) body.duration = dur;

      const neg = negativePromptEl.value.trim();
      if (neg) body.negative_prompt = neg;

      const seed = seedInput.value.trim();
      if (seed) body.seed = parseInt(seed, 10);

      // Image URL for i2v models (first_frame) or r2v models (first_frame optional)
      if ((m.type === "i2v" || m.supportsFirstFrame) && refImageDataUrl) body.img_url = refImageDataUrl;

      // Last frame URL (wan2.7-i2v)
      if (m.supportsLastFrame && lastFrameDataUrl) body.last_frame_url = lastFrameDataUrl;

      // Driving audio URL (wan2.7-i2v)
      if (m.supportsDrivingAudio && drivingAudioDataUrl) body.driving_audio_url = drivingAudioDataUrl;

      // External audio URL (wan2.7-t2v)
      if (m.supportsAudioUrl && audioUrlDataUrl) body.audio_url = audioUrlDataUrl;

      // Video URL for videoedit
      if (m.requiresVideo && videoDataUrl) body.video_url = videoDataUrl;

      // Reference video URL (wan2.7-r2v)
      if (m.supportsRefVideo && refVideoDataUrl) body.ref_video_url = refVideoDataUrl;

      // Reference voice URL (wan2.7-r2v)
      if (m.supportsRefVoice && refVoiceDataUrl) body.ref_voice_url = refVoiceDataUrl;

      // Reference images for videoedit or r2v (multi-image)
      if ((m.type === "videoedit" || m.type === "r2v") && refImageDataUrls.length) body.ref_images = refImageDataUrls;

      // Watermark
      if (m.watermark) body.watermark = watermarkToggle.checked;

      // Audio setting (videoedit)
      if (m.audioSetting) body.audio_setting = audioSettingSelect.value;

      const response = await fetch("/api/demo/video", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      });

      if (!response.ok) {
        const ct = response.headers.get("content-type") || "";
        let message = `HTTP ${response.status}`;
        if (ct.includes("application/json")) {
          const err = await response.json().catch(() => ({}));
          message = err.message || err.error || message;
        } else {
          const text = await response.text().catch(() => "");
          if (response.status === 504 || response.status === 502 || response.status === 503) {
            message = "网关超时或服务暂不可用，视频生成可能需要数分钟，请稍后重试";
          } else if (text && !text.includes("<!DOCTYPE")) {
            message = text.slice(0, 200);
          }
        }
        throw new Error(message);
      }

      const blob = await response.blob();
      currentBlobUrl = URL.createObjectURL(blob);

      // Show video
      resultVideo.src = currentBlobUrl;
      resultVideo.classList.remove("hidden");
      progressArea.classList.add("hidden");
      btnDownload.classList.remove("hidden");
      btnDownload.disabled = false;

      const totalSec = (parseInt(response.headers.get("X-Gen-Total-Ms") || "0") / 1000).toFixed(1);
      const videoMB = response.headers.get("X-Gen-Video-MB") || "?";
      showStatus(`${m.label} 生成完成！${totalSec}s · ${videoMB}MB`, "success");
      saveState();
    } catch (err) {
      console.error("[video-gen] failed:", err);
      showStatus(`生成失败：${err.message}`, "error");
      progressArea.classList.add("hidden");
      videoPlaceholder.classList.remove("hidden");
      btnDownload.classList.add("hidden");
    } finally {
      stopTimer();
      setGenerating(false);
    }
  });

  /* ---- Download ---- */
  btnDownload.addEventListener("click", () => {
    if (!currentBlobUrl) return;
    const a = document.createElement("a");
    a.href = currentBlobUrl;
    a.download = `ai-video-${Date.now()}.mp4`;
    a.click();
  });

  /* ---- Ctrl+Enter shortcut ---- */
  promptEl.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) { e.preventDefault(); btnGenerate.click(); }
  });

  /* ---- Init ---- */
  loadModels();
</script>
