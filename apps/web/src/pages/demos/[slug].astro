---
import { CollectionEntry, getCollection } from "astro:content";
import { DemoSchema } from "../../content/config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import createSlug from "../../lib/createSlug";

export async function getStaticPaths() {
  const entries = await getCollection("demos");
  return entries.map((entry) => ({
    params: { slug: createSlug(entry.data.title, entry.slug) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"demos">;
}

const { entry } = Astro.props;
const demo: DemoSchema = entry.data;
const { Content } = await entry.render();

const blogPosts =
  demo.relatedPosts?.length ?
    (await getCollection("blog")).filter((p) => demo.relatedPosts!.includes(p.slug))
  : [];

const typeLabels: Record<string, string> = {
  web: "Web",
  desktop: "Desktop",
  cli: "CLI",
  external: "External",
  embed: "Embed",
};

const isLegacy = demo.tags?.includes("legacy");
---

<BaseLayout
  title={demo.title}
  sideBarActiveItemID="demos"
  mainClass="p-6 pt-10 w-full max-w-[100vw] lg:max-w-[1200px]"
>
  <article class="prose max-w-none">
    <div class="not-prose mb-6">
      <a href={isLegacy ? "/demos/archive/" : "/demos/"} class="link link-hover text-sm" data-astro-reload>
        ← {isLegacy ? "Demo 归档" : "项目展示"}
      </a>
      <h1 class="text-4xl font-bold mt-2">{demo.title}</h1>
      <p class="text-lg opacity-80 mt-2">{demo.description}</p>
      <div class="flex flex-wrap gap-2 mt-4">
        <span class="badge badge-primary">{typeLabels[demo.type] ?? demo.type}</span>
        {demo.category && <span class="badge badge-secondary">{demo.category}</span>}
        {demo.badge && <span class="badge badge-outline">{demo.badge}</span>}
        {
          demo.tags?.map((tag) => (
            <span class="badge badge-ghost">{tag}</span>
          ))
        }
      </div>
      <div class="flex flex-wrap gap-3 mt-6">
        {
          demo.demoUrl && (
            <a
              class="btn btn-primary"
              href={demo.demoUrl}
              data-astro-reload
              target="_blank"
              rel="noreferrer"
            >
              新窗口打开
            </a>
          )
        }
        {
          demo.legacyUrl && (
            <span class="text-sm opacity-60 self-center">
              原路径 <code>{demo.legacyUrl}</code>
            </span>
          )
        }
        {
          demo.repoUrl && (
            <a class="btn btn-outline" href={demo.repoUrl} target="_blank" rel="noreferrer">
              源码仓库
            </a>
          )
        }
      </div>
    </div>

    {
      demo.type === "web" && demo.demoUrl && (
        <div class="not-prose my-8">
          <div class="text-sm font-semibold mb-2">在线预览</div>
          <iframe
            src={demo.demoUrl}
            title={demo.title}
            class="w-full h-[480px] rounded-lg border border-base-300 bg-base-100"
            loading="lazy"></iframe>
        </div>
      )
    }

    {
      entry.body.trim().length > 0 && <Content />
    }

    {
      blogPosts.length > 0 && (
        <div class="not-prose mb-8 mt-8">
          <div class="text-sm font-semibold mb-3">相关文章</div>
          <ul class="space-y-2">
            {
              blogPosts.map((post) => (
                <li>
                  <a class="link link-hover" href={`/blog/${post.slug}/`}>
                    {post.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      )
    }
  </article>
</BaseLayout>
