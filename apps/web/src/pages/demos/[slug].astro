---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import type { DemoSchema } from "../../content/config";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ViewBeacon from "../../components/ViewBeacon.astro";
import createSlug from "../../lib/createSlug";
import { SITE_AUTHOR } from "../../config";
import { profile } from "../../data/profile";
import {
  buildCanonicalUrl,
  buildCreativeWorkJsonLd,
  buildPersonJsonLd,
} from "../../lib/seo.mjs";

export async function getStaticPaths() {
  const entries = await getCollection("demos");
  return entries.map((entry) => ({
    params: { slug: createSlug(entry.data.title, entry.slug) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"demos">;
}

const { entry } = Astro.props;
const demo: DemoSchema = entry.data;
const pathSlug = createSlug(demo.title, entry.slug);
const { Content } = await entry.render();

const blogPosts =
  demo.relatedPosts?.length ?
    (await getCollection("blog")).filter((p) => demo.relatedPosts!.includes(p.slug))
  : [];

const typeLabels: Record<string, string> = {
  web: "Web",
  desktop: "Desktop",
  cli: "CLI",
  external: "External",
  embed: "Embed",
};

const isLegacy = demo.tags?.includes("legacy");

const siteBase = Astro.site?.href ?? "https://www.lilnong.top/";
const pageCanonical = buildCanonicalUrl(siteBase, Astro.url);
const datePublished = new Date(demo.pubDate).toISOString();
const modifiedCandidate = demo.updatedDate ? new Date(demo.updatedDate) : null;
const dateModified =
  modifiedCandidate && !Number.isNaN(modifiedCandidate.valueOf())
    ? modifiedCandidate.toISOString()
    : datePublished;
const demoJsonLd = buildCreativeWorkJsonLd({
  name: demo.title,
  description: demo.description,
  url: pageCanonical,
  datePublished,
  dateModified,
  image: demo.heroImage ? new URL(demo.heroImage, siteBase).href : undefined,
  author: buildPersonJsonLd({
    name: SITE_AUTHOR,
    url: profile.site,
    description: profile.tagline,
  }),
});
---

<BaseLayout
  title={demo.title}
  description={demo.description}
  image={demo.heroImage}
  sideBarActiveItemID="demos"
  canonical={pageCanonical}
  jsonLd={demoJsonLd}
  publishedTime={datePublished}
  modifiedTime={dateModified}
>
  <article class="prose max-w-none" data-pagefind-body>
    <div class="not-prose mb-6">
      <span data-pagefind-meta="title" class="hidden">{demo.title}</span>
      <span data-pagefind-meta="description" class="hidden">{demo.description}</span>
      {demo.badge && <span data-pagefind-meta="badge" class="hidden">{demo.badge}</span>}
      {demo.category && <span data-pagefind-meta="category" class="hidden">{demo.category}</span>}
      {demo.category && <span data-pagefind-filter={`tag:${demo.category}`} class="hidden" />}
      {demo.tags?.map((tag) => <span data-pagefind-filter={`tag:${tag}`} class="hidden" />)}
      <a href={isLegacy ? "/demos/archive/" : "/demos/"} class="link link-hover text-sm" data-astro-reload>
        ← {isLegacy ? "Demo 归档" : "项目展示"}
      </a>
      <h1 class="text-4xl font-bold mt-2">{demo.title}</h1>
      <p class="text-lg opacity-80 mt-2">{demo.description}</p>
      {
        demo.heroImage && (
          <Image
            src={demo.heroImage}
            width={1200}
            height={675}
            format="webp"
            alt={demo.title}
            class="w-full max-h-72 object-cover rounded-lg mt-4"
          />
        )
      }
      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm opacity-60">
        {
          (() => {
            const published = demo.pubDate.toISOString().slice(0, 10);
            const updated = demo.updatedDate?.toISOString().slice(0, 10);
            if (updated && updated !== published) {
              return (
                <>
                  <time datetime={demo.pubDate.toISOString()}>发布于 {published}</time>
                  <time datetime={demo.updatedDate!.toISOString()}>更新于 {updated}</time>
                </>
              );
            }
            return (
              <time datetime={(demo.updatedDate ?? demo.pubDate).toISOString()}>
                更新于 {updated || published}
              </time>
            );
          })()
        }
      </div>
      <div class="flex flex-wrap gap-2 mt-4">
        <span class="badge badge-primary">{typeLabels[demo.type] ?? demo.type}</span>
        {
          demo.category && (
            <a class="badge badge-secondary" href={`/search/?tag=${encodeURIComponent(demo.category)}`}>
              {demo.category}
            </a>
          )
        }
        {demo.badge && <span class="badge badge-outline">{demo.badge}</span>}
        {
          demo.tags?.map((tag) => (
            <a class="badge badge-ghost" href={`/search/?tag=${encodeURIComponent(tag)}`}>
              {tag}
            </a>
          ))
        }
      </div>
      <div class="flex flex-wrap gap-3 mt-6">
        {
          demo.demoUrl && (
            <a
              class="btn btn-primary"
              href={demo.demoUrl}
              data-astro-reload
              target="_blank"
              rel="noreferrer"
            >
              新窗口打开
            </a>
          )
        }
        {
          demo.legacyUrl && (
            <span class="text-sm opacity-60 self-center">
              原路径 <code>{demo.legacyUrl}</code>
            </span>
          )
        }
        {
          demo.repoUrl && (
            <a class="btn btn-outline" href={demo.repoUrl} target="_blank" rel="noreferrer">
              源码仓库
            </a>
          )
        }
      </div>
    </div>

    {
      demo.type === "web" && demo.demoUrl && (
        <div class="not-prose my-8">
          <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <div class="text-sm font-semibold">在线预览</div>
            <a class="link link-hover text-sm" href={demo.demoUrl} target="_blank" rel="noreferrer" data-astro-reload>
              全屏打开
            </a>
          </div>
          <iframe
            src={demo.demoUrl}
            title={demo.title}
            class:list={[
              "w-full rounded-lg border border-base-300",
              demo.demoUrl.includes("/demos/project/") ? "h-[min(85vh,900px)] bg-[#0b1220]" : "h-[480px] bg-base-100",
            ]}
            loading="lazy"></iframe>
        </div>
      )
    }

    {
      entry.body.trim().length > 0 && <Content />
    }

    {
      blogPosts.length > 0 && (
        <div class="not-prose mb-8 mt-8">
          <div class="text-sm font-semibold mb-3">相关文章</div>
          <ul class="space-y-2">
            {
              blogPosts.map((post) => (
                <li>
                  <a class="link link-hover" href={`/blog/${post.slug}/`}>
                    {post.data.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      )
    }
  </article>
  <ViewBeacon type="demo" slug={pathSlug} />
</BaseLayout>
