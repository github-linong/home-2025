---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HorizontalCard from "../../components/HorizontalCard.astro";
import { getCollection } from "astro:content";
import createSlug from "../../lib/createSlug";
import { CURATED_DEMO_SECTIONS } from "../../data/curated-demos";

const allDemos = await getCollection("demos");
const bySlug = new Map(allDemos.map((d) => [d.slug, d]));

const isLegacy = (d: (typeof allDemos)[0]) => d.data.tags?.includes("legacy");

const featured = allDemos
  .filter((d) => !isLegacy(d))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const blogLinked = allDemos
  .filter((d) => isLegacy(d) && (d.data.relatedPosts?.length ?? 0) > 0)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "zh"));

/** Blog-linked slugs so curated sections don't duplicate them */
const blogLinkedSlugs = new Set(blogLinked.map((d) => d.slug));

const curatedSections = CURATED_DEMO_SECTIONS.map((section) => {
  const demos = section.slugs
    .map((slug) => bySlug.get(slug))
    .filter((d): d is NonNullable<typeof d> => !!d && !blogLinkedSlugs.has(d.slug));
  return { ...section, demos };
}).filter((s) => s.demos.length > 0);

const legacyCount = allDemos.filter(isLegacy).length;
const curatedCount = curatedSections.reduce((n, s) => n + s.demos.length, 0);

function demoUrl(demo: (typeof allDemos)[0]) {
  return "/demos/" + createSlug(demo.data.title, demo.slug);
}
---

<BaseLayout
  title="项目展示"
  sideBarActiveItemID="demos"
  mainClass="p-6 pt-10 w-full max-w-[100vw] lg:max-w-[1200px]"
>
  <div>
    <div class="text-3xl w-full font-bold mb-2">项目展示</div>
    <p class="opacity-80 mb-6">
      开源项目、精选实验与博客配套 Demo。除文章引用外，另整理了媒体、AI、移动端、工程能力等有独立价值的示例。
    </p>
  </div>

  {
    featured.length > 0 && (
      <>
        <h2 class="text-xl font-semibold mb-4">精选项目</h2>
        {featured.map((demo) => (
          <>
            <HorizontalCard
              title={demo.data.title}
              img={demo.data.heroImage}
              desc={demo.data.description}
              url={demoUrl(demo)}
              target="_self"
              badge={demo.data.badge}
              tags={demo.data.tags}
            />
            <div class="divider my-0" />
          </>
        ))}
      </>
    )
  }

  {
    blogLinked.length > 0 && (
      <>
        <h2 class="text-xl font-semibold mb-2 mt-6">博客配套 Demo</h2>
        <p class="text-sm opacity-70 mb-4">
          本站文章中直接引用的 {blogLinked.length} 个交互示例。
        </p>
        {blogLinked.map((demo) => (
          <>
            <HorizontalCard
              title={demo.data.title}
              img={demo.data.heroImage}
              desc={demo.data.description}
              url={demoUrl(demo)}
              target="_self"
              badge={demo.data.badge}
              tags={demo.data.tags}
            />
            <div class="divider my-0" />
          </>
        ))}
      </>
    )
  }

  {
    curatedSections.length > 0 && (
      <>
        <h2 class="text-xl font-semibold mb-2 mt-8">精选实验</h2>
        <p class="text-sm opacity-70 mb-6">
          从历史 Demo 中挑出的 {curatedCount} 个有独立技术价值的示例（未全部出现在博客正文）。
        </p>
        {curatedSections.map((section) => (
          <section class="mb-8">
            <h3 class="text-lg font-semibold mb-1">{section.title}</h3>
            <p class="text-sm opacity-70 mb-3">{section.description}</p>
            {section.demos.map((demo) => (
              <>
                <HorizontalCard
                  title={demo.data.title}
                  img={demo.data.heroImage}
                  desc={demo.data.description}
                  url={demoUrl(demo)}
                  target="_self"
                  badge={demo.data.badge}
                  tags={demo.data.tags}
                />
                <div class="divider my-0" />
              </>
            ))}
          </section>
        ))}
      </>
    )
  }

  {
    legacyCount > 0 && (
      <div class="alert alert-info mt-6">
        <div>
          <div class="font-semibold">全部历史 Demo（{legacyCount} 个）</div>
          <div class="text-sm opacity-90">
            含 Bug 复现、思否配套与一次性实验；可按分类搜索浏览。
          </div>
        </div>
        <a href="/demos/archive/" class="btn btn-sm btn-primary" data-astro-reload>
          浏览全部
        </a>
      </div>
    )
  }
</BaseLayout>
