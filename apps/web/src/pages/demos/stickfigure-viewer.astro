---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="火柴人 3D 模型查看器"
  description="使用 Three.js 加载程序化生成的火柴人 GLB 模型，支持旋转、缩放。"
>
  <div class="prose mb-4 max-w-none">
    <h1>火柴人 3D 模型查看器</h1>
    <p class="opacity-80">
      程序化生成的火柴人 GLB 模型（78 KB，1838 顶点），拖拽旋转 · 滚轮缩放 · 右键平移。
    </p>
  </div>

  <div class="grid gap-4 lg:grid-cols-[1fr_280px]">
    <!-- 3D 渲染区域 -->
    <section class="overflow-hidden rounded-box border border-base-300 bg-base-200">
      <div id="viewer" class="relative aspect-square w-full bg-gradient-to-b from-slate-800 to-slate-900">
        <div
          id="loadingHint"
          class="absolute inset-0 z-10 flex items-center justify-center text-sm text-white/60"
        >
          加载模型中…
        </div>
      </div>
      <div class="flex items-center justify-between gap-3 border-t border-base-300 p-3">
        <div class="flex gap-2">
          <button id="btnReset" class="btn btn-sm">重置视角</button>
          <button id="btnWireframe" class="btn btn-sm">线框模式</button>
          <button id="btnRotate" class="btn btn-sm btn-active">自动旋转</button>
        </div>
        <span id="infoLabel" class="badge badge-outline text-xs">Three.js r180</span>
      </div>
    </section>

    <!-- 模型信息面板 -->
    <aside class="flex flex-col gap-3">
      <div class="rounded-box border border-base-300 bg-base-100 p-4">
        <h2 class="mb-2 text-sm font-semibold">模型参数</h2>
        <dl class="space-y-1 text-xs">
          <div class="flex justify-between"><dt class="opacity-60">格式</dt><dd>GLB (glTF 2.0)</dd></div>
          <div class="flex justify-between"><dt class="opacity-60">大小</dt><dd>78 KB</dd></div>
          <div class="flex justify-between"><dt class="opacity-60">顶点</dt><dd>1,838</dd></div>
          <div class="flex justify-between"><dt class="opacity-60">三角面</dt><dd>2,032</dd></div>
          <div class="flex justify-between"><dt class="opacity-60">部件</dt><dd>19 个几何体</dd></div>
          <div class="flex justify-between"><dt class="opacity-60">着色</dt><dd>顶点颜色 (Vertex Colors)</dd></div>
        </dl>
      </div>

      <div class="rounded-box border border-base-300 bg-base-100 p-4">
        <h2 class="mb-2 text-sm font-semibold">组成</h2>
        <ul class="space-y-1 text-xs opacity-80">
          <li>🟡 头部 — 球体 + 头发 + 双眼</li>
          <li>🔵 上身 — 蓝色衬衫 + 脖子</li>
          <li>⬛ 下身 — 深色裤子 + 臀部</li>
          <li>🟡 双臂 — 上臂 + 前臂 + 手掌</li>
          <li>⬛ 双腿 — 大腿 + 小腿 + 鞋子</li>
        </ul>
      </div>

      <div class="rounded-box border border-base-300 bg-base-100 p-4">
        <h2 class="mb-2 text-sm font-semibold">操作</h2>
        <ul class="space-y-1 text-xs opacity-80">
          <li>🖱️ 左键拖拽 — 旋转</li>
          <li>🖱️ 滚轮 — 缩放</li>
          <li>🖱️ 右键拖拽 — 平移</li>
        </ul>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  import * as THREE from "three";
  import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
  import { GLTFLoader } from "three/examples/jsm/loaders/GLTFLoader.js";

  const viewer = document.getElementById("viewer")!;
  const loadingHint = document.getElementById("loadingHint")!;
  const btnReset = document.getElementById("btnReset") as HTMLButtonElement;
  const btnWireframe = document.getElementById("btnWireframe") as HTMLButtonElement;
  const btnRotate = document.getElementById("btnRotate") as HTMLButtonElement;

  // ── Scene setup ──
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x1e293b); // slate-800

  const camera = new THREE.PerspectiveCamera(45, viewer.clientWidth / viewer.clientHeight, 0.1, 100);
  camera.position.set(0, 1.2, 3.5);

  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setPixelRatio(window.devicePixelRatio);
  renderer.setSize(viewer.clientWidth, viewer.clientHeight);
  renderer.outputColorSpace = THREE.SRGBColorSpace;
  viewer.appendChild(renderer.domElement);

  // ── Controls ──
  const controls = new OrbitControls(camera, renderer.domElement);
  controls.target.set(0, 0.9, 0);
  controls.enableDamping = true;
  controls.dampingFactor = 0.08;
  controls.autoRotate = true;
  controls.autoRotateSpeed = 1.5;
  controls.update();

  // ── Lighting ──
  const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
  scene.add(ambientLight);

  const keyLight = new THREE.DirectionalLight(0xfff5e6, 1.2);
  keyLight.position.set(3, 5, 4);
  scene.add(keyLight);

  const fillLight = new THREE.DirectionalLight(0xe6f0ff, 0.4);
  fillLight.position.set(-3, 2, -2);
  scene.add(fillLight);

  const rimLight = new THREE.DirectionalLight(0xffffff, 0.3);
  rimLight.position.set(0, 3, -5);
  scene.add(rimLight);

  // ── Ground plane (subtle grid) ──
  const gridHelper = new THREE.GridHelper(4, 20, 0x475569, 0x334155);
  gridHelper.position.y = 0;
  scene.add(gridHelper);

  // ── Load model ──
  let currentMesh: THREE.Mesh | null = null;
  let wireframeOn = false;

  const loader = new GLTFLoader();
  loader.load(
    "/models/stickfigure.glb",
    (gltf) => {
      const model = gltf.scene;

      // Enable vertex colors on all meshes
      model.traverse((child) => {
        if ((child as THREE.Mesh).isMesh) {
          const mesh = child as THREE.Mesh;
          const mat = mesh.material as THREE.MeshStandardMaterial;
          mat.vertexColors = true;
          mat.roughness = 0.65;
          mat.metalness = 0.0;
          mat.needsUpdate = true;
          currentMesh = mesh;
        }
      });

      scene.add(model);
      loadingHint.remove();
    },
    undefined,
    (error) => {
      loadingHint.textContent = `模型加载失败：${error}`;
      console.error("[stickfigure-viewer] load error", error);
    },
  );

  // ── UI buttons ──
  btnReset.addEventListener("click", () => {
    camera.position.set(0, 1.2, 3.5);
    controls.target.set(0, 0.9, 0);
    controls.update();
  });

  btnWireframe.addEventListener("click", () => {
    wireframeOn = !wireframeOn;
    if (currentMesh) {
      (currentMesh.material as THREE.MeshStandardMaterial).wireframe = wireframeOn;
    }
    btnWireframe.classList.toggle("btn-active", wireframeOn);
  });

  btnRotate.addEventListener("click", () => {
    controls.autoRotate = !controls.autoRotate;
    btnRotate.classList.toggle("btn-active", controls.autoRotate);
  });

  // ── Resize ──
  const resizeObserver = new ResizeObserver(() => {
    const w = viewer.clientWidth;
    const h = viewer.clientHeight;
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
  });
  resizeObserver.observe(viewer);

  // ── Render loop ──
  function animate() {
    requestAnimationFrame(animate);
    controls.update();
    renderer.render(scene, camera);
  }
  animate();

  // ── Cleanup ──
  function dispose() {
    resizeObserver.disconnect();
    renderer.dispose();
    controls.dispose();
  }

  document.addEventListener("astro:before-swap", dispose, { once: true });
  window.addEventListener("pagehide", dispose, { once: true });
</script>
