---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import ContentSortList from "../components/ContentSortList.astro";
import { getCollection } from "astro:content";
import createSlug from "../lib/createSlug";
import { SITE_AUTHOR, SITE_TAGLINE, SITE_SUBTITLE } from "../config";
import { getHomeDemoPicks } from "../lib/demoHighlights";
import { excludeNoticePosts } from "../lib/systemNotices.mjs";

const posts = excludeNoticePosts(await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const lastPosts = posts.slice(0, 5);

const allDemos = await getCollection("demos");
const homePicks = getHomeDemoPicks(allDemos);
const homeShow = homePicks.slice(0, 6);
---

<BaseLayout
  sideBarActiveItemID="home"
  description="lilnong.top 是前端工程师 linong 的个人站：覆盖前端基础、工程化与 AI 实践的技术博客，数百个可在线运行的前端 Demo，以及数字人、AI 生图与视频实验。"
>
  <header class="pb-12 mt-5">
    <h1 class="text-5xl font-bold">{SITE_AUTHOR}</h1>
    <p class="text-3xl py-3 font-bold m-0">{SITE_TAGLINE}</p>
    <div class="py-2">
      <p class="text-lg">{SITE_SUBTITLE}</p>
    </div>
  </header>

  <div class="mb-8">
    <div class="mb-2 flex flex-wrap items-end justify-between gap-3">
      <h2 class="text-3xl font-bold m-0">精选项目</h2>
      <a href="/demos/" class="btn btn-ghost btn-sm">全部项目 →</a>
    </div>
    <p class="opacity-70 mb-4 text-sm">
      精选实验与博客配套 Demo，可按最新或热度浏览。
    </p>

    {
      homePicks.length === 0 ? (
        <p class="opacity-70">暂无精选项目。</p>
      ) : (
        <ContentSortList
          kind="demo"
          catalogKey="home-demo"
          catalogUrl="/data/home-demo-catalog.json"
          pageSize={6}
          defaultSort="date"
          sortModes={["date", "hot"]}
        >
          {
            homeShow.map((demo) => (
              <>
                <HorizontalCard
                  title={demo.data.title}
                  img={demo.data.heroImage}
                  desc={demo.data.description}
                  url={"/demos/" + createSlug(demo.data.title, demo.slug)}
                  target="_self"
                  badge={demo.data.badge}
                  tags={demo.data.tags}
                  pubDate={demo.data.pubDate}
                  updatedDate={demo.data.updatedDate}
                  category={demo.data.category}
                  dateAsUpdate={true}
                />
                <div class="divider my-0" />
              </>
            ))
          }
        </ContentSortList>
      )
    }
  </div>

  <div>
    <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
      <h2 class="text-3xl font-bold m-0">最新文章</h2>
      <a href="/blog/" class="btn btn-ghost btn-sm">全部文章 →</a>
    </div>
  </div>

  {
    lastPosts.length === 0 ? (
      <p class="opacity-70">暂无文章。</p>
    ) : (
      lastPosts.map((post) => (
        <>
          <HorizontalCard
            title={post.data.title}
            img={post.data.heroImage}
            desc={post.data.description}
            url={"/blog/" + createSlug(post.data.title, post.slug)}
            target="_self"
            badge={post.data.badge}
            tags={post.data.tags}
            kind={post.data.kind}
            votes={post.data.votes}
            accepted={post.data.accepted}
            pubDate={post.data.pubDate}
            updatedDate={post.data.updatedDate}
          />
          <div class="divider my-0" />
        </>
      ))
    )
  }
</BaseLayout>
