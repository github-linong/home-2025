---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import QADisplay from "../components/QADisplay.astro";
import type { QaData } from "../components/QADisplay.astro";
import BlogAnalytics from "../components/BlogAnalytics.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import { Image } from "astro:assets";

export interface Props extends BlogSchema {
  qaData?: QaData | null;
  slug: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  badge,
  tags = [],
  sourceUrl,
  source,
  kind = "article",
  votes,
  accepted,
  questionUrl,
  answerId,
  qaData,
  slug,
} = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll");
const isAnswer = kind === "answer";
const showQa = isAnswer && qaData;
const contentSource = source ?? (sourceUrl ? "segmentfault" : "site");
---

<BaseLayout title={title} description={description} image={heroImage}, ogType="article">
  <main class="md:flex md:justify-center">
    <article class="prose prose-lg max-w-none prose-img:mx-auto" data-pagefind-body>
      <span data-pagefind-meta="title" class="hidden">{title}</span>
      <span data-pagefind-meta="description" class="hidden">{description}</span>
      <span data-pagefind-meta="kind" class="hidden">{kind}</span>
      <span data-pagefind-meta="source" class="hidden">{contentSource}</span>
      {badge && <span data-pagefind-meta="badge" class="hidden">{badge}</span>}
      {tags.map((tag) => (
        <span data-pagefind-filter={`tag:${tag}`} class="hidden" />
      ))}

      {heroImage && <Image width={750} height={422} format="webp" src={heroImage} alt={title} class="w-full mb-6" />}

      {showQa ? (
        <>
          <h1 class="title my-2 text-3xl font-bold leading-snug">{title}</h1>
          {pubDate && <time class="text-sm text-base-content/60">{displayDate}</time>}
          {tags.length > 0 && (
            <div class="not-prose my-3">
              {tags.map((tag) => (
                <a href={`/blog/tag/${tag}`} class="badge badge-outline ml-0 mr-2 no-underline">
                  {tag}
                </a>
              ))}
            </div>
          )}
          <div class="divider my-4"></div>
          <QADisplay
            data={qaData}
            title={title}
            votes={votes}
            accepted={accepted}
            questionUrl={questionUrl}
            sourceUrl={sourceUrl}
          />
        </>
      ) : isAnswer ? (
        <>
          <h1 class="title my-2 text-3xl font-bold">{title}</h1>
          {pubDate && <time class="text-sm text-base-content/60">{displayDate}</time>}
          <div class="divider my-4"></div>
          <slot />
        </>
      ) : (
        <>
          <h1 class="title my-2 text-4xl font-bold">{title}</h1>
          {pubDate && <time class="text-sm text-base-content/60">{displayDate}</time>}
          <br />
          {badge && <div class="badge badge-secondary my-1">{badge}</div>}
          {tags.map((tag) => (
            <a href={`/blog/tag/${tag}`} class="badge badge-outline ml-2 no-underline">
              {tag}
            </a>
          ))}
          {updatedDate && (
            <div>
              Last updated on <time>{updatedDate}</time>
            </div>
          )}
          <div class="divider my-2"></div>
          {sourceUrl && (
            <p class="not-prose text-sm opacity-70">
              转载自 <a href={sourceUrl} target="_blank" rel="noreferrer">SegmentFault</a>
            </p>
          )}
          <slot />
        </>
      )}
    </article>
  </main>

  <BlogAnalytics slug={slug} kind={kind} source={contentSource} answerId={answerId} />
</BaseLayout>
