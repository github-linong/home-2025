---
import { type BlogSchema } from "../content/config";
import BaseLayout from "./BaseLayout.astro";
import QADisplay from "../components/QADisplay.astro";
import type { QaData } from "../components/QADisplay.astro";
import BlogAnalytics from "../components/BlogAnalytics.astro";
import ViewBeacon from "../components/ViewBeacon.astro";
import ArticleToc from "../components/ArticleToc.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import { Image } from "astro:assets";
import { SITE_AUTHOR } from "../config";
import { profile } from "../data/profile";
import {
  buildArticleJsonLd,
  buildCanonicalUrl,
  buildPersonJsonLd,
} from "../lib/seo.mjs";

export interface Props extends BlogSchema {
  qaData?: QaData | null;
  slug: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  badge,
  tags = [],
  sourceUrl,
  source,
  kind = "article",
  votes,
  accepted,
  questionUrl,
  answerId,
  qaData,
  slug,
} = Astro.props;
dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll");
const isAnswer = kind === "answer";
const showQa = isAnswer && qaData;
const contentSource = source ?? (sourceUrl ? "segmentfault" : "site");

const siteBase = Astro.site?.href ?? "https://www.lilnong.top/";
const pageCanonical = buildCanonicalUrl(siteBase, Astro.url);
const datePublished = new Date(pubDate).toISOString();
const modifiedCandidate = updatedDate ? new Date(updatedDate) : null;
const dateModified =
  modifiedCandidate && !Number.isNaN(modifiedCandidate.valueOf())
    ? modifiedCandidate.toISOString()
    : datePublished;
const articleJsonLd = buildArticleJsonLd({
  headline: title,
  description,
  url: pageCanonical,
  datePublished,
  dateModified,
  image: heroImage ? new URL(heroImage, siteBase).href : undefined,
  author: buildPersonJsonLd({
    name: SITE_AUTHOR,
    url: profile.site,
    description: profile.tagline,
  }),
  isBasedOn: sourceUrl,
});
---

<BaseLayout
  title={title}
  description={description}
  image={heroImage}
  ogType="article"
  canonical={pageCanonical}
  jsonLd={articleJsonLd}
  publishedTime={datePublished}
  modifiedTime={dateModified}
  mainClass="p-6 pt-10 w-full max-w-[100vw] lg:max-w-[1080px]"
>
  <article class="max-w-none" data-pagefind-body>
    <span data-pagefind-meta="title" class="hidden">{title}</span>
    <span data-pagefind-meta="description" class="hidden">{description}</span>
    <span data-pagefind-meta="kind" class="hidden">{kind}</span>
    <span data-pagefind-meta="source" class="hidden">{contentSource}</span>
    {badge && <span data-pagefind-meta="badge" class="hidden">{badge}</span>}
    {tags.map((tag) => (
      <span data-pagefind-filter={`tag:${tag}`} class="hidden" />
    ))}

    {heroImage && (
      <div class="not-prose mb-5 overflow-hidden rounded-lg border border-base-300/60">
        <Image
          width={1200}
          height={400}
          format="webp"
          src={heroImage}
          alt={title}
          class="m-0 block h-[9.5rem] w-full object-cover object-center sm:h-[11rem] lg:h-[12.5rem]"
        />
      </div>
    )}

    {showQa ? (
      <div class="prose prose-lg max-w-none">
        <h1 class="title my-2 text-3xl font-bold leading-snug">{title}</h1>
        {pubDate && <time class="text-sm text-base-content/60">{displayDate}</time>}
        {tags.length > 0 && (
          <div class="not-prose my-3">
            {tags.map((tag) => (
              <a href={`/search/?tag=${encodeURIComponent(tag)}`} class="badge badge-outline ml-0 mr-2 no-underline">
                {tag}
              </a>
            ))}
          </div>
        )}
        <div class="divider my-4 !mx-0"></div>
        <QADisplay
          data={qaData}
          title={title}
          votes={votes}
          accepted={accepted}
          questionUrl={questionUrl}
          sourceUrl={sourceUrl}
        />
      </div>
    ) : isAnswer ? (
      <div class="prose prose-lg max-w-none" data-article-content>
        <h1 class="title my-2 text-3xl font-bold">{title}</h1>
        {pubDate && <time class="text-sm text-base-content/60">{displayDate}</time>}
        <div class="divider my-4 !mx-0"></div>
        <slot />
      </div>
    ) : (
      <>
        <header class="prose prose-lg max-w-none mb-6">
          <h1 class="title my-2 text-4xl font-bold">{title}</h1>
          {pubDate && <time class="text-sm text-base-content/60">{displayDate}</time>}
          <br />
          {badge && <div class="badge badge-secondary my-1">{badge}</div>}
          {tags.map((tag) => (
            <a href={`/search/?tag=${encodeURIComponent(tag)}`} class="badge badge-outline ml-2 no-underline">
              {tag}
            </a>
          ))}
          {updatedDate && (
            <div>
              Last updated on <time>{updatedDate}</time>
            </div>
          )}
          <div class="divider my-2 !mx-0"></div>
          {sourceUrl && (
            <p class="not-prose text-sm opacity-70">
              转载自 <a href={sourceUrl} target="_blank" rel="noreferrer">SegmentFault</a>
            </p>
          )}
        </header>

        <div class="article-layout" data-article-layout>
          <ArticleToc />
          <div class="prose prose-lg max-w-none min-w-0" data-article-content>
            <slot />
          </div>
        </div>
      </>
    )}
  </article>

  <BlogAnalytics slug={slug} kind={kind} source={contentSource} answerId={answerId} />
  <ViewBeacon type="blog" slug={slug} />
</BaseLayout>

<style>
  .article-layout {
    display: block;
  }

  @media (min-width: 1024px) {
    .article-layout[data-toc-ready="true"] {
      display: grid;
      grid-template-columns: 10.5rem minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }
  }
</style>
