PORT=3005
API2_BASE_URL=http://127.0.0.1:3002
SESSION_CACHE_TTL_MS=300000
SESSION_RECHECK_EVERY_ACTIONS=20
CHAT_PING_MS=20000
CHAT_PONG_MS=60000
CHAT_MAX_MSG_BYTES=16384
CHAT_MAX_TEXT=2000
CHAT_HISTORY=200
CHAT_RATE_WINDOW_MS=10000
CHAT_RATE_MAX=30
CHAT_RATE_IP_MAX=150
CHAT_PRESENCE_DEBOUNCE_MS=400
INTERNAL_ADMIN_TOKEN=dev-admin-token
DEV_SKIP_AUTH=false

# Group settings
GROUP_MAX_MEMBERS=50
GROUP_INVITE_CODE_LENGTH=6
GROUP_META_TTL_MS=604800000

# ── Message persistence (MySQL) ──
# 配置 MYSQL_HOST 即启用服务端持久化（聊天记录写入 chat_messages 表，重启不丢）。
# 不配置则回退为纯内存模式（重启即清空）。直接复用服务器 MySQL 的 MYSQL_* 环境变量即可。
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_DATABASE=personal_site
# MYSQL_USER=site
# MYSQL_PASSWORD=sitepass
# 连接池大小（可选，默认 4）
# CHAT_MYSQL_POOL=4

