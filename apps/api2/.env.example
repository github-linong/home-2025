# api2 (Better Auth) — local overrides (gitignored)
# Aliyun LingMou real-time avatar
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
LINGMOU_ENDPOINT=lingmou.cn-beijing.aliyuncs.com
LINGMOU_CHAT_PROJECT_ID=
LINGMOU_INSTANCE_ID=
LINGMOU_SDK_LICENSE=
LINGMOU_PLATFORM=Web

# Aliyun Bailian / DashScope Qwen + CosyVoice (server-side only)
DASHSCOPE_API_KEY=
# Optional Qwen OpenAI-compatible endpoint and model.
DASHSCOPE_LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_LLM_MODEL=qwen-flash
# Optional: use the workspace-specific endpoint recommended by Bailian.
# DASHSCOPE_TTS_ENDPOINT=https://WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_TTS_MODEL=cosyvoice-v3-flash
DASHSCOPE_TTS_VOICE=longanhuan

# Local: match Astro origin so OAuth cookies/callback stay same-origin via vite proxy
BETTER_AUTH_URL=http://127.0.0.1:4321
# Production: BETTER_AUTH_URL=https://www.lilnong.top
BETTER_AUTH_SECRET=dev-only-change-me-to-32chars-min
# Local SSH tunnel → server Postgres: ssh -L 5433:127.0.0.1:5432 root@YOUR_HOST
DATABASE_URL=postgresql://lilnong_auth:REPLACE_PASS@127.0.0.1:5433/lilnong_auth
AUTH_EMAIL_PASSWORD=true
# Required for email sign-up (comma-separated). Sign-in / GitHub do not need it.
AUTH_INVITE_CODES=replace-me-local-invite
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
