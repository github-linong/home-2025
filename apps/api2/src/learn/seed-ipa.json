      "symbols": [
        {
          "symbol": "ʊ",
          "name_zh": "短元音 ʊ",
          "voiced": true,
          "tip": "舌尖离开下齿，舌后部向软腭抬起，双唇微微前突但不紧绷。",
          "examples": "push, wolf, book, could, should",
          "sort_order": 1
        },
        {
          "symbol": "uː",
          "name_zh": "长元音 uː",
          "voiced": true,
          "tip": "舌后部抬得更高，双唇收圆前突成小孔，肌肉收紧。勿用汉字「屋」硬套。",
          "examples": "movie, truth, fool, shoe, blue, fruit",
          "sort_order": 2
        },
        {
          "symbol": "ɒ",
          "name_zh": "短元音 ɒ",
          "voiced": true,
          "tip": "舌后部向软腭抬起并略紧张，双唇微圆但不突出。",
          "examples": "boss, cost, watch, wash",
          "sort_order": 3
        },
        {
          "symbol": "ɔː",
          "name_zh": "长元音 ɔː",
          "voiced": true,
          "tip": "舌后部抬高并紧张，双唇收圆前突。勿用汉字「奥」硬套。",
          "examples": "water, horse, ball, autumn, law, door",
          "sort_order": 4
        },
        {
          "symbol": "ɑː",
          "name_zh": "长元音 ɑː",
          "voiced": true,
          "tip": "嘴巴张大，舌头压低后缩，后半部略抬，舌尖不抵下齿。",
          "examples": "father, ask, star, park, far",
          "sort_order": 5
        }
      ]
    },
    {
      "slug": "closing-diphthongs",
      "title": "合口双元音（5）",
