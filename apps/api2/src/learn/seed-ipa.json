      "symbols": [
        {
          "symbol": "eɪ",
          "name_zh": "双元音 eɪ",
          "voiced": true,
          "tip": "先准备 /e/，再滑向 /ɪ/，双唇呈微笑状。音长受后接辅音影响。",
          "examples": "cake, sail, say, eight, break",
          "sort_order": 1
        },
        {
          "symbol": "aɪ",
          "name_zh": "双元音 aɪ",
          "voiced": true,
          "tip": "嘴巴张开，舌前部轻抬，从 /a/ 滑向松的 /ɪ/，音长要发够。",
          "examples": "bike, cry, lie, night, buy",
          "sort_order": 2
        },
        {
          "symbol": "ɔɪ",
          "name_zh": "双元音 ɔɪ",
          "voiced": true,
          "tip": "嘴巴圆唇准备 /ɔ/，再滑向 /ɪ/；/ɪ/ 不必发得太清晰。",
          "examples": "oil, boil, boy, joy, toy",
          "sort_order": 3
        },
        {
          "symbol": "əʊ",
          "name_zh": "双元音 əʊ",
          "voiced": true,
          "tip": "先发 /ə/，再过渡到 /ʊ/，嘴巴由扁变圆；/ə/ 不要拖太长。",
          "examples": "no, home, boat, toe, show, shoulder",
          "sort_order": 4
        },
        {
          "symbol": "aʊ",
          "name_zh": "双元音 aʊ",
          "voiced": true,
          "tip": "从 /a/ 滑向 /ʊ/，嘴巴由大变圆并略前突。不要用韵母 ao 代替。",
          "examples": "out, house, cow, how, power",
          "sort_order": 5
        }
      ]
    },
    {
      "slug": "centring-diphthongs",
