    {
      "slug": "morning-routine",
      "title": "A Simple Morning Routine",
      "level": "A2",
      "body": "I wake up early and keep a quiet morning routine. First I stretch for a few minutes. Then I open my notebook and review five words. Small steps still mean progress. After that I make coffee and plan the day.",
      "wordLemmas": ["routine", "quiet", "stretch", "notebook", "review", "progress", "habit", "focus"]
    },
    {
      "slug": "subway-commute",
      "title": "On the Subway",
      "level": "A2",
      "body": "The subway is crowded in the morning. I wear headphones and listen to a short podcast. At the next station I transfer to another line. The ride takes twenty minutes. When I arrive I feel ready for work.",
      "wordLemmas": ["subway", "crowded", "headphones", "podcast", "station", "transfer"]
    },
    {
      "slug": "weekend-cafe",
      "title": "Weekend at a Cafe",
      "level": "B1",
      "body": "On the weekend I meet a friend at a small cafe. We order a latte and sit at a table by the window. Our conversation is slow and relaxed. Sometimes we go to the library later to borrow a book from the shelf and return another one.",
      "wordLemmas": ["weekend", "cafe", "order", "latte", "table", "conversation", "library", "borrow", "shelf", "return"]
    },
    {
      "slug": "streamlining-work",
      "title": "Streamlining Our Workflow",
      "level": "B1",
      "body": "Our team decided to streamline the approval process. We used to negotiate every detail by email, but now we give quick feedback in a shared document. We implemented the new workflow last month, and everyone says it is more convenient than before. We also cancelled a subscription we no longer needed. Small changes like these make a big difference.",
      "wordLemmas": ["streamline", "negotiate", "feedback", "implement", "convenient", "subscription"]
    }
  ]
