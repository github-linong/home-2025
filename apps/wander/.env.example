# Wander (apps/wander) — environment reference
#
# Copy to `.env` to override defaults. `.env` is gitignored.
# NOTE: `npm run dev` already sets DEV_SKIP_AUTH=true so local play works
# without a real login. These vars are mainly for production / custom setups.

# Skip real Better-Auth verification and accept ?devUserId= / wander_dev_uid
# cookie as a logged-in dev identity. The `dev` script sets this automatically.
DEV_SKIP_AUTH=false

# Base URL of the api2 auth service (used in normal mode to verify sessions).
API2_BASE_URL=http://127.0.0.1:3002

# WS server port (Astro dev proxies /ws/wander -> ws://127.0.0.1:3004).
PORT=3004

# Fixed "public" room code that /wander auto-joins when no ?room= is given.
PUBLIC_ROOM_CODE=PUBLIC

# Initial world bounds (grid cells). The owner can enlarge at runtime.
WORLD_WIDTH=1000
WORLD_HEIGHT=1000

# Hard cap on world enlargement (abuse defense).
MAX_WORLD_SIZE=1000000
