# Site
SITE_URL=http://localhost:8080
PUBLIC_BASE_URL=https://www.lilnong.top

# Legacy API (apps/api)
API_PORT=3001

# api2 — Better Auth (apps/api2)
API2_PORT=3002
BETTER_AUTH_URL=http://127.0.0.1:3002
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32
# Production Postgres (server has PG15; DB lilnong_auth). Local: SSH tunnel 5433→5432
# DATABASE_URL=postgresql://lilnong_auth:PASSWORD@127.0.0.1:5433/lilnong_auth
AUTH_EMAIL_PASSWORD=true
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:4321,http://localhost:4321,https://www.lilnong.top,https://lilnong.top

# OAuth (Better Auth social providers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MongoDB (face_ai / invitation — legacy api)
MONGO_URI=mongodb://127.0.0.1:27017/

# Aliyun OSS (upload archive; leave empty to keep files on local disk)
# Objects go to private/uploads (not under public-read static/*). No public URLs by default.
OSS_ENABLED=true
OSS_REGION=oss-cn-beijing
OSS_BUCKET=hone-2023
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=private/uploads
OSS_PUBLIC_READ=false
# Only used when OSS_PUBLIC_READ=true
# OSS_PUBLIC_BASE=https://www.lilnong.top
# Full fonts archive: OSS private/fonts/ — sync with npm run sync:fonts:from-oss
# Theme large media: OSS static/theme/ — npm run migrate:theme:media

# Baidu AI
BAIDU_CLIENT_ID=
BAIDU_CLIENT_SECRET=

# Face++
FACEPP_API_KEY=
FACEPP_API_SECRET=

# Tencent FaceFusion
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-beijing
TENCENT_FACEFUSION_PROJECT_ID=303154
TENCENT_FACEFUSION_DEFAULT_MODEL_ID=qc_303154_598422_14

# WeChat JS-SDK
WX_APPID=
WX_APP_SECRET=
WX_SERVER_TOKEN=invitationln
WX_HOST_ALLOWLIST=www.lilnong.top

# QQ KG cookies (optional overrides)
KG_QQ_COOKIE=
KG_QQ_COOKIE_ALT=
NETEASE_API_BASE=http://127.0.0.1:9101

# MySQL (optional / compose)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=personal_site
MYSQL_USER=site
MYSQL_PASSWORD=sitepass
MYSQL_ROOT_PASSWORD=rootpass

# LLM (for SegmentFault Q&A optimization)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_DELAY_MS=1500
