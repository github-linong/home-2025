# Site
SITE_URL=http://localhost:8080

# API
API_PORT=3001
AUTH_ENABLED=false

# OAuth (fill when enabling auth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=change-me-to-a-long-random-string

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=personal_site
MYSQL_USER=site
MYSQL_PASSWORD=sitepass
MYSQL_ROOT_PASSWORD=rootpass

# LLM (for SegmentFault Q&A optimization)
# OpenAI: LLM_API_KEY=sk-...  LLM_MODEL=gpt-4o-mini
# DeepSeek: LLM_BASE_URL=https://api.deepseek.com/v1  LLM_API_KEY=...  LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_DELAY_MS=1500
