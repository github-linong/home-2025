[Unit]
Description=lilnong.top Chat Realtime (WebSocket)
After=network.target lilnong-api2.service
Wants=lilnong-api2.service

[Service]
Type=simple
WorkingDirectory=/opt/lilnong-chat
EnvironmentFile=/opt/lilnong-chat/.env
ExecStart=/usr/local/bin/node /opt/lilnong-chat/src/server.js
Restart=on-failure
RestartSec=3
Environment=NODE_OPTIONS=--max-old-space-size=256
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
