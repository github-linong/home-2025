[Unit]
Description=lilnong.top Dungeon Online (Co-op ARPG, WebSocket)
After=network.target lilnong-api2.service
Wants=lilnong-api2.service

[Service]
Type=simple
WorkingDirectory=/opt/lilnong-dungeon/apps/dungeon-server
EnvironmentFile=/opt/lilnong-dungeon/apps/dungeon-server/.env
ExecStart=/usr/local/bin/node --experimental-strip-types /opt/lilnong-dungeon/apps/dungeon-server/src/server.ts
Restart=on-failure
RestartSec=3
Environment=NODE_OPTIONS=--max-old-space-size=512
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
