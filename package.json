{
  "name": "personal-site",
  "private": true,
  "version": "0.1.0",
  "description": "Personal site — Astrofy static web + Express legacy API",
  "type": "module",
  "scripts": {
    "dev:web": "npm run dev --prefix apps/web",
    "dev:api": "npm run dev --prefix apps/api",
    "build:web": "npm run build --prefix apps/web",
    "build:api": "npm run build --prefix apps/api",
    "build": "npm run build:web && npm run build:api",
    "preview:web": "npm run preview --prefix apps/web",
    "crawl:sf": "node scripts/crawl-sf.mjs",
    "crawl:sf:discover": "node scripts/crawl-sf.mjs --discover",
    "import:sf-answers": "node scripts/import-sf-answers.mjs",
    "optimize:sf-answers": "node scripts/optimize-sf-answers-llm.mjs",
    "migrate:static-html": "node scripts/migrate-static-html-demos.mjs",
    "migrate:static-html:next": "node scripts/migrate-static-html-demos.mjs --limit 1",
    "migrate:static-projects": "node scripts/migrate-static-projects.mjs",
    "migrate:theme": "node scripts/migrate-theme-demos.mjs",
    "migrate:theme:media": "node scripts/migrate-theme-demos.mjs --upload-media",
    "sync:fonts:to-oss": "bash scripts/sync-fonts-to-oss.sh",
    "sync:fonts:from-oss": "bash scripts/sync-fonts-from-oss.sh",
    "generate:demo-entries": "node scripts/generate-legacy-demo-entries.mjs",
    "generate:heroes": "node scripts/generate-hero-images.mjs --write",
    "generate:heroes:force": "node scripts/generate-hero-images.mjs --write --force",
    "generate:heroes:screenshots": "node scripts/generate-hero-images.mjs --write --force --only=demo --screenshots --concurrency=4",
    "download:jsrun": "node scripts/download-jsrun.mjs",
    "download:jsrun:sample": "node scripts/download-jsrun.mjs --catalog scripts/data/jsrun/sample-catalog.json --limit 1 --delay 1500 --gap 2500",
    "migrate:jsrun": "node scripts/migrate-jsrun-demos.mjs",
    "curate:jsrun": "node scripts/curate-jsrun-demos.mjs",
    "enrich:jsrun": "node scripts/enrich-jsrun-curated.mjs",
    "normalize:jsrun-tags": "node scripts/normalize-jsrun-tags.mjs",
    "deploy:web": "bash scripts/deploy-web.sh",
    "deploy:api2": "bash scripts/deploy-api2.sh",
    "deploy:poker-realtime": "bash scripts/deploy-poker-realtime.sh",
    "deploy:chat": "bash scripts/deploy-chat.sh",
    "deploy:wander": "bash scripts/deploy-wander.sh",
    "baidu:push": "node scripts/baidu-push.mjs",
    "baidu:push:recent": "node scripts/baidu-push.mjs --recent 10",
    "seo:www-redirect": "bash scripts/apply-www-canonical-redirect.sh",
    "dev:api2": "npm run dev --prefix apps/api2",
    "start:api2": "npm run start --prefix apps/api2",
    "dev:poker-realtime": "npm run dev --prefix apps/poker-realtime",
    "start:poker-realtime": "npm run start --prefix apps/poker-realtime",
    "test:poker-realtime": "npm test --prefix apps/poker-realtime",
    "test:api": "npm test --prefix apps/api",
    "dev:chat": "npm run dev --prefix apps/chat",
    "dev:wander": "npm run dev --prefix apps/wander",
    "dev:jianghu": "bash games/jianghu/scripts/start-jianghu.sh",
    "stop:jianghu": "kill $(lsof -t -iTCP:3011 -sTCP:LISTEN) 2>/dev/null; kill $(lsof -t -iTCP:8081 -sTCP:LISTEN) 2>/dev/null; echo 'jianghu 服务已停止 (:3011 游戏服务端 / :8081 客户端静态)'",
    "dev": ". .nvm-dev.sh && concurrently -n web,api,api2,poker,chat,wander -c blue,yellow,magenta,green,cyan,red \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:api2\" \"npm:dev:poker-realtime\" \"npm:dev:chat\" \"npm:dev:wander\"",
    "dev:lite": ". .nvm-dev.sh && concurrently -n web,api2 -c blue,magenta \"npm:dev:web\" \"npm:dev:api2\"",
    "dev:tmux": "zsh scripts/dev.sh"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "puppeteer": "^24.8.2",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
